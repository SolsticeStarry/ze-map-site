---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapCard from '../components/MapCard.astro';

const maps = await getCollection('maps');

const featured = maps.filter((m) => m.data.featured);

const totalEntities = maps.reduce((a, m) => a + (m.data.entityCount ?? 0), 0);
const previewable = maps.filter((m) => m.data.entitySlug).length;

const latest = [...maps]
  .sort((a, b) => {
    const da = a.data.lastUpdated ? new Date(a.data.lastUpdated).getTime() : 0;
    const db = b.data.lastUpdated ? new Date(b.data.lastUpdated).getTime() : 0;
    return db - da;
  })
  .slice(0, 6);

// 热门标签统计
const tagCount: Record<string, number> = {};
for (const m of maps) {
  for (const t of m.data.tags) {
    tagCount[t] = (tagCount[t] ?? 0) + 1;
  }
}
const hotTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);

// 按工坊订阅数排的热门图
const popular = [...maps]
  .filter((m) => (m.data.workshopSubs ?? 0) > 0)
  .sort((a, b) => (b.data.workshopSubs ?? 0) - (a.data.workshopSubs ?? 0))
  .slice(0, 6);
---

<BaseLayout>
  <section class="hero hero-bg">
    <div class="hero-bg-layer"></div>
    <div class="hero-bg-overlay"></div>
    <div class="container hero-content">
      <div class="hero-badge">Community · Zombie Escape</div>
      <h1 class="hero-title">
        <span class="gradient-text">ZE 地图</span>资料站
      </h1>
      <p class="hero-sub">
        僵尸逃跑地图中文资料库 · 背景故事 · 通关流程 · 神器攻略
      </p>
      <div class="hero-stats">
        <div class="stat">
          <strong data-count={maps.length}>{maps.length}</strong>
          <span>地图收录</span>
        </div>
        <div class="stat">
          <strong data-count={totalEntities}>{totalEntities.toLocaleString('en-US')}</strong>
          <span>实体点位</span>
        </div>
        <div class="stat">
          <strong data-count={hotTags.length}>{hotTags.length}</strong>
          <span>热门标签</span>
        </div>
      </div>
    </div>
    <a href="#featured" class="hero-scroll">向下滚动 ↓</a>
  </section>

  <div class="container">
    <section id="entity-preview">
      <div class="section-head">
        <h2>实体预览</h2>
        <a href="/preview/">打开预览工具 →</a>
      </div>
      <a class="entity-cta" href="/preview/" target="_blank" rel="noopener" title="在新标签页打开实体预览">
        <span class="ec-t">🧊 3D / 平面双视图查看地图实体</span>
        <span class="ec-d">
          收录 {previewable} 张 CS2 地图的服务端实体数据：传送门、可破坏物、机关、危险区、路径点与关卡分层，
          支持按高度着色、剖切、关卡过滤与单点详情（属性 / 触发连线）。
        </span>
        <span class="ec-go">进入实体预览 ↗</span>
      </a>
    </section>

    {featured.length > 0 && (
      <section id="featured">
        <div class="section-head">
          <h2>精选地图</h2>
          <a href="/maps/">查看全部 →</a>
        </div>
        <div class="map-grid">
          {featured.map((map) => <MapCard map={map} />)}
        </div>
      </section>
    )}

    {hotTags.length > 0 && (
      <section>
        <div class="section-head">
          <h2>热门标签</h2>
          <a href="/tags/">全部标签 →</a>
        </div>
        <div class="hot-tags">
          {hotTags.map(([tag, count]) => (
            <a class="hot-tag" href={`/tags/${tag}/`}>
              <span class="hot-tag-name">{tag}</span>
              <span class="hot-tag-count">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section>
        <div class="section-head">
          <h2>最新更新</h2>
          <a href="/maps/">查看全部 →</a>
        </div>
        <div class="timeline">
          {latest.map((map) => (
            <a class="timeline-item" href={`/maps/${map.id}/`}>
              <span class="timeline-dot"></span>
              <span class="timeline-date">{map.data.lastUpdated ?? '—'}</span>
              <span class="timeline-title">{map.data.title}</span>
              <span class="timeline-en">{map.data.titleEn}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {popular.length > 0 && (
      <section>
        <div class="section-head">
          <h2>工坊热门</h2>
          <a href="/maps/">查看全部 →</a>
        </div>
        <div class="timeline">
          {popular.map((map) => (
            <a class="timeline-item" href={`/maps/${map.id}/`}>
              <span class="timeline-dot"></span>
              <span class="timeline-date">订阅 {(map.data.workshopSubs ?? 0).toLocaleString('en-US')}</span>
              <span class="timeline-title">{map.data.title}</span>
              <span class="timeline-en">{map.data.titleEn}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {maps.length === 0 && (
      <div class="empty-state">
        <p>还没有地图。去 <code>src/content/maps/</code> 里添加第一张吧。</p>
      </div>
    )}
  </div>

  <script>
    // 数字滚动动画
    function animateCount(el: HTMLElement, target: number, duration = 1200) {
      const start = performance.now();
      function tick(now: number) {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const counters = document.querySelectorAll('[data-count]');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.count ?? 0);
            animateCount(el, target);
            io.unobserve(el);
          }
        });
      },
      { threshold: 0.5 }
    );
    counters.forEach((el) => io.observe(el));
  </script>
</BaseLayout>