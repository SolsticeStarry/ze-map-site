---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="投稿 | ZE 地图资料站">
  <section class="hero" style="padding: 70px 0 30px;">
    <div class="container">
      <h1 class="hero-title" style="font-size: clamp(32px, 5vw, 52px);">
        投稿<span class="gradient-text">指南</span>
      </h1>
      <p class="hero-sub">欢迎补充地图、截图、攻略。</p>
    </div>
  </section>
  <div class="container" style="padding-bottom: 60px;">
    <div class="sidebar-card" style="max-width: 720px;">
      <h3>怎么投稿</h3>
      <p>在 GitHub 提 issue 或 PR，或联系站长。</p>
      <h3>投稿内容</h3>
      <ul>
        <li>地图背景故事</li>
        <li>关卡流程</li>
        <li>神器说明</li>
        <li>截图 / 路线图</li>
        <li>视频链接</li>
      </ul>
    </div>
  </div>
</BaseLayout>