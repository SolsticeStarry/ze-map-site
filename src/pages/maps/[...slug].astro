---
import { render } from 'astro:content';
import { getMaps } from '../../lib/maps';
import { galleryFor } from '../../lib/gallery';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapCard from '../../components/MapCard.astro';
import MapGallery from '../../components/MapGallery.astro';
import GuideFigure from '../../components/GuideFigure.astro';
import GuideNote from '../../components/GuideNote.astro';
import DifficultyVote from '../../components/DifficultyVote.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import RouteMap from '../../components/RouteMap.astro';
import StageAccordion from '../../components/StageAccordion.astro';
import { DIFFICULTY_CLASS } from '../../../shared/difficulty.mjs';
import { parseDoc } from '../../../shared/submission-fields.mjs';
import catalog from '../../../public/entity/catalog.json';
import terrManifest from '../../../data/terr-manifest.json';
import entityStatus from '../../../data/entity-status.json';

export async function getStaticPaths() {
  const maps = await getMaps();
  return maps.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

/*
 * 这些值**已经由 content loader 合并过社区覆盖**（见 src/content.config.ts 的
 * mapsLoader）。页面里不要再自己读一遍 data/community/ —— 地图库、标签页、
 * 首页、同类推荐都走同一个 loader，页面自己读会造成「详情页说困难、列表说中等」。
 */
const {
  title,
  titleEn,
  aliases,
  game,
  cover: heroCover,
  workshopUrl,
  downloadUrl,
  entitySlug,
  entityCount,
  workshopSubs,
  workshopViews,
  workshopMissing,
  uploader,
  difficulty,
  tags,
  author,
  authorNote,
  version,
  players,
  duration,
  stages,
  size,
  sources,
  videoUrls,
  videoKinds,
  stub,
  communityFields,
  communityNotes,
  communityPeople,
  communitySources,
  communityDraft,
} = entry.data;

/*
 * 整篇草稿（2026-10-13）：按 `## 小节` 拆开渲染，块级结构与条目正文一致（标题 + 段落）。
 * 未采纳时它只是一块「社区整理版」，本站正文照旧在上方；采纳后由站长合并进原稿，这里就不再显示。
 */
const draftParsed = communityDraft?.text ? parseDoc(communityDraft.text) : null;

const hasCommunity = communityPeople.length > 0 || communityNotes.length > 0;
/*
 * 视频类型标签：原稿里写了 videoKinds（{ "BVxxxx": "地图档案" }）就取出来挂到对应视频上。
 * 现在只有「地图档案」这类解说向视频会标；没写这个字段的图，页面输出完全不变。
 */
const kindOfVideo = (url: string): string => {
  if (!videoKinds) return '';
  const bv = /BV[0-9A-Za-z]+/.exec(url)?.[0];
  return (bv && videoKinds[bv]) || '';
};

/*
 * 视频分栏（2026-10-19 站长要求）：以前所有视频挤在一个「攻略视频」里，
 * 全流程、神器操作、触发教程、彩蛋、音乐、指挥视角混在一起，新手看不出该点哪个。
 * 现在按类别分块，每块自己的锚点，目录里也是分开的：
 *   通关视频   ← 全流程 / 指挥视角 / 实况（没写关键词的实况也归这里）
 *   老司机经验 ← 神器 / 僵尸操作 / 教学 / 进阶技巧
 *   触发攻略   ← 触发、机关讲解
 *   彩蛋触发   ← 彩蛋（这些图会自动带上「彩蛋」标签）
 *   音乐       ← BGM / OST / 歌单
 *   相关视频   ← 拿不准的
 * 只有真的存在该类视频才渲染，顺序固定（先「怎么打」再「细节」）。
 */
const VIDEO_GROUPS = [
  ['通关视频', 'videos-run'],
  ['老司机经验', 'videos-veteran'],
  ['触发攻略', 'videos-trigger'],
  ['彩蛋触发', 'videos-easter'],
  ['音乐', 'videos-music'],
  ['相关视频', 'videos-other'],
] as const;
const bvOfUrl = (url: string): string => /BV[0-9A-Za-z]{10}/.exec(url)?.[0] ?? '';
const hasVideoKinds = Boolean(videoKinds && Object.keys(videoKinds).length);
const videoGroups = VIDEO_GROUPS.map(([label, id]) => ({
  label,
  id,
  urls: (videoUrls ?? []).filter((u: string) => kindOfVideo(u) === label),
}));
/* 没有分类信息的旧数据 / 分类对不上的，统一回到「相关视频」，一个视频都不丢 */
const knownCats = new Set<string>(VIDEO_GROUPS.map(([label]) => label));
const looseUrls = (videoUrls ?? []).filter((u: string) => !knownCats.has(kindOfVideo(u)));
if (looseUrls.length) videoGroups[VIDEO_GROUPS.length - 1].urls.push(...looseUrls);
const visibleGroups = videoGroups.filter((g) => g.urls.length > 0);
/*
 * 体积（MB → 人话）：数值来自 data/map-sizes.json（s2ze/Ruby Bot 的公开地图数据，
 * 见 docs/data-sources.md），带「~」是因为那是工坊分包的体积、和实际下载量可能略有出入。
 */
const sizeText = typeof size === 'number' && size > 0
  ? size >= 1024
    ? `~${(size / 1024).toFixed(2)} GB`
    : `~${Math.round(size)} MB`
  : null;
/*
 * 社区正文按**投稿时选的字段**分块：简介排在最前、攻略一块、背景故事一块，
 * 其余（补充说明 / 纠错，以及 field 为空的老数据）进「社区补充」。
 *
 * ⚠️ 这里用「白名单 + 兜底」而不是给每个块各写一条 filter：2026-10-09 加 `guide` 时
 * 只补了 guideNotes，`otherNotes` 那句 `field !== 'story'` 忘了排除 guide —— 于是投了
 * 「攻略讲解」的稿子会在「攻略 / 神器讲解（社区投稿）」和「社区补充」里各出现一次。
 * 当时没有 guide 投稿所以没暴露。现在改成一处分流，新增字段只要加进 KNOWN 就行。
 */
const noteField = (n: { field?: string | null }) => n.field ?? 'body';
const notesOf = (field: string) => communityNotes.filter((n: { field?: string | null }) => noteField(n) === field);
/** 已经单独成块的字段；不在这个集合里的一律进「社区补充」 */
const KNOWN_NOTE_FIELDS = ['summary', 'guide', 'story', 'section'];
const summaryNotes = notesOf('summary');
const guideNotes = notesOf('guide');
const storyNotes = notesOf('story');
/*
 * 「社区整理」（2026-10-15 加）：投稿人**自己起标题**的一节。
 * 和 story / guide 一样是社区块（压不过本站正文），区别只是标题由他定；
 * 服务端已经拦住「一张图最多一篇」，页面这层只负责渲染标题 + 署名。
 */
const sectionNotes = notesOf('section') as Array<NoteMeta & { text: string; title?: string | null }>;
const otherNotes = communityNotes.filter((n: { field?: string | null }) => !KNOWN_NOTE_FIELDS.includes(noteField(n)));
/*
 * 社区投的「简介」只在**本站还没写简介**的图上显示（hasSummary 由生成器写在 frontmatter，
 * 见 generate-map-entries.mjs）。有本站简介的图，投稿页会直接拦住这类稿子；
 * 这里再挡一层，免得老投稿或手改数据把它顶到开头。
 */
const showSummaryNote = summaryNotes.length > 0 && !entry.data.hasSummary;
/*
 * 一条社区正文的署名。
 * 被修订过的要写清「谁写的、谁改的、什么时候改的」—— 只保留原作者会让人以为
 * 后一次的改动也是他做的；只写修订者又抹掉了原作者（2026-10-10 加的修订功能）。
 */
type NoteMeta = {
  by: string;
  at: string | null;
  revisedBy?: string | null;
  revisedAt?: string | null;
  revision?: number;
};
const noteBy = (n: NoteMeta) => {
  const base = `由 ${n.by} 投稿${n.at ? ` · ${n.at.slice(0, 10)}` : ''}`;
  if (!n.revisedBy) return base;
  const when = n.revisedAt ? `（${n.revisedAt.slice(0, 10)}）` : '';
  const times = n.revision && n.revision > 1 ? `，第 ${n.revision} 版` : '';
  return `${base} · ${n.revisedBy} 修订${when}${times}`;
};
/*
 * 手写条目（那三张富内容图）的正文里自带「视频攻略」一节，页面就别再渲染一遍 ——
 * 否则同一页会出现两块视频。判定只看正文里有没有二级标题含"视频"。
 */
const bodyHasVideo = /^##[^\n]*视频/m.test(entry.body ?? '');
/** 顶部视频区默认露出几个；其余折进 <details>（视频多的图不把正文挤下去） */
const VIDEOS_SHOWN = 2;
const communityHistoryUrl = `https://github.com/hhjjdsj/ze-map-site/commits/main/data/community/${entry.id}.json`;

/*
 * 图片集（data/gallery/<slug>.json → Cloudflare R2 上的图）**不再固定渲染在这里**：
 * 站长要求它排到正文靠上（紧跟「背景故事」小节，见 2026-10-08），而正文中间只有 MDX
 * 自己能插东西 —— 所以正文里有一个 `<MapGallery slug cover />` 标记（生成器写，
 * 手写正文的条目由 ensureGalleryMarker 兜底补），组件通过 <Content components> 传进去。
 * 相关逻辑全在 components/MapGallery.astro，包括「封面就是工坊图时图片集里不重复」那条。
 */

/*
 * 社区补过的「资料来源」由 mergeEntry 注入 entry.data.communitySources。
 *
 * 为什么单独列一份：sources 是**生成器烤进正文**的（正文里那个「## 资料来源」列表
 * 来自 data/research/<地图>.json），社区补的来源不会出现在正文里 ——
 * 所以侧栏单独列出来并标明来自社区。研究来源仍在正文，不重复。
 */
const shortUrl = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/+$/, '');

const diffClass = DIFFICULTY_CLASS[difficulty as keyof typeof DIFFICULTY_CLASS] ?? 'diff-unknown';

const previewUrl = entitySlug ? `/preview/?map=${entitySlug}` : null;
const entityMeta = entitySlug ? catalog.maps.find((m) => m.s === entitySlug) : null;
const bakedEntities = entityMeta?.source === 'Source2Viewer default_ents.vents_c';

/*
 * 没有实体预览时，页面上必须写清楚**为什么没有** —— 读者看到侧栏空着只会以为网站坏了。
 * 判定只用可查证的事实，分四层，绝不写「可能」：
 *   delisted       该图已在创意工坊下架 → 地图文件拿不到，实体与碰撞地形都解析不了（不可逆）
 *   no-entity-data 地图文件在，但包里没有实体定义（default_ents.vents_c）→ 解析不出点位
 *   no-physics     点位有、但包里没有世界物理网格 → 没有真实碰撞地形
 *   not-baked      源文件在、我们还没解析入库（可补）
 * 前三种来自 data/entity-status.json（烘焙时的实测结论），最后一种是默认。
 */
const idFrom = (value?: string) =>
  /-(\d+)$/.exec(value ?? '')?.[1] ?? /[?&]id=(\d+)/.exec(value ?? '')?.[1] ?? null;
const workshopId = idFrom(entitySlug) ?? idFrom(workshopUrl);
const hasTerrain = workshopId ? new Set(terrManifest.ids.map(String)).has(workshopId) : false;
const entityStatusCode: string | null = workshopId
  ? ((entityStatus.maps as Record<string, { code?: string }>)[workshopId]?.code ?? null)
  : null;
const noPreviewCode = previewUrl ? null : (entityStatusCode ?? (workshopMissing ? 'delisted' : 'not-baked'));
const NO_PREVIEW_COPY: Record<string, string> = {
  delisted:
    '这张图已经从 Steam 创意工坊下架，地图文件无法再下载，因此解析不出实体点位与碰撞地形 —— 所以没有实体预览。如果你手上有这张图的地图文件，欢迎在「补充 / 纠错」里告诉我们，可以本地解析。',
  'no-entity-data':
    '我们的烘焙管线解析过这张图的地图文件，但包里没有实体定义文件（default_ents.vents_c），因此拿不到传送门、机关、危险区这些点位 —— 所以没有实体预览。',
  'no-physics':
    '这张图能解析出实体点位，但地图包里没有世界碰撞网格，因此预览工具里没有真实地形（点位与关卡分层照常）。',
  'parse-failed':
    '这张图的地图包能下载，但解析实体数据时失败了（地图包内缺少编译文件，或某个实体模型导出报错），因此拿不到点位 —— 所以没有实体预览。',
  'not-baked':
    '这张图的实体数据还没有入库，所以暂时没有实体预览：预览点位需要从创意工坊地图包里解析，新收录的图会陆续补上。',
};
const noPreviewCopy = noPreviewCode ? NO_PREVIEW_COPY[noPreviewCode] : null;
/** 基本信息表里那一行只放短语，完整解释在侧栏顶部的说明卡里 */
const NO_PREVIEW_LABEL: Record<string, string> = {
  delisted: '工坊已下架',
  'no-entity-data': '地图包内无实体定义',
  'no-physics': '缺碰撞地形',
  'parse-failed': '解析失败',
  'not-baked': '尚未入库',
};
const hasBasics = Boolean(author || version || players || duration || stages);

// 同类地图推荐：共同标签多的优先，其次看工坊订阅
const all = await getMaps();
const related = all
  .filter((m) => m.id !== entry.id && m.data.tags.length > 0)
  .map((m) => ({ m, shared: m.data.tags.filter((t) => tags.includes(t)).length }))
  .filter((x) => x.shared > 0)
  .sort(
    (a, b) =>
      b.shared - a.shared ||
      (b.m.data.workshopSubs ?? 0) - (a.m.data.workshopSubs ?? 0)
  )
  .slice(0, 3)
  .map((x) => x.m);

/*
 * ===== 本页目录（2026-10-17 加） =====
 *
 * 站长的要求：「像其他百科网站一样每张地图一个快速索引目录，点击可以跳到相关地方」，
 * 并且要**随内容自动更新**、手机上也好用。
 *
 * 为什么是构建期生成：目录 = 「这一页真实存在的块」，内容改了（有人加了一节、采纳了草稿、
 * 上传了图片集）→ 写回仓库 → 自动重建 → 目录跟着变，**不需要维护第二份清单**。
 * 三种来源拼起来，顺序按页面上的真实先后：
 *   1. 模板块（视频 / 简介）在正文之前；
 *   2. 正文小节来自 render(entry).headings（MDX 已生成中文 id，锚点直接可用）；
 *      「图片集」不是标题而是组件，所以按 <MapGallery /> 标记在正文里的位置插进去；
 *   3. 社区块 / 草稿 / 同类地图在正文之后。
 * 块没渲染就不进目录（没视频的图不会出现「攻略视频」）。
 */
type TocItem = { id: string; label: string; count?: number; sub?: boolean };
const toc: TocItem[] = [];
const pushToc = (id: string, label: string, count?: number) => toc.push({ id, label, ...(count ? { count } : {}) });

if (!bodyHasVideo && (videoUrls ?? []).length > 0) {
  if (hasVideoKinds && visibleGroups.length > 0) {
    for (const g of visibleGroups) pushToc(g.id, g.label, g.urls.length);
  } else {
    pushToc('videos', '攻略视频', (videoUrls ?? []).length);
  }
}
if (showSummaryNote) pushToc('intro', '简介（社区投稿）');

/* 正文小节：headings 与 body 里的 ##/### 顺序一一对应，用位置信息把「图片集」插到它真正出现的地方 */
const bodySource = String(entry.body ?? '');
const bodyHeadingMatches = [...bodySource.matchAll(/^(#{2,3})[ \t]+(.+)$/gm)];
const galleryAt = bodySource.indexOf('<MapGallery');
const bodyToc: Array<{ at: number; id: string; label: string; sub: boolean }> = headings.map((h, i) => ({
  at: bodyHeadingMatches[i]?.index ?? Number.MAX_SAFE_INTEGER,
  id: h.slug,
  label: h.text,
  sub: h.depth >= 3,
}));
const galleryTotal = galleryFor(entry.id).length;
if (galleryTotal > 0) {
  bodyToc.push({ at: galleryAt >= 0 ? galleryAt : Number.MAX_SAFE_INTEGER, id: 'gallery', label: '图片集', sub: false });
}
bodyToc.sort((a, b) => a.at - b.at);
for (const h of bodyToc) {
  toc.push({ id: h.id, label: h.label, ...(h.id === 'gallery' && galleryTotal ? { count: galleryTotal } : {}), ...(h.sub ? { sub: true } : {}) });
}

if (guideNotes.length > 0) pushToc('guide-notes', '攻略 / 神器讲解（社区投稿）');
if (storyNotes.length > 0) pushToc('story-notes', '背景故事（社区投稿）');
if (otherNotes.length > 0) pushToc('extra-notes', '社区补充');
if (sectionNotes.length > 0) pushToc('community-sections', '社区整理', sectionNotes.length);
if (draftParsed) pushToc('community-draft', '社区整理版（未采纳）');
if (related.length > 0) pushToc('similar', '同类地图');

/** 目录太短就不显示（比如只有 1~2 项时纯属噪音） */
const showToc = toc.length >= 3;
---

<BaseLayout
  title={`${title} | ZE 地图资料站`}
  description={`${title}（${titleEn}）— 僵尸逃跑地图资料：关卡流程、实体分布与预览。`}
  image={heroCover}
  /* 首屏那张封面就是 LCP 元素（CSS 背景图，靠 preload 才提前开始下） */
  preloadImage={heroCover}
  /* 图集图片在 R2（terr.ze-map.cn）：有图集就先建连，省掉一次 TLS 往返（图集清单见 components/MapGallery.astro） */
  preconnect={galleryFor(titleEn).length ? ['https://terr.ze-map.cn'] : []}
>
  {/*
    Pagefind 筛选标记 —— 不显示任何内容，只是给站内搜索的索引器读的。

    为什么必须有这三行：/search 页面的下拉框能不能筛，取决于**索引里有没有筛选维度**。
    没有它们时构建日志会写「Indexed 0 filters」，索引元数据里连 filters 字段都没有，
    搜索页自然「没有难度、没有分类」可筛 —— 界面怎么改都没用。

    语法是 Pagefind 的内联写法 `键:值`（元素是什么、可不可见都不影响取值），
    所以放在 <div hidden> 里是安全的。值要和 /search 下拉框里的文案**逐字一致**，
    因为筛选是精确字符串匹配（「已有攻略」少写一个字就会筛出 0 条）。
  */}
  <div hidden>
    <span data-pagefind-filter={`难度:${difficulty}`}></span>
    <span data-pagefind-filter={`游戏:${game}`}></span>
    <span data-pagefind-filter={`资料:${stub ? '资料待补充' : '已有攻略资料'}`}></span>
  </div>

  <section class="map-hero">
    {heroCover && <div class="map-hero-bg" style={`background-image:url('${heroCover}')`}></div>}
    <div class="container">
      <h1>{title}</h1>
      <p class="subtitle">{titleEn}</p>
      {/*
        其他社区叫法（2026-10-13 站长要求）：同一张图各社区叫法不一样
        （爬雪山 / 雪山逃亡v6 / 多模式爬雪山 / 雪山大冒险），对不上名字的人靠这行找到图。
        数据来自原稿的 aliases 或社区投稿，最多 8 条；没有就完全不渲染这行。
      */}
      {(aliases ?? []).length > 0 && (
        <p class="alias-line">
          <span class="alias-label">其他叫法</span>
          {(aliases ?? []).map((a: string) => <span class="alias-chip">{a}</span>)}
        </p>
      )}
      <div class="hero-tags">
        <span class={`badge ${diffClass}`} title="难度分档与取值参考 FYS（风云社）的服务器地图列表">{difficulty}</span>
        <span class="badge">{game}</span>
        {tags.map((t: string) => <span class="badge">{t}</span>)}
      </div>
      <div class="stat-row">
        {entityCount ? <span class="chip">实体 <b>{entityCount.toLocaleString('en-US')}</b></span> : null}
        {stages ? <span class="chip">关卡 <b>{stages}</b></span> : null}
        {players ? <span class="chip">人数 <b>{players}</b></span> : null}
        {duration ? <span class="chip">时长 <b>{duration}</b></span> : null}
        {workshopSubs ? <span class="chip">工坊订阅 <b>{workshopSubs.toLocaleString('en-US')}</b></span> : null}
      </div>
    </div>
  </section>

  <div class="map-layout">
    <main class="map-main">
      {stub && (
        <div class="stub-notice">
          <span>📝</span>
          <div>
            <strong>本条目为数据条目</strong>：内容由 CS2 服务端实体数据自动生成，剧情、作者、难度、攻略等资料待补充。<br />
            欢迎到 <a href="/contribute/">投稿页</a> 或 GitHub 补充这张图的资料。
          </div>
        </div>
      )}

      {/*
        攻略视频：**放在正文最前面**（2026-09-30 信息层级重排）。
        玩家打开一张图最想先看的就是"别人怎么打"，而它以前排在整篇正文之后，
        等于埋在最底下。视频组件是点击才加载的封面（facade），所以放前面不会拖慢首屏。
        ⚠️ 手写条目（魔晄炉 / 米纳斯 / 黑珍珠号）的正文里**自己带视频段**，
        这里再渲染一次就会出现两块视频，所以正文里已有视频标题时跳过 ——
        videoUrls 仍然照常渲染在那些页面的正文里。
      */}
      {!bodyHasVideo && (videoUrls ?? []).length > 0 && (
        hasVideoKinds && visibleGroups.length > 0 ? (
          visibleGroups.map((g) => (
            <section class="video-block" id={g.id}>
              <h2>{g.label}{g.urls.length > 1 ? `（${g.urls.length}）` : ''}</h2>
              {g.urls.slice(0, VIDEOS_SHOWN).map((url: string) => (
                <VideoEmbed url={url} />
              ))}
              {g.urls.length > VIDEOS_SHOWN && (
                <details class="video-more">
                  <summary>展开另外 {g.urls.length - VIDEOS_SHOWN} 个视频</summary>
                  {g.urls.slice(VIDEOS_SHOWN).map((url: string) => (
                    <VideoEmbed url={url} />
                  ))}
                </details>
              )}
            </section>
          ))
        ) : (
          <section class="video-block" id="videos">
            <h2>攻略视频{(videoUrls ?? []).length > 1 ? `（${(videoUrls ?? []).length}）` : ''}</h2>
            {(videoUrls ?? []).slice(0, VIDEOS_SHOWN).map((url: string) => (
              <VideoEmbed url={url} kind={kindOfVideo(url)} />
            ))}
            {(videoUrls ?? []).length > VIDEOS_SHOWN && (
              /*
                40 张图的视频超过 3 个（最多 9 个）。全铺在最前面会把「关卡 / 神器」又挤下去，
                所以只默认露出前两个，其余折起来 —— 想看的点一下展开，不想看的直接往下读。
              */
              <details class="video-more">
                <summary>展开另外 {(videoUrls ?? []).length - VIDEOS_SHOWN} 个视频</summary>
                {(videoUrls ?? []).slice(VIDEOS_SHOWN).map((url: string) => (
                  <VideoEmbed url={url} kind={kindOfVideo(url)} />
                ))}
              </details>
            )}
          </section>
        )
      )}

      {/*
        社区投稿的「简介」：只在**本站还没写简介**的图上出现，位置就是开头那段导语的地方
        （正文之前）—— 那样它才真的起到「简介」的作用，而不是又一块落在页尾的社区补充。
        有本站简介的图不显示（投稿页也会拦住这类稿子），避免两份导语打架。
      */}
      {showSummaryNote && (
        <section class="community-block is-lead" id="intro">
          <h2>简介（社区投稿）</h2>
          {summaryNotes.map((n: NoteMeta & { text: string }) => (
            <div class="community-note">
              <GuideNote slug={entry.id} text={n.text} />
              <p class="community-note-by">{noteBy(n)}</p>
            </div>
          ))}
        </section>
      )}

      {/*
        正文里的 `<MapGallery />` / `<VideoEmbed />` / `<StageAccordion>` / `<RouteMap>` 标记
        由这里解析：MDX 认得 components 映射里的名字，所以正文不需要写 import。
        MapGallery 由生成器插（见 components/MapGallery.astro），另外三个出现在
        人工整理的 sections 里（魔晄炉 / 米纳斯 / 黑珍珠号：视频攻略、关卡流程、路线图）。
      */}
      <Content components={{ MapGallery, VideoEmbed, StageAccordion, RouteMap, GuideFigure }} />

      {/*
        社区内容是**按投稿时选的字段分块显示**的：
        投「背景故事」的进「背景故事（社区投稿）」，其余（补充说明 / 纠错）进「社区补充」。
        以前一律塞进「社区补充」，投背景故事的人会以为稿子没生效（2026-09-28 反馈）。
        区块仍然与本站整理的正文分开，并逐条署名 —— 不覆盖正文本就是有意的设计。
      */}
      {guideNotes.length > 0 && (
        <section class="community-block" id="guide-notes">
          <h2>攻略 / 神器讲解（社区投稿）</h2>
          {guideNotes.map((n: NoteMeta & { text: string }) => (
            <div class="community-note">
              <GuideNote slug={entry.id} text={n.text} />
              <p class="community-note-by">{noteBy(n)}</p>
            </div>
          ))}
        </section>
      )}

      {storyNotes.length > 0 && (
        <section class="community-block" id="story-notes">
          <h2>背景故事（社区投稿）</h2>
          {storyNotes.map((n: NoteMeta & { text: string }) => (
            <div class="community-note">
              <GuideNote slug={entry.id} text={n.text} />
              <p class="community-note-by">{noteBy(n)}</p>
            </div>
          ))}
        </section>
      )}

      {otherNotes.length > 0 && (
        <section class="community-block" id="extra-notes">
          <h2>社区补充</h2>
          {otherNotes.map((n: NoteMeta & { text: string }) => (
            <div class="community-note">
              <GuideNote slug={entry.id} text={n.text} />
              <p class="community-note-by">{noteBy(n)}</p>
            </div>
          ))}
        </section>
      )}

      {/*
        整篇草稿（2026-10-13）：社区志愿者给这张图整理的**整篇**版本，未采纳时显示在这里。
        刻意放在所有本站内容之后、同类地图之前 —— 位置本身就在说「这是备选稿，不是本站正文」；
        横幅也写死了「未采纳」，免得读者以为这就是本站结论。
      */}
      {/*
        社区整理（2026-10-15）：投稿人自己起标题的一节，位置固定在**其它社区块之后**、
        「社区整理版（未采纳）」草稿之前 —— 它属于「本站条目 + 一节社区内容」，
        不是备选稿，但仍然带「社区整理」小标，读者一眼能看出不是本站正文。
        标题由投稿人定（服务端已禁止与本站小节重名），正文渲染规则与 story / guide 一样。
      */}
      {sectionNotes.map((n, i) => (
        <section class="community-block is-section" {...(i === 0 ? { id: 'community-sections' } : {})}>
          <h2>
            {n.title || '社区整理'}
            <span class="community-badge">社区整理</span>
          </h2>
          <GuideNote slug={entry.id} text={n.text} />
          <p class="community-note-by">{noteBy(n)}</p>
        </section>
      ))}

      {draftParsed && (
        <section class="draft-block" id="community-draft">
          <h2>社区整理版（未采纳）</h2>
          <p class="draft-banner">
            这是社区志愿者整理的**整篇**草稿，<strong>尚未被本站采纳</strong>：上面的正文仍以本站整理为准。
            站长审核后才会按小节合并进条目（写到的节替换、没写到的节保留）。
          </p>
          {draftParsed.intro && <GuideNote slug={entry.id} text={draftParsed.intro} />}
          {draftParsed.sections.map((s: { title: string; body: string }) => (
            <div class="draft-section">
              <h3>{s.title}</h3>
              {s.body && <GuideNote slug={entry.id} text={s.body} />}
            </div>
          ))}
          <p class="community-note-by">
            整理：{communityDraft.by}
            {communityDraft.at ? ` · ${String(communityDraft.at).slice(0, 10)}` : ''}
          </p>
        </section>
      )}

      {related.length > 0 && (
        <section id="similar">
          <h2>同类地图</h2>
          <div class="map-grid">
            {related.map((m) => <MapCard map={m} />)}
          </div>
        </section>
      )}
    </main>

    <aside class="map-sidebar">
      {/*
        本页目录（2026-10-17）：侧栏顶部 sticky，构建期生成（见上面 toc 那段）。
        手机上这个列表隐藏，挪进底部的「目录」抽屉（同一份数据渲染两遍，纯静态）。
      */}
      {showToc && (
        <nav class="map-toc" aria-label="本页目录">
          <p class="map-toc-title">本页目录</p>
          <ol>
            {toc.map((t) => (
              <li class={t.sub ? 'is-sub' : undefined}>
                {/*
                  ⚠️ target="_self" 不能省：BaseLayout 里有 `<base target="_blank">`，
                  全站链接默认新开标签页 —— 不写它，点目录会在新标签里打开同一个页面再跳锚点。
                  （和 contribute.astro 里的「向下滚动」是同一个坑，注释见 BaseLayout 第 60 行附近。）
                */}
                <a href={`#${t.id}`} target="_self">
                  <span>{t.label}</span>
                  {t.count ? <b>{t.count}</b> : null}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      {previewUrl ? (
        <a class="entity-cta" href={previewUrl} target="_blank" rel="noopener" title="在新标签页打开实体预览">
          <span class="ec-t">🧊 实体预览</span>
          <span class="ec-d">
            3D / 平面两种视图查看本图的传送门、可破坏物、机关、危险区与关卡分层。
          </span>
          {!hasTerrain && (
            <span class="ec-warn">
              本图有点位、但没有真实碰撞地形：地图包里缺少世界碰撞网格，3D 视图里不显示地面起伏，点位与关卡分层不受影响。
            </span>
          )}
          <span class="ec-go">打开实体预览 ↗</span>
        </a>
      ) : (
        <div class="entity-cta is-off">
          <span class="ec-t">🧊 实体预览：暂无</span>
          <span class="ec-d">{noPreviewCopy}</span>
          <span class="ec-src">
            预览工具收录了 <b>{catalog.count}</b> 张图；没有入库的图，侧栏「数据来源」里会写明当前用的是哪份数据。
          </span>
        </div>
      )}

      <div class="sidebar-card">
        <h3>基本信息{hasCommunity && <span class="field-src">含社区补充</span>}</h3>
        <dl>
          <dt>英文名</dt><dd>{titleEn}</dd>
          {author && <><dt>作者</dt><dd>{author}</dd></>}
          {!author && uploader && <><dt>工坊上传者</dt><dd>{uploader}</dd></>}
          {version && <><dt>版本</dt><dd>{version}</dd></>}
          <dt>游戏</dt><dd>{game}</dd>
          <dt>难度</dt><dd><span class={`badge ${diffClass}`}>{difficulty}</span>{difficulty !== '未知' && <span class="diff-src" title="难度分档与取值参考 FYS（风云社）的服务器地图列表；不同服务器的口径可能不同">源于 FYS</span>}</dd>
          {players && <><dt>人数</dt><dd>{players}</dd></>}
          {duration && <><dt>时长</dt><dd>{duration}</dd></>}
          {stages ? <><dt>关卡</dt><dd>{stages}</dd></> : null}
          {sizeText ? <><dt>体积</dt><dd title="地图文件的下载体积（数据来自 s2ze.com / Ruby Bot），可能与你实际下载的大小略有出入">{sizeText}</dd></> : null}
          {entityCount ? <><dt>实体数</dt><dd>{entityCount.toLocaleString('en-US')}</dd></> : null}
          {!previewUrl && (
            <><dt>实体预览</dt><dd title={noPreviewCopy ?? ''}>暂无（{NO_PREVIEW_LABEL[noPreviewCode ?? 'not-baked']}）</dd></>
          )}
          {workshopSubs ? <><dt>工坊订阅</dt><dd>{workshopSubs.toLocaleString('en-US')}</dd></> : null}
          {workshopViews ? <><dt>工坊浏览</dt><dd>{workshopViews.toLocaleString('en-US')}</dd></> : null}
        </dl>
        {workshopMissing && <p class="sidebar-hint">该工坊条目在 Steam 上已查无此项（可能已被作者删除或隐藏）。</p>}
        {authorNote && <p class="sidebar-hint">署名详情：{authorNote}</p>}
        {!hasBasics && <p class="sidebar-hint">作者、人数、时长等资料待补充。</p>}
      </div>

      <DifficultyVote slug={entry.id} current={difficulty} />

      {(workshopUrl || downloadUrl) && (
        <div class="sidebar-card">
          <h3>下载 / 入口</h3>
          {workshopUrl && (
            <a class="btn btn-primary" href={workshopUrl} target="_blank" rel="noopener">
              Steam 创意工坊
            </a>
          )}
          {downloadUrl && (
            <a class="btn" href={downloadUrl} target="_blank" rel="noopener">
              GameBanana
            </a>
          )}
        </div>
      )}

      <div class="sidebar-card">
        <h3>标签</h3>
        <div class="tag-list">
          {tags.length > 0 ? tags.map((t: string) => <a href={`/tags/${t}/`}>{t}</a>) : <span class="sidebar-hint">暂无标签</span>}
        </div>
      </div>

      <div class="sidebar-card">
        <h3>补充 / 纠错</h3>
        <p class="sidebar-hint">
          发现错漏、或者知道更多资料？不用会 git，填个表单就行 —— 审核通过、站长写回仓库后就会出现在本页。
        </p>
        <a class="btn" href={`/submit/?map=${entry.id}`}>✏️ 补充这张图的资料</a>
        {/*
          社区整理（2026-10-15）：补一格 vs 加一节自己的内容 vs 整理一整篇，是三种不同的活，
          所以侧栏里三个入口并排摆 —— 这个直接落到投稿页的「社区整理」那一档。
        */}
        <a class="btn btn-section" href={`/submit/?map=${entry.id}&field=section`}>✍️ 社区整理（加一节）</a>
        <p class="sidebar-hint is-tiny">
          有标准字段装不下的长篇见解（彩蛋与机关、老玩家心得…）？用这个：标题你自己起，
          一次能写 1~3 节、一张图累计最多 6 节，通过后显示在本页末尾、带「社区整理」小标。需要登录。
        </p>
        {/*
          大面积整理的独立入口（2026-10-13）：补一格 vs 整理一整篇是两件事，
          所以在侧栏里也分开摆 —— 直接落到投稿表单里的「整篇条目草稿」。
        */}
        <a class="btn btn-draft" href={`/submit/?map=${entry.id}&field=draft`}>📝 大面积整理（整篇改写）</a>
        <p class="sidebar-hint is-tiny">
          这张图还没有本站正文、或者你想整篇重写？用这个：按 <code>## 小节</code> 写，
          采纳时同名小节替换、没写到的小节保留。需要登录。
        </p>
        {hasCommunity && (
          <p class="community-credit">
            本条目含社区补充，感谢：{communityPeople.join('、')}
            {' · '}
            <a href={communityHistoryUrl} target="_blank" rel="noopener">改动记录 ↗</a>
          </p>
        )}
      </div>

      <div class="sidebar-card">
        <h3>数据来源</h3>
        <p class="sidebar-hint">
          {!entityMeta
            ? '本图还没有实体数据，因此没有实体预览（原因见上方说明）。'
            : bakedEntities
              ? '实体数据从 Steam 创意工坊地图包解析，模型碰撞壳用于还原部分实体范围。'
              : `实体数据保留历史服务端快照（${entityMeta?.sourceBuilt || catalog.meta.legacyBuilt}）。`}
        </p>
        {communitySources.length > 0 && (
          <p class="sidebar-hint">
            社区补充的来源：
            <br />
            {communitySources.map((s: string) => (
              <>
                <a href={s} target="_blank" rel="noopener">{shortUrl(s)}</a>
                <br />
              </>
            ))}
          </p>
        )}
      </div>
    </aside>
  </div>

  {/*
    手机上的页内导航（2026-10-17）：底部一条小工具栏 + 两个抽屉。
    · 「目录」：半屏抽屉，列法和侧栏那份一样（点一项关抽屉并滚过去）；
    · 「基本信息」：把右侧栏（基本信息 / 实体预览 / 投稿按钮 / 投票）从页面最底部
      变成随手可点的抽屉 —— 以前手机用户得滚到底才看得到难度和关卡数；
    · 「顶部」：长页面回到开头。
    全部是 JS 增强：脚本没跑，这条栏不显示（hidden），侧栏仍在文末照常可读。
  */}
  <div class="map-mobile-bar" id="map-mobile-bar" hidden>
    <button type="button" data-bar="toc" aria-label="打开本页目录">☰ 目录</button>
    <button type="button" data-bar="info" aria-label="打开基本信息">ⓘ 基本信息</button>
    <button type="button" data-bar="top" aria-label="回到顶部">↑ 顶部</button>
  </div>
  <div class="map-sidebar-backdrop" id="map-sidebar-backdrop" hidden></div>

  {showToc && (
    <dialog class="map-drawer" id="map-toc-dialog" aria-label="本页目录">
      <div class="md-head">
        <b>目录</b>
        <button type="button" data-close aria-label="关闭">✕</button>
      </div>
      <ol class="md-list">
        {toc.map((t) => (
          <li class={t.sub ? 'is-sub' : undefined}>
            {/* 同侧栏目录：必须 target="_self"，否则被 <base target="_blank"> 带去新标签页 */}
            <a href={`#${t.id}`} target="_self">
              <span>{t.label}</span>
              {t.count ? <b>{t.count}</b> : null}
            </a>
          </li>
        ))}
      </ol>
    </dialog>
  )}

  <script>
    /*
     * 地图页的页内导航（2026-10-17）。三件事：
     *   1. 手机底部工具栏：显出来，并给 body 加 has-mapbar ——**侧栏变抽屉只在这个类存在时生效**，
     *      所以脚本没跑（被插件挡 / 老浏览器）时侧栏仍旧留在文末，页面不会残废；
     *   2. 目录抽屉 / 基本信息抽屉的开关；
     *   3. 滚动高亮：算「当前视口顶部上方最近的那个块」，两侧目录同时标亮。
     * 不用 IntersectionObserver 是有意的：它只在进出视口时回调，夹在中间的块反而算不准。
     */
    const bar = document.getElementById('map-mobile-bar');
    const sidebar = document.querySelector<HTMLElement>('.map-sidebar');
    const backdrop = document.getElementById('map-sidebar-backdrop');
    const tocDialog = document.getElementById('map-toc-dialog') as HTMLDialogElement | null;

    const setSidebar = (open: boolean) => {
      document.body.classList.toggle('sidebar-open', open);
      if (backdrop) backdrop.hidden = !open;
    };

    if (bar) {
      if (sidebar) {
        bar.hidden = false;
        document.body.classList.add('has-mapbar');
      }
      bar.addEventListener('click', (e) => {
        const hit = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-bar]');
        const what = hit?.dataset.bar;
        if (what === 'toc') tocDialog?.showModal();
        else if (what === 'info') setSidebar(true);
        else if (what === 'top') window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    backdrop?.addEventListener('click', () => setSidebar(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setSidebar(false);
    });
    /* 侧栏抽屉里点了任何链接（去投稿 / 去实体预览）就收起，别挡着页面 */
    sidebar?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement | null)?.closest('a')) setSidebar(false);
    });

    /* 目录项：先关抽屉再滚（modal 打开时滚动会被它吃掉） */
    tocDialog?.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a) return;
      e.preventDefault();
      const id = decodeURIComponent(a.getAttribute('href')!.slice(1));
      const target = document.getElementById(id);
      tocDialog.close();
      if (!target) return;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      /* 地址栏也带上锚点：想分享「直接翻到神器表」的链接时有用 */
      history.replaceState(null, '', '#' + id);
    });
    tocDialog?.querySelectorAll('[data-close]').forEach((btn) => {
      btn.addEventListener('click', () => tocDialog.close());
    });

    /* 滚动高亮：取「离视口顶部最近、但已经滚过判定位」的那一块 */
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.map-toc a, .map-drawer a')];
    const targets = [...new Set(links.map((a) => decodeURIComponent(a.getAttribute('href')!.slice(1))))]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    if (targets.length) {
      let raf = 0;
      const paint = () => {
        raf = 0;
        const line = 120; /* 吸顶导航 + 一点余量：超过这条线的块算「正在看」 */
        let current = targets[0];
        for (const el of targets) {
          if (el.getBoundingClientRect().top - line <= 0) current = el;
          else break;
        }
        const id = current?.id ?? '';
        for (const a of links) {
          const on = a.getAttribute('href') === '#' + id;
          a.classList.toggle('is-active', on);
          /* 无障碍：让读屏知道当前在哪一节 */
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
        /*
         * 目录很长时（手写条目十几节），高亮项会滚出目录自己的可视区 ——
         * 用户看着目录不知道自己在哪。这里把当前项滚进目录内部的可视范围
         * （block:'nearest' 只动最小距离，不会把整页拽走）。
         */
        const active = links.find((a) => a.classList.contains('is-active') && a.closest('.map-toc'));
        active?.scrollIntoView({ block: 'nearest' });
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(paint);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      paint();
    }
  </script>

</BaseLayout>
