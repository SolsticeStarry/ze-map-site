---
import { getMaps, getMap } from '../../lib/maps';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewMapDetail from '../../components/NewMapDetail.astro';

export async function getStaticPaths() {
  const maps = await getMaps();
  return maps.map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id },
  }));
}

const { slug } = Astro.props;
const entry = await getMap(slug);
if (!entry) throw new Error(`找不到地图：${slug}`);
const { title, titleEn, cover } = entry.data;
---

<BaseLayout
  title={`${title} | ZE 地图资料站`}
  description={`${title}（${titleEn}）— 僵尸逃跑地图资料。`}
  image={cover}
  preloadImage={cover}
>
  <NewMapDetail entry={entry} />
</BaseLayout>
