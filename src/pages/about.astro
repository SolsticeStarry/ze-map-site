---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于 | ZE 地图资料站">
  <section class="hero" style="padding: 70px 0 30px;">
    <div class="container">
      <h1 class="hero-title" style="font-size: clamp(32px, 5vw, 52px);">
        关于<span class="gradient-text">本站</span>
      </h1>
      <p class="hero-sub">ZE 地图资料站，由社区维护。</p>
    </div>
  </section>
  <div class="container" style="padding-bottom: 60px;">
    <div class="sidebar-card" style="max-width: 720px;">
      <h3>这是什么</h3>
      <p>一个收录 Zombie Escape（僵尸逃跑）地图的中文资料库，包含背景故事、通关流程、神器攻略。</p>
      <h3>版权</h3>
      <p>地图版权归原作者所有，本站仅做整理与攻略。</p>
    </div>
  </div>
</BaseLayout>