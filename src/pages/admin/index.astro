---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="审核台 | ZE 地图资料站" description="内容修订审核" noindex>
  <main class="audit-page" data-pagefind-ignore>
    <header class="audit-head">
      <div><p class="audit-kicker">CONTENT REVIEW</p><h1>审核台</h1><p>单项 / 整页修订共用同一队列，只写 <code>data/content</code>，不会改 research。</p></div>
      <a class="audit-link" href="/maps/">地图库</a>
    </header>

    <section class="audit-login" id="login">
      <label>管理密钥<input id="token" type="password" autocomplete="off" placeholder="ADMIN_TOKEN" /></label>
      <label>审核人<input id="reviewer" maxlength="32" placeholder="站长" /></label>
      <button id="connect" type="button">连接</button>
      <p id="login-status"></p>
    </section>

    <section id="panel" hidden>
      <div class="audit-bar">
        <div class="audit-tabs" role="tablist">
          <button class="is-on" data-status="pending" type="button">待审 <b id="count-pending">0</b></button>
          <button data-status="approved" type="button">待写回 <b id="count-approved">0</b></button>
        </div>
        <div class="audit-actions">
          <button id="refresh" type="button">刷新</button>
          <button id="flush" type="button" hidden>写回内容修订</button>
          <button id="forget" type="button">清除密钥</button>
        </div>
      </div>
      <p id="status" class="audit-status" role="status"></p>
      <div id="list"></div>
    </section>
  </main>
</BaseLayout>

<script>
  import { docToHtml } from '../../../shared/doc-render.mjs';

  const $ = (id: string) => document.getElementById(id) as HTMLElement | null;
  const tokenEl = $('token') as HTMLInputElement;
  const reviewerEl = $('reviewer') as HTMLInputElement;
  const panel = $('panel')!;
  const list = $('list')!;
  const statusEl = $('status')!;
  let token = localStorage.getItem('ze-audit-token') ?? '';
  let reviewer = localStorage.getItem('ze-audit-reviewer') ?? '';
  let status: 'pending' | 'approved' = 'pending';
  let counts: Record<string, number> = {};
  tokenEl.value = token;
  reviewerEl.value = reviewer;

  const setStatus = (text: string, bad = false) => { statusEl.textContent = text; statusEl.classList.toggle('is-bad', bad); };
  const api = async (path: string, init: RequestInit = {}) => {
    const headers = new Headers(init.headers ?? {});
    headers.set('authorization', `Bearer ${token}`);
    if (init.body) headers.set('content-type', 'application/json');
    const res = await fetch(path, { ...init, headers });
    const data = await res.json().catch(() => ({}));
    return { status: res.status, data };
  };
  const el = (tag: string, cls = '', text = '') => { const node = document.createElement(tag); if (cls) node.className = cls; if (text) node.textContent = text; return node; };
  const badge = (text: string) => el('span', 'audit-badge', text);

  /** 长文本块：默认折到 8 行，点「展开全文」再看 —— 正文动辄几千字，铺开会把卡片撑成一面墙 */
  function textBlock(label: string, text: string, cls: string): HTMLElement {
    const wrap = el('div', `admin-pane ${cls}`);
    wrap.append(el('span', 'admin-pane-label', label));
    const body = el('div', 'admin-pane-text', text || '（空）');
    wrap.append(body);
    if (String(text ?? '').length > 320) {
      body.classList.add('is-clamped');
      const more = el('button', 'admin-pane-more', '展开全文') as HTMLButtonElement;
      more.type = 'button';
      more.onclick = () => {
        const clamped = body.classList.toggle('is-clamped');
        more.textContent = clamped ? '展开全文' : '收起';
      };
      wrap.append(more);
    }
    return wrap;
  }

  /**
   * 富文本预览：docToHtml 会先 validateDoc，并转义所有文本；页面只接收经过校验的
   * ProseMirror 文档，所以这里可以用 innerHTML。没有 doc（旧纯文本数据）就退回纯文本。
   */
  function richBlock(label: string, doc: unknown, cls: string, fallback: string): HTMLElement {
    const wrap = el('div', `admin-pane ${cls}`);
    wrap.append(el('span', 'admin-pane-label', label));
    const body = el('div', 'admin-pane-rich');
    const html = doc ? docToHtml(doc, []) : '';
    if (html) body.innerHTML = html;
    else body.textContent = fallback || '（空）';
    if (body.textContent && body.textContent.length > 320) {
      body.classList.add('is-clamped');
      const more = el('button', 'admin-pane-more', '展开全文') as HTMLButtonElement;
      more.type = 'button';
      more.onclick = () => {
        const clamped = body.classList.toggle('is-clamped');
        more.textContent = clamped ? '展开全文' : '收起';
      };
      wrap.append(body, more);
    } else {
      wrap.append(body);
    }
    return wrap;
  }


  const FIXED_BLOCK_LABELS: Record<string, string> = { story: '背景故事', intro: '简介', gameplay: '关卡流程说明' };
  const INFOBOX_LABELS: Record<string, string> = {
    author: '作者', version: '版本', players: '人数', duration: '时长', stages: '关卡数', size: '体积', aliases: '其他叫法',
  };
  const VIDEO_KIND_LABELS: Record<string, string> = { run: '通关视频', guide: '攻略', music: '音乐' };
  const ITEM_ACTION_LABELS: Record<string, string> = { add: '新增', update: '修改', remove: '删除' };

  /** ProseMirror doc → 纯文本（审核台只做预览，保留段落换行） */
  const docText = (node: any): string =>
    Array.isArray(node?.content) ? node.content.map(docText).join(node.type === 'paragraph' ? '\n' : '') : String(node?.text ?? '');

  /** 整页修订的「现在的值」快照（按 slug 懒加载；列表接口不逐图读 GitHub） */
  const revisionSnapshots = new Map<string, Promise<Record<string, any> | null>>();
  function revisionSnapshot(slug: string): Promise<Record<string, any> | null> {
    if (!revisionSnapshots.has(slug)) {
      revisionSnapshots.set(
        slug,
        api(`/api/admin/page-revisions/current?slug=${encodeURIComponent(slug)}`)
          .then(({ status, data }) => (status === 200 ? (data?.current ?? null) : null))
          .catch(() => null)
      );
    }
    return revisionSnapshots.get(slug) ?? Promise.resolve(null);
  }

  const revText = (value: unknown) => (value === null || value === undefined || value === '' ? '（空）' : String(value));
  const revRows = (rows: unknown) =>
    Array.isArray(rows) ? rows.map((row) => (Array.isArray(row) ? row.join(' | ') : String(row))).join('\n') : '（空）';
  const revVideos = (videos: unknown) =>
    Array.isArray(videos)
      ? videos.map((item: any) => `${VIDEO_KIND_LABELS[String(item?.kind)] ?? '通关视频'} ${String(item?.url ?? '')}${item?.title ? `（${item.title}）` : ''}`).join('\n')
      : '（空）';
  const revItem = (row: any) => {
    if (!row) return '';
    const cd = Number(row.cd) > 0 ? `${row.cd} 秒` : '—';
    const uses = Number(row.uses) > 0 ? `${row.uses} 次` : '不限';
    return `${String(row.name ?? '')} · 冷却 ${cd} · 次数 ${uses}${row.intro ? `\n${row.intro}` : ''}${row.note ? `\n备注：${row.note}` : ''}`;
  };
  const itemKeyOf = (name: unknown) =>
    String(name ?? '').replace(/\u3000/g, ' ').replace(/\s+/g, ' ').trim().toLowerCase();

  type RevisionChange = { label: string; oldText: string; newText: string; oldDoc?: any; newDoc?: any };

  /** 把 payload 翻成「现在的值 | 本次提交」两栏（有 doc 的走富文本预览） */
  function revisionChanges(payload: Record<string, any>, snap: Record<string, any> | null): RevisionChange[] {
    const changes: RevisionChange[] = [];
    const missing = '（现值没取到，不影响审核）';
    const oldOr = (text: string) => (snap ? text || '（空）' : missing);
    const snapBlocks: any[] = Array.isArray(snap?.blocks) ? snap.blocks : [];
    const findBlock = (block: any) =>
      snapBlocks.find(
        (item) =>
          item?.type === block?.type &&
          (block.type !== 'guideItem' || item?.id === block.id || item?.title === block.title)
      );
    if (payload.difficulty !== undefined) {
      changes.push({ label: '难度', oldText: oldOr(String(snap?.difficulty ?? '')), newText: revText(payload.difficulty) });
    }
    if (Array.isArray(payload.tags)) {
      changes.push({
        label: '标签',
        oldText: oldOr(Array.isArray(snap?.tags) ? snap.tags.join('、') : ''),
        newText: payload.tags.join('、') || '（空）',
      });
    }
    if (payload.media?.cover) {
      changes.push({ label: '新媒体 · 封面', oldText: oldOr(String(snap?.heroImage ?? '')), newText: '（待审新封面，写回后生成 URL）' });
    }
    if (Array.isArray(payload.media?.gallery) && payload.media.gallery.length) {
      changes.push({ label: '新媒体 · 图片集', oldText: '—', newText: `新增 / 替换 ${payload.media.gallery.length} 张待审图片` });
    }
    if (typeof payload.title === 'string') {
      changes.push({ label: '页面标题', oldText: oldOr(String(snap?.title ?? '')), newText: revText(payload.title) });
    }
    if ('heroImage' in payload) {
      changes.push({
        label: '封面',
        oldText: oldOr(String(snap?.heroImage ?? '')),
        newText: payload.heroImage ? String(payload.heroImage) : '（恢复为图片集默认）',
      });
    }
    if (payload.infobox && typeof payload.infobox === 'object' && !Array.isArray(payload.infobox)) {
      for (const [key, value] of Object.entries(payload.infobox as Record<string, unknown>)) {
        changes.push({
          label: `基本信息 · ${INFOBOX_LABELS[key] ?? key}`,
          oldText: oldOr(String(snap?.infobox?.[key] ?? '')),
          newText: revText(value),
        });
      }
    }
    if (Array.isArray(payload.removedBlocks)) {
      for (const id of payload.removedBlocks) {
        const old = snapBlocks.find((item) => item?.id === id) ?? snapBlocks.find((item) => item?.type === id);
        changes.push({
          label: `删除 / 重置 · ${FIXED_BLOCK_LABELS[String(id)] ?? `攻略条目 ${String(id)}`}`,
          oldText: oldOr(String(old?.text ?? '')),
          newText: '（删除 / 重置为 research）',
          oldDoc: old?.doc ?? null,
          newDoc: null,
        });
      }
    }
    if (payload.guideCleared === true) {
      const oldGuides = snapBlocks
        .filter((item) => item?.type === 'guideItem')
        .map((item) => `${item.title ? `${item.title}\n` : ''}${item.text ?? ''}`)
        .join('\n\n');
      changes.push({ label: '攻略技巧', oldText: oldOr(oldGuides), newText: '（全部清空）' });
    }
    for (const block of Array.isArray(payload.blocks) ? payload.blocks : []) {
      if (!block || typeof block !== 'object') continue;
      const type = String(block.type ?? '');
      const label = FIXED_BLOCK_LABELS[type] ?? (block.title ? `攻略 · ${String(block.title)}` : '攻略条目');
      const old = findBlock(block);
      changes.push({
        label: `正文 · ${label}`,
        oldText: oldOr(String(old?.text ?? '')),
        newText: docText(block.doc).slice(0, 4000) || '（空）',
        oldDoc: old?.doc ?? null,
        newDoc: block.doc ?? null,
      });
    }
    if (Array.isArray(payload.stageRows)) {
      const payloadStageDocs = Array.isArray(payload.stageDocs) ? payload.stageDocs : null;
      if (payloadStageDocs) {
        const snapStageRows = Array.isArray(snap?.stageRows) ? snap.stageRows : [];
        const snapStageDocs = Array.isArray(snap?.stageDocs) ? snap.stageDocs : [];
        const max = Math.max(payload.stageRows.length, snapStageRows.length);
        for (let index = 1; index < max; index++) {
          const oldRow = snapStageRows[index] ?? null;
          const newRow = payload.stageRows[index] ?? null;
          if (!oldRow && !newRow) continue;
          const oldDoc = snapStageDocs[index] ?? null;
          const newDoc = payloadStageDocs[index] ?? null;
          if (JSON.stringify(oldRow) === JSON.stringify(newRow) && JSON.stringify(oldDoc) === JSON.stringify(newDoc)) continue;
          const num = String(newRow?.[0] ?? oldRow?.[0] ?? '').trim();
          const name = String(newRow?.[1] ?? oldRow?.[1] ?? '').trim();
          changes.push({
            label: `关卡流程 · ${[num, name].filter(Boolean).join(' ') || `第 ${index} 项`}`,
            oldText: oldRow ? (oldRow[2] ?? '') : '（新增关卡）',
            newText: newRow ? (newRow[2] ?? '') : '（删除关卡）',
            oldDoc: oldRow ? oldDoc : null,
            newDoc: newRow ? newDoc : null,
          });
        }
      } else {
        changes.push({ label: '关卡流程', oldText: oldOr(revRows(snap?.stageRows)), newText: revRows(payload.stageRows) });
      }
    }
    for (const row of Array.isArray(payload.itemEdits) ? payload.itemEdits : []) {
      if (!row || typeof row !== 'object') continue;
      const old = (Array.isArray(snap?.items) ? snap.items : []).find(
        (item: any) => itemKeyOf(item?.name) === itemKeyOf(row.name)
      );
      const action = ITEM_ACTION_LABELS[String(row.action)] ?? '修改';
      changes.push({
        label: `神器 · ${String(row.name ?? '（未命名）')}`,
        oldText: old ? revItem(old) : snap ? '（表里没有这件）' : missing,
        newText: row.action === 'remove' ? `（${action}这件）` : `${action}：\n${revItem(row)}`,
      });
    }
    if (Array.isArray(payload.itemOrder)) {
      changes.push({
        label: '神器顺序',
        oldText: oldOr((snap?.items ?? []).map((item: any) => String(item?.name ?? '')).join('、')),
        newText: payload.itemOrder.join('、') || '（空）',
      });
    }
    if (Array.isArray(payload.videos)) {
      changes.push({ label: '视频', oldText: oldOr(revVideos(snap?.videos)), newText: revVideos(payload.videos) });
    }
    if (!changes.length) changes.push({ label: '改动', oldText: '—', newText: '本次提交没有携带任何改动' });
    return changes;
  }

  function paintRevisionDiff(box: HTMLElement, payload: Record<string, any>, snap: Record<string, any> | null): void {
    box.replaceChildren();
    for (const change of revisionChanges(payload, snap)) {
      const wrap = el('div', 'page-revision-change');
      wrap.append(el('p', 'page-revision-label', change.label));
      const diff = el('div', 'admin-diff');
      diff.append(
        change.oldDoc !== undefined
          ? richBlock('现在的值', change.oldDoc, 'is-old', change.oldText)
          : textBlock('现在的值', change.oldText, 'is-old')
      );
      diff.append(
        change.newDoc !== undefined
          ? richBlock('本次提交', change.newDoc, 'is-new', change.newText)
          : textBlock('本次提交', change.newText, 'is-new')
      );
      wrap.append(diff);
      box.append(wrap);
    }
  }



  function payloadSummary(payload: Record<string, any>): string[] {
    const out: string[] = [];
    if (payload.title !== undefined) out.push(`标题：${String(payload.title || '（空）')}`);
    if (payload.difficulty !== undefined) out.push(`难度：${String(payload.difficulty)}`);
    if (Array.isArray(payload.tags)) out.push(`标签：${payload.tags.join('、') || '（空）'}`);
    if (payload.heroImage !== undefined) out.push('封面变更');
    if (Array.isArray(payload.blocks)) out.push(`正文块：${payload.blocks.length} 个`);
    if (payload.guideCleared) out.push('攻略整节清空');
    if (Array.isArray(payload.stageRows)) out.push(`关卡：${Math.max(0, payload.stageRows.length - 1)} 关`);
    if (Array.isArray(payload.itemEdits)) out.push(`神器：${payload.itemEdits.length} 行`);
    if (Array.isArray(payload.videos)) out.push(`视频：${payload.videos.length} 个`);
    if (payload.media?.cover) out.push('新媒体：封面 1 张');
    if (Array.isArray(payload.media?.gallery) && payload.media.gallery.length) out.push(`新媒体：图片 ${payload.media.gallery.length} 张`);
    if (payload.infobox && typeof payload.infobox === 'object') out.push(`基本信息：${Object.keys(payload.infobox).join('、')}`);
    return out.length ? out : ['（没有可展示的字段，展开下方对比查看详情）'];
  }


  function card(row: any): HTMLElement {
    const box = el('article', 'audit-card');
    let payload: Record<string, any> = {};
    try { payload = JSON.parse(String(row.payload ?? '{}')); } catch {}
    const head = el('div', 'audit-card-head');
    head.append(el('strong', '', `${row.map_slug} · ${row.mode === 'single' ? '单项' : '整页'}修订 #${row.id}`));
    head.append(badge(String(row.submitter ?? '匿名')));
    box.append(head);
    box.append(el('p', 'audit-meta', `${new Date(Number(row.created_at)).toLocaleString()} · ${row.status}`));
    const rows = el('div', 'audit-summary');
    for (const line of payloadSummary(payload)) rows.append(el('p', '', line));
    box.append(rows);
    const diff = el('div', 'page-revision-diff');
    diff.append(el('p', 'audit-current', '正在读取现在的值…'));
    box.append(diff);
    void revisionSnapshot(row.map_slug).then((snap) => paintRevisionDiff(diff, payload, snap));
    const acts = el('div', 'audit-card-actions');
    if (row.status === 'pending') {
      const ok = el('button', 'audit-btn is-primary', '通过，攒着');
      const no = el('button', 'audit-btn', '驳回');
      ok.addEventListener('click', () => void review(row.id, 'approve'));
      no.addEventListener('click', () => {
        const reason = window.prompt('驳回理由（会展示给投稿人）', '');
        if (reason !== null) void review(row.id, 'reject', reason);
      });
      acts.append(ok, no);
    } else {
      const undo = el('button', 'audit-btn', '撤回待审');
      undo.addEventListener('click', () => void review(row.id, 'unstage'));
      acts.append(undo);
    }
    box.append(acts);
    return box;
  }

  function render(items: any[]) {
    list.replaceChildren();
    if (!items.length) { list.append(el('p', 'audit-empty', status === 'pending' ? '没有待审内容。' : '没有待写回内容。')); return; }
    for (const row of items) list.append(card(row));
  }

  async function load() {
    const { status: code, data } = await api(`/api/admin/page-revisions?status=${status}`);
    if (code !== 200) { setStatus(data?.error ?? '读取失败', true); return; }
    counts = data.counts ?? {};
    $('count-pending')!.textContent = String(counts.pending ?? 0);
    $('count-approved')!.textContent = String(counts.approved ?? 0);
    $('flush')!.hidden = !(counts.approved > 0);
    render(Array.isArray(data.items) ? data.items : []);
    setStatus(`已连接 · 待审 ${counts.pending ?? 0} · 待写回 ${counts.approved ?? 0}`);
  }

  async function review(id: number, action: 'approve' | 'reject' | 'unstage', rejectNote = '') {
    const { status: code, data } = await api('/api/admin/page-revisions', {
      method: 'POST',
      body: JSON.stringify({ id, action, rejectNote, reviewer: reviewerEl.value.trim() || '审核员' }),
    });
    if (code !== 200) { setStatus(data?.error ?? '操作失败', true); return; }
    await load();
  }

  async function flush() {
    if (!window.confirm('把全部已通过的修订写回 data/content？会产生一个 commit，并触发一次重建。')) return;
    const { status: code, data } = await api('/api/admin/page-revisions/flush', { method: 'POST', body: '{}' });
    if (code !== 200) { setStatus(data?.error ?? '写回失败', true); return; }
    await load();
    setStatus(data.count ? `已写回 ${data.count} 条修订` : '没有待写回内容');
  }

  $('connect')!.addEventListener('click', () => {
    token = tokenEl.value.trim();
    reviewer = reviewerEl.value.trim();
    localStorage.setItem('ze-audit-token', token);
    localStorage.setItem('ze-audit-reviewer', reviewer);
    panel.hidden = false;
    void load();
  });
  $('refresh')!.addEventListener('click', () => void load());
  $('flush')!.addEventListener('click', () => void flush());
  $('forget')!.addEventListener('click', () => { token = ''; localStorage.removeItem('ze-audit-token'); panel.hidden = true; });
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.audit-tabs button')) btn.addEventListener('click', () => {
    status = btn.dataset.status === 'approved' ? 'approved' : 'pending';
    for (const other of document.querySelectorAll('.audit-tabs button')) other.classList.toggle('is-on', other === btn);
    void load();
  });
  if (token) { panel.hidden = false; void load(); }
</script>

<style is:global>
  .audit-page { max-width: 1080px; margin: 0 auto; padding: 96px 20px 80px; }
  .audit-head { display:flex; justify-content:space-between; gap:24px; align-items:flex-end; margin-bottom:24px; }
  .audit-head h1 { margin:0; font-size:clamp(30px,4vw,46px); }
  .audit-head p { margin:8px 0 0; color:var(--muted); line-height:1.7; }
  .audit-kicker { font-size:11px; letter-spacing:.16em; font-weight:800; color:var(--accent); }
  .audit-link { color:var(--accent); text-decoration:none; font-size:13px; }
  .audit-login, .audit-card, .audit-bar { border:1px solid var(--border); border-radius:12px; background:var(--card); }
  .audit-login { display:flex; flex-wrap:wrap; gap:12px; align-items:end; padding:16px; }
  .audit-login label { display:flex; flex-direction:column; gap:6px; font-size:12px; color:var(--muted); }
  .audit-login input { width:240px; padding:9px 10px; border:1px solid var(--border); border-radius:7px; background:var(--input); color:var(--text); }
  .audit-login button, .audit-btn, .audit-actions button { border:1px solid var(--border); border-radius:7px; padding:8px 12px; background:var(--card); color:var(--text); cursor:pointer; }
  .audit-login button, .audit-btn.is-primary { background:var(--accent); border-color:var(--accent); color:#fff; }
  .audit-login p, .audit-status { flex-basis:100%; margin:0; color:var(--muted); font-size:13px; }
  .audit-status.is-bad { color:#e5484d; }
  .audit-bar { position:sticky; top:12px; z-index:2; display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; padding:12px; margin:16px 0; }
  .audit-tabs, .audit-actions { display:flex; gap:8px; flex-wrap:wrap; }
  .audit-tabs button { border:1px solid var(--border); border-radius:999px; padding:7px 12px; background:transparent; color:var(--muted); cursor:pointer; }
  .audit-tabs button.is-on { background:var(--accent); border-color:var(--accent); color:#fff; }
