---
/**
 * 投稿表单（P2）
 *
 * 不用会 git：填完提交 → 进 D1 待审队列 → 站长在 /admin 审核 → 攒进待写回队列 → 批量写回
 * data/community/<slug>.json → Cloudflare 重建 → 内容出现在地图条目里。
 *
 * 字段定义全部来自 shared/submission-fields.mjs（与 Worker 共用一份），
 * 所以这里既不用手写控件，也不会和「什么算合法投稿」的规则漂移。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import QqGroup from '../../components/QqGroup.astro';
import { FIELD_RULES } from '../../../shared/submission-fields.mjs';

const fields = Object.entries(FIELD_RULES).map(([key, rule]: [string, any]) => ({
  key,
  kind: rule.kind as string,
  label: rule.label as string,
  hint: (rule.hint as string) ?? '',
  values: (rule.values as string[]) ?? [],
}));

/*
 * 「要提交哪一项」里**不列**整篇草稿（rule.hidden）—— 它是独立模式，有自己的入口与界面
 * （2026-10-13 站长要求：不要埋在这排按钮里）。编辑器本身仍然照常渲染，只是选择器里看不到。
 */
const pickerFields = fields.filter((f, i) => !(FIELD_RULES as Record<string, any>)[f.key]?.hidden);
---

<BaseLayout
  title="补充 / 纠错 | ZE 地图资料站"
  description="不用会 git：发现地图资料有错漏，填个表单提交即可，人工审核通过后会更新到条目里。"
>
  <div class="container submit-page">
    {/*
      页面头部（2026-10-08 重做视觉）：以前就是一张朴素的 form-card + 两段提示，
      投稿者第一眼看不出「这事要几步、值不值得做」。改成标题卡 + 步骤条，
      右边挂一张「投稿指南」的入口。
    */}
    <header class="submit-hero">
      <div class="sh-main">
        <span class="sh-badge">Community · 不需要 GitHub 账号</span>
        <h1>补充 / 纠错</h1>
        <p class="sh-sub">
          发现某张图的资料有错漏？填个表单提交就行 —— 人工审核通过后会写进条目里，并署上你的昵称。
        </p>
        {/*
          账号是**可选**的：不登录照样能投（下面这条横幅就说明这一点），
          登录只是为了署名稳定（别人冒不了名）与累积等级，投稿会记到个人主页。
        */}
        <p class="sh-account" id="sh-account">
          <span class="sa-dot" id="sh-account-dot" aria-hidden="true">·</span>
          <span id="sh-account-text">正在读取登录状态…</span>
        </p>
        <ol class="sh-steps">
          <li><b>1</b>选地图</li>
          <li><b>2</b>填内容</li>
          <li><b>3</b>提交待审</li>
          <li><b>4</b>审核上线</li>
        </ol>
      </div>
      <a class="sh-guide" href="/contribute/">
        <span class="sh-guide-t">第一次来？看投稿指南</span>
        <span class="sh-guide-d">每条路适合什么、字段怎么填、提交之后会发生什么</span>
        <span class="sh-guide-go">打开指南 ↗</span>
      </a>
    </header>

    <div class="submit-layout">
      <div class="submit-main">
        <p class="s-ctx" id="ctx">正在读取地图信息…</p>

    {/*
      没带 ?map= 直接打开本页时的选图入口。
      以前这种情况只显示「找不到地图「」，请从地图详情页重新进入」—— 对不用 GitHub 的投稿者
      来说这其实是最好走的一条路，却在第一步就撞进死胡同，而且不知道该怎么办。
    */}
    <div class="form-card s-card s-pick" id="pick" hidden>
      <h2 class="s-title">先选一张地图</h2>
      <p class="form-hint">这个表单是给<strong>某一张图</strong>补充资料的，所以得先知道是哪张图。</p>
      <ol class="s-steps">
        <li>
          打开 <a href="/maps/">地图库</a> → 点进那张图 → 右侧栏点 <b>✏️ 补充这张图的资料</b>
        </li>
        <li>或者直接在下面输名字（中文名、英文名都行）：</li>
      </ol>
      <div class="s-pick-row">
        <input id="pick-slug" placeholder="ze_ffvii_mako_reactor 或 魔晄炉" autocomplete="off" />
        <button class="btn btn-primary" type="button" id="pick-go">打开投稿表单</button>
      </div>
      <p class="form-hint" id="pick-out"></p>
    </div>

    <form class="form-card s-card s-form" id="sub-form" hidden>

      {/*
        两种模式（2026-10-13 站长要求分成两件事）：
          · 单项补充 —— 补一格（难度 / 标签 / 视频…），字段选择器在这一档里；
          · 大面积整理 —— 整篇草稿，独立界面（分节编辑器），**字段选择器里不再出现它**。
        默认单项；从地图页「📝 大面积整理」进来（?field=draft）直接落在整理档。
      */}
      <div class="mode-tabs" role="tablist" aria-label="投稿方式">
        <button class="mode-tab is-on" type="button" id="mode-tab-single" role="tab">单项补充</button>
        <button class="mode-tab" type="button" id="mode-tab-draft" role="tab">大面积整理</button>
      </div>

      {/* 提交成功后点「继续补充这张图的其它项」回到表单时显示（文案由脚本填） */}
      <p class="s-ok-note" id="s-ok-note" hidden />

      {/*
        大面积整理（2026-10-13）：独立成块 + 独立界面。
        它不是「补一格」，而是**替这张图整理一整篇**；下面的编辑器按小节生成卡片，
        提交时拼成 `## 小节` 的草稿文本（服务端校验与采纳逻辑不变）。
      */}
      <section class="draft-cta" id="draft-cta" hidden>
        <div class="dc-main">
          <span class="dc-badge">大面积整理</span>
          <h2 class="dc-title">给这张图写一整篇（整篇条目草稿）</h2>
          <p class="dc-sub" id="draft-cta-sub">
            下面按小节列好了这张图现在的内容：<strong>想改哪节就改哪节</strong>，
            改动会自动存在本地（写一半刷新也不会丢）。采纳时按小节合并：改过的替换、没动过的原样保留。
          </p>
          <p class="dc-state" id="draft-cta-state"></p>
        </div>
        <div class="dc-actions">
          <button class="btn" type="button" id="draft-back">返回单项补充</button>
          <span class="dc-note" id="draft-cta-note"></span>
        </div>
      </section>

      <section class="s-step" id="step-pick">
        <h2 class="s-step-title"><span class="s-num">1</span>选地图与要补充的项目</h2>
        <div class="form-grid">
          <div class="form-row">
            <label for="f-map">地图</label>
            <input id="f-map" readonly />
          </div>
          <div class="form-row">
            <label for="f-field">要提交哪一项</label>
            <select id="f-field">
              {pickerFields.map((f) => <option value={f.key}>{f.label}</option>)}
            </select>
            {/* 选项按钮由脚本按 select 生成（见页面底部的「字段快捷按钮」） */}
            <div class="field-chips" id="field-chips" role="group" aria-label="要提交哪一项"></div>
          </div>
        </div>
        <p class="form-hint" id="f-hint"></p>
      </section>

      <section class="s-step">
        <h2 class="s-step-title"><span class="s-num">2</span>填内容</h2>
        {
          fields.map((f) => (
            <div class="form-row s-field" data-block={f.key} hidden>
              <label for={`f-in-${f.key}`}>{f.label}</label>
              {f.kind === 'enum' ? (
                <select id={`f-in-${f.key}`} data-input={f.key}>
                  {f.values.map((v) => (
                    <option value={v}>{v}</option>
                  ))}
                </select>
              ) : f.kind === 'image' ? (
                /*
                  封面：选图后**在浏览器里**裁成 16:9、转 webp、压到 ~100 KB 再上传。
                  这样手机截图（2~5 MB）不会卡在上传上，服务端也不必做图像处理。
                  真正的权威校验（种类 / 体积 / 尺寸）在 worker/covers.ts。
                */
                <div>
                  <label class="drop-zone" for={`f-in-${f.key}`}>
                    <span class="dz-icon" aria-hidden="true">🖼️</span>
                    <span class="dz-title">点击选择图片，或把文件拖到这里</span>
                    <span class="dz-sub">横向图效果最好；会自动裁成 16:9、压成 webp</span>
                    <span class="dz-files" />
                    <input
                      id={`f-in-${f.key}`}
                      data-input={f.key}
                      type="file"
                      accept="image/png,image/jpeg,image/webp"
                      class="dz-input"
                    />
                  </label>
                  <p class="form-hint" id="cover-status">
                    还没选图。选一张横向图，会自动裁成 16:9、压成 webp 再上传，不用自己处理。
                  </p>
                  <div class="cover-pair">
                    <figure class="cover-fig" id="cover-cur-wrap" hidden>
                      <img id="cover-current" alt="当前封面" />
                      <figcaption>当前封面</figcaption>
                    </figure>
                    <figure class="cover-fig is-new" id="cover-new-wrap" hidden>
                      <img id="cover-preview" alt="新封面预览" />
                      <figcaption>上传后</figcaption>
                    </figure>
                  </div>
                </div>
              ) : f.kind === 'gallery' ? (
                /*
                  图片集：可一次选多张，每张单独一条投稿、单独写一句说明。
                  浏览器里压成最长边 1600 的 webp（**不裁剪** —— 截图该保持原样），
                  权威校验与落盘在 worker/gallery.ts。
                */
                <div>
                  <label class="drop-zone" for={`f-in-${f.key}`}>
                    <span class="dz-icon" aria-hidden="true">📷</span>
                    <span class="dz-title">点击选择图片（可多选），或拖到这里</span>
                    <span class="dz-sub">不裁剪，只压成 webp；每张上传后可以单独写一句说明</span>
                    <span class="dz-files" />
                    <input
                      id={`f-in-${f.key}`}
                      data-input={f.key}
                      type="file"
                      accept="image/png,image/jpeg,image/webp"
                      multiple
                      class="dz-input"
                    />
                  </label>
                  <p class="form-hint" id="gallery-status">
                    还没选图。可一次选多张：会自动压成 webp 再上传，每张上传后可以单独写说明。
                  </p>
                  <div id="gallery-list" class="gallery-upload-list"></div>
                </div>
              ) : f.kind === 'itemlist' ? (
                /*
                  神器 / 道具：逐行更正，不做整表替换（表格在条目正文里，
                  合并逻辑在 shared/items.mjs 的 mergeItems）。行编辑器由脚本生成，
                  名称用 datalist 联想本站现有的写法 —— 名字对不上就会被当成「新增一件」。
                */
                <div>
                  <datalist id="items-known" />
                  {/*
                    站内现有的神器表列成一排按钮：点一件就把它的名字/冷却/次数/说明带进下面的行里改。
                    以前只能靠记忆打名字（表单里做名称联想），更新过的人少、还容易打成新增。
                  */}
                  <div id="items-current" class="items-current" />
                  <div id="items-rows" class="items-rows" />
                  <button class="btn s-add-row" type="button" id="items-add">
                    ＋ 再加一件（表里没有的）
                  </button>
                </div>
              ) : f.kind === 'longtext' ? (
                /*
                  正文类字段（背景故事 / 攻略讲解 / 补充说明）：既能新写一条，
                  也能**改已经通过的那一条** —— 点右侧面板里那条的「修订这条」，
                  正文会带进这个框，上面的修订条说明「改的是谁的稿」。
                  没有这条提示的话，投稿人会以为自己的修改是新增（2026-10-10 反馈）。
                */
                <div class="revise-wrap">
                  <p class="revise-bar" id={`revise-${f.key}`} hidden />
                  <textarea id={`f-in-${f.key}`} data-input={f.key} rows="8" />
                </div>
              ) : f.kind === 'tags' ? (
                /*
                  标签：列出**全站所有标签**让他勾（默认勾上这张图现有的那些），
                  找不到再走下面的「新标签」入口。以前是自由文本框，看不到站内已有什么，
                  同一个意思会分叉；而且 tags 是整组替换，只想加一个却常把原有的全写丢。
                  词表来自 /submit/tags.json（构建期从全站数据算），所以审核通过的新标签
                  下次构建就进词表 —— 以后谁给任何图投稿都能看到。
                */
                <div class="tag-picker" id="tag-picker">
                  <input
                    id="tag-search"
                    class="tag-search"
                    type="search"
                    placeholder="搜标签（例如「神器」「恐怖」）…"
                    autocomplete="off"
                  />
                  <div class="field-chips tag-chips" id="tag-chips" />
                  <div class="tag-new-row">
                    <input
                      id="tag-new"
                      class="tag-new"
                      maxlength="24"
                      placeholder="找不到想要的？输入一个新标签"
                      autocomplete="off"
                    />
                    <button class="btn" type="button" id="tag-new-add">＋ 新建标签</button>
                  </div>
                  <p class="form-hint" id="tag-status">正在加载标签词表…</p>
                </div>
              ) : f.kind === 'urlList' ? (
                <textarea
                  id={`f-in-${f.key}`}
                  data-input={f.key}
                  rows="3"
                  placeholder="每行一个链接（https:// 开头）"
                />
              ) : f.kind === 'doc' ? (
                /*
                  整篇条目草稿（2026-10-13）：**分节编辑器**，不再让投稿人对着空白大框写。
                  页面按这张图现在的小节生成卡片（有正文的带出正文，直接在上面改），
                  点「＋ 再加一节」也能新开一节；提交时拼成 `## 小节` 的文本交给服务端
                  （校验与采纳逻辑完全不变，见 shared/draft-merge.mjs）。
                  底下的 textarea 是「源码模式」，给习惯直接写 Markdown 的人留的后门，两边实时同步。
                */
                <div class="doc-wrap">
                  <p class="doc-login" id="doc-login-hint" hidden>
                    整篇草稿需要<strong>登录</strong>后才能提交（大面积改写要能追到人）—— 右上角登录即可，
                    没有账号 10 秒就能注册，不登录也照样能投其它字段。
                  </p>

                  <div class="doc-intro">
                    <label for={`f-in-${f.key}-intro`}>导语 / 简介（会变成条目开头那段）</label>
                    <textarea
                      id={`f-in-${f.key}-intro`}
                      data-doc-intro
                      rows="4"
                      placeholder="一两段说清：这张图是什么题材、大致怎么玩、有什么特别之处。"
                    />
                  </div>

                  <div class="doc-sections-head">
                    <span class="doc-sections-title">小节</span>
                    <span class="doc-sections-hint">改哪节就动哪节；不改的留空，采纳时原样保留</span>
                    <button class="btn btn-ghost doc-collapse-all" type="button" id="doc-collapse-all">
                      全部收起
                    </button>
                  </div>
                  <div class="doc-sections" id="doc-sections" />

                  <div class="doc-add">
                    <select id="doc-add-title" aria-label="要加哪一节">
                      <option value="">选择要加的小节…</option>
                      <option>简介</option>
                      <option>背景故事</option>
                      <option>基本信息</option>
                      <option>版本历史</option>
                      <option>关卡流程</option>
                      <option>神器 / 道具</option>
                      <option>人类策略</option>
                      <option>僵尸策略</option>
                      <option>常见问题</option>
                      <option>社区评价</option>
                      <option>更新日志</option>
                      <option>来源</option>
                      <option value="__custom">自定义标题…</option>
                    </select>
                    <button class="btn" type="button" id="doc-add-go">＋ 再加一节</button>
                    <button class="btn btn-ghost" type="button" id="doc-preview-btn">预览</button>
                    <button class="btn btn-ghost" type="button" id="doc-src-toggle">源码模式</button>
                    <button class="btn btn-ghost" type="button" id="doc-history-btn" hidden>🕘 历史版本</button>
                  </div>

                  <p class="doc-restore" id="doc-restore-note" hidden>
                    <span id="doc-restore-text" />
                    <button class="btn btn-ghost" type="button" id="doc-restore-clear">清除本地暂存</button>
                  </p>

                  <div class="doc-history" id="doc-history" hidden>
                    <div class="doc-history-head">
                      <strong>历史版本（这台电脑上的最近 3 版）</strong>
                      <button class="btn btn-ghost" type="button" id="doc-history-close">收起</button>
                    </div>
                    <p class="doc-history-hint">
                      每次停下来写一会儿会留一个版本点（约 1.5 分钟一个），最多留 3 版。
                      只存在你自己的浏览器里，换设备 / 清缓存就没了。
                    </p>
                    <div class="doc-history-list" id="doc-history-list" />
                  </div>

                  <div class="doc-preview" id="doc-preview" hidden>
                    <div class="doc-preview-head">
                      <strong>预览（页面上的样子）</strong>
                      <button class="btn btn-ghost" type="button" id="doc-preview-close">关闭预览</button>
                    </div>
                    <div class="doc-preview-body" id="doc-preview-body" />
                  </div>

                  <textarea
                    id={`f-in-${f.key}`}
                    data-input={f.key}
                    rows="18"
                    hidden
                    placeholder={'导语：这张图是什么、大致怎么玩（这一段会变成条目开头的简介）\n\n## 背景故事\n…\n\n## 关卡流程\n…'}
                  />
                  <p class="form-hint" id="doc-src-note" hidden>
                    源码模式：上面写的内容与这里实时同步。用一行 <code>## 小节标题</code> 分节。
                  </p>
                </div>
              ) : f.kind === 'textlist' ? (
                /* 一组短文本（目前只有「其他社区叫法」）：一行一条，写成「社区名：叫法」 */
                <textarea
                  id={`f-in-${f.key}`}
                  data-input={f.key}
                  rows="4"
                  placeholder="每行一条，例如：X 社区：爬雪山【娱】"
                />
              ) : (
                <input
                  id={`f-in-${f.key}`}
                  data-input={f.key}
                  type={f.kind === 'int' ? 'number' : 'text'}
                />
              )}
              {f.kind === 'itemlist' || f.kind === 'gallery' || f.kind === 'tags' ? null : f.kind ===
                'longtext' ? (
                f.key === 'summary' ? (
                  /*
                    简介特殊：本站有没有简介决定「你能不能投」——
                    没有 → 你写的就是开头那段；有 → 不接受覆盖，得改投别的字段。
                    静态 hint 说不了这种「看情况」，所以这里留一个容器由脚本填。
                  */
                  <p class="form-hint s-cur" id="summary-status" />
                ) : (
                  /* 其余正文没有「一个现值」可显示：本站正文与已有的社区投稿都在右侧面板里 */
                  <p class="form-hint s-cur">
                    这张图现有的正文与已经通过的投稿都列在右侧「这张图现在的内容」里 ——
                    想改哪一条，点那条的「修订这条」。
                  </p>
                )
              ) : (
                <p class="form-hint s-cur">
                  条目现在的值：<span class="cur-val" data-current={f.key}>—</span>
                </p>
              )}
            </div>
          ))
        }
      </section>

      <section class="s-step">
        <h2 class="s-step-title"><span class="s-num">3</span>署名与说明</h2>
        <div class="form-row">
          <label for="f-note">理由 / 来源（选填，但很有帮助）</label>
          <textarea id="f-note" rows="2" maxlength="500"
            placeholder="例如：工坊页面描述里写的是普通难度；或者给出参考链接"></textarea>
        </div>

        <div class="form-grid">
          <div class="form-row">
            <label for="f-submitter">你的昵称（选填，会署在条目里）</label>
            <input id="f-submitter" maxlength="32" />
            {/* 登录后署名以账号为准（防冒名）：这里说明一下，并把输入框锁上 */}
            <p class="form-hint" id="f-submitter-note" hidden></p>
          </div>
          <div class="form-row">
            <label for="f-contact">联系方式（选填，便于追问）</label>
            <input id="f-contact" maxlength="80" placeholder="QQ / 邮箱" />
          </div>
        </div>
      </section>

      {/*
        批量提交（2026-10-13）：一张图补资料常要同时改好几项，攒在一起一次交上去。
        队列为空时这一块完全隐藏，表单跟以前一模一样。
      */}
      <div class="batch-box" id="batch-box" hidden>
        <p class="batch-title">本次一起提交（<b id="batch-count">0</b> 项）</p>
        <div id="batch-list" class="batch-list"></div>
        <p class="form-hint">
          提交时会和上面当前这一项<strong>一起</strong>送审（同一批），审核台会看到它们属于同一次整理。
        </p>
      </div>

      <div class="s-actions">
        <button class="btn" type="button" id="batch-add">＋ 把这一项加入本次提交</button>
      </div>

      {/* 人机验证（没配 site key 时这块保持 hidden）：放在提交按钮上方 */}
      <div class="s-ts" id="s-ts" hidden></div>

      <div class="s-actions">
        <button class="btn btn-primary btn-lg" type="submit" id="f-submit">提交审核</button>
        <span class="s-actions-note">提交后进入人工审核队列 —— 通过才会写进条目，不通过会告诉你原因。</span>
      </div>
      <p class="form-hint">
        等得急、或者想问怎么写：<QqGroup />（群里也会贴审核进度）
      </p>
      <p class="form-error" id="f-error" hidden></p>
    </form>

    {/*
      提交前确认（2026-10-13 站长要求）：点「提交审核」不是直接发，先把这次要投的
      摊开给人看一眼（哪几项、内容是什么、署谁的名、是不是修订稿），确认了才发请求。
      用原生 <dialog>（和图片灯箱同一套）：Escape 关闭、焦点锁在框里、背景变暗都是浏览器给的。
      内容由脚本按当前表单填（见 openConfirm / buildConfirmBody）。
    */}
    <dialog class="s-confirm" id="submit-confirm" aria-labelledby="sc-title">
      <h2 class="sc-title" id="sc-title">确认提交</h2>
      <p class="sc-sub">
        核对一下这次要投的内容 —— 提交后就进人工审核队列，写错字段只能等审核台退回来。
      </p>
      <div class="sc-body" id="sc-body"></div>
      <p class="sc-warn" id="sc-warn" hidden></p>
      <p class="sc-tip">
        提交后会给你一个编号，可以随时用「查审核状态」看进度；审核通过才写进条目。
      </p>
      <div class="sc-actions">
        <button class="btn btn-ghost" type="button" id="sc-cancel">返回修改</button>
        <button class="btn btn-primary" type="button" id="sc-go" autofocus>确认提交</button>
      </div>
    </dialog>

    <div class="form-card s-card s-result" id="result" hidden></div>

    <div class="form-card s-card" id="status-card">
      <h2 class="s-title">查审核状态</h2>
      <p class="form-hint">提交成功后会给你一个编号，凭它就能查。</p>
      <div class="s-pick-row">
        <input id="q-id" type="number" min="1" placeholder="投稿编号，例如 12" />
        <button class="btn" type="button" id="q-go">查询</button>
      </div>
      <p class="s-status" id="q-out"></p>
    </div>
      </div>

      {/*
        右侧说明栏：这几条都是投稿者最常问的（以前散在正文提示里，读起来累）。
        内容纯静态，不参与提交逻辑。
      */}
      <aside class="submit-aside">
        {/*
          「这张图现在的内容」对照面板：投稿人的核心困难是**看不到现状**——
          要改难度、补神器、换封面，都得先知道现在写的是什么。这个卡片跟着滚动（sticky），
          表单在左边改、右边随时对照，不用来回切页面。内容由脚本按 mapInfo 填。
        */}
        <div class="s-aside-card" id="ref-card" hidden>
          <h3>这张图现在的内容</h3>
          <div id="ref-body" class="ref-body"></div>
          <a class="ref-open" id="ref-open" href="#" target="_blank" rel="noopener">
            在地图页打开对照 ↗
          </a>
        </div>
        <div class="s-aside-card">
          <h3>提交之后</h3>
          <ol class="s-timeline">
            <li>进入待审队列</li>
            <li>站长人工审核</li>
            <li>写回仓库</li>
            <li>自动重建，几分钟后上线</li>
          </ol>
        </div>
        <div class="s-aside-card">
          <h3>这些最有用</h3>
          <ul class="s-list">
            <li>难度定错了、标签不准</li>
            <li>神器表缺件、冷却写错</li>
            <li>通关流程、卡关点、常见问题</li>
            <li>真实截图（封面与图片集）</li>
          </ul>
        </div>
        <div class="s-aside-card">
          <h3>几点说明</h3>
          <ul class="s-list">
            <li>不需要 GitHub 账号</li>
            <li>
              <b>不登录也能投</b>；登录只是让署名稳定（别人冒不了名）、投稿记进
              <a href="/account/">个人主页</a>并累计等级
            </li>
            <li>署名可以留空</li>
            <li>会人工核对，不保证全采纳</li>
            <li>可以随时回来查编号</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  /* 与 Worker 共用同一份字段规则与校验 —— 前端只是「提前告诉你哪里不对」，
     真正的权威校验在服务端（worker/submissions.ts）。 */
  import { FIELD_RULES, validateValue } from '../../../shared/submission-fields.mjs';
  /* 登录状态：与页头那个账号按钮共用一次请求（见 lib/account-client.ts） */
  import { ACCOUNT_EVENT, meOrThrow } from '../../lib/account-client';
  /* 人机验证（Turnstile）：放提交按钮上方；没配 site key 时不渲染 */
  import { mountTurnstile, resetTurnstile, takeTurnstileToken, turnstileHint, turnstileToken } from '../../lib/turnstile';

  const tsBox = document.getElementById('s-ts');
  void mountTurnstile(tsBox).then((ok) => {
    if (ok && tsBox) tsBox.hidden = false;
  });

  const slug = new URLSearchParams(location.search).get('map') ?? '';
  const ctxEl = document.getElementById('ctx') as HTMLElement;
  const form = document.getElementById('sub-form') as HTMLFormElement;
  const fieldSel = document.getElementById('f-field') as HTMLSelectElement;
  const hintEl = document.getElementById('f-hint') as HTMLElement;
  const errEl = document.getElementById('f-error') as HTMLElement;
  const resultEl = document.getElementById('result') as HTMLElement;
  const submitBtn = document.getElementById('f-submit') as HTMLButtonElement;

  let mapInfo: Record<string, unknown> | null = null;
  let allMaps: Array<Record<string, unknown>> = [];
  /**
   * 登录状态（页头账号横幅那段脚本会写它）：true 已登录 / false 确定没登录 / null 还不知道（接口没通）。
   * 整篇草稿要求登录，这里拿来在提交**之前**就拦住，别让人写完一整篇才被服务端拒。
   */
  let meLoggedIn: boolean | null = null;

  /*
   * 没带 ?map= 时的选图入口。
   * 以前这种情况只丢下一句「请从地图详情页重新进入」就结束了 —— 对不用 GitHub 的投稿者
   * 来说这恰恰是最好走的一条路，却在第一步撞进死胡同，还不知道该去哪儿。
   */
  const pickEl = document.getElementById('pick') as HTMLElement;
  const pickInput = document.getElementById('pick-slug') as HTMLInputElement;
  const pickOut = document.getElementById('pick-out') as HTMLElement;

  function openPicker(why: string) {
    ctxEl.textContent = why;
    pickEl.hidden = false;
    pickInput.focus();
  }

  /** 中文名 / 英文名 / 内部名都能对上；先精确匹配再退化到包含匹配 */
  function goPick() {
    const q = pickInput.value.trim().toLowerCase();
    if (!q) {
      pickOut.textContent = '先输个名字，中文名或英文名都可以。';
      return;
    }
    const low = (v: unknown) => String(v ?? '').toLowerCase();
    const hit =
      allMaps.find((m) => low(m.slug) === q) ??
      allMaps.find((m) => low(m.titleEn) === q) ??
      allMaps.find((m) => low(m.title) === q) ??
      allMaps.find((m) => low(m.titleEn).includes(q)) ??
      allMaps.find((m) => low(m.title).includes(q));
    if (!hit) {
      pickOut.textContent = `没找到「${pickInput.value.trim()}」。可以去地图库搜一下，或者换成英文名试试。`;
      return;
    }
    location.href = '/submit/?map=' + encodeURIComponent(String(hit.slug));
  }

  document.getElementById('pick-go')?.addEventListener('click', goPick);
  pickInput?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') {
      e.preventDefault();
      goPick();
    }
  });
  /* 标签选择器的输入框/按钮（函数声明会提升，这里调用没问题） */
  wireTagPicker();

  const rules = FIELD_RULES as Record<string, { kind: string; hint?: string }>;

  function formatValue(v: unknown): string {
    if (v === undefined || v === null || v === '') return '（空）';
    if (Array.isArray(v)) return v.length ? v.join('、') : '（空）';
    return String(v);
  }

  /* ===== 神器 / 道具行编辑器 =====
     一行 = 一件道具。**动作不让投稿人选**：名字对得上本站已有的表就是「更正」，
     对不上就是「新增」，勾了「本图没有这件」就是「删除」（只加标注，不删行）。
     理由：2026-09-28 的反馈——面对「更正 / 新增」下拉框，投稿人不知道该选哪个。 */
  type ItemRow = { n?: string; c?: string; u?: string; k?: string; l?: string; i?: string };

  /** 本站这张图现在的表（手写正文 + 服务器配置 + 已通过的社区更正，构建期合成） */
  function currentItemRows(): ItemRow[] {
    const list = mapInfo?.items;
    return Array.isArray(list) ? (list as ItemRow[]) : [];
  }

  const keyOf = (name: unknown) => String(name ?? '').replace(/\u3000/g, ' ').replace(/\s+/g, ' ').trim().toLowerCase();

  /** 名字在本站表里对得上的那一行（对上就是「更正」，对不上就是「新增」） */
  function knownItemRow(name: string): ItemRow | null {
    const key = keyOf(name);
    if (!key) return null;
    return currentItemRows().find((r) => keyOf(r.n) === key) ?? null;
  }

  /** 一行现在的样子（给投稿人看：表里写的是什么） */
  function describeItemRow(row: ItemRow): string {
    const label = row.l ? `${row.l} / ${row.n}` : String(row.n ?? '');
    const nums = [row.c, row.u].filter((v) => v && v !== '—' && v !== '不限');
    return nums.length ? `${label}（${nums.join(' / ')}）` : label;
  }

  function addItemRow(preset?: ItemRow): void {
    const rowsEl = document.getElementById('items-rows');
    if (!rowsEl) return;

    const known = currentItemRows();
    const wrap = document.createElement('div');
    wrap.className = 'item-row';

    const line1 = document.createElement('div');
    line1.className = 'ir-grid';

    const name = document.createElement('input');
    name.dataset.k = 'name';
    name.setAttribute('list', 'items-known');
    name.placeholder = known.length ? `道具名（如 ${known[0].n}）` : '道具名';
    name.autocomplete = 'off';
    if (preset?.n) name.value = String(preset.n);

    const cd = document.createElement('input');
    cd.dataset.k = 'cd';
    cd.type = 'number';
    cd.min = '0';
    cd.max = '3600';
    cd.step = '0.5';
    cd.placeholder = '冷却秒';
    /* 表里存的是「60 秒」/「—」这种展示值：能取出数字就预填，取不出就留空（留空 = 这一项不动） */
    if (preset?.c) {
      const m = /(\d+(?:\.\d+)?)/.exec(String(preset.c));
      if (m) cd.value = m[1];
    }

    const uses = document.createElement('input');
    uses.dataset.k = 'uses';
    uses.type = 'number';
    uses.min = '0';
    uses.max = '99';
    uses.placeholder = '次数';
    if (preset?.u && /^\d+$/.test(String(preset.u).trim())) uses.value = String(preset.u).trim();

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'btn';
    del.textContent = '✕';
    del.title = '删掉这一行';
    del.addEventListener('click', () => wrap.remove());

    line1.append(name, cd, uses, del);

    const line2 = document.createElement('div');
    line2.className = 'ir-meta';

    const note = document.createElement('input');
    note.dataset.k = 'note';
    note.placeholder = '备注（选填）：我们服和原表的差别，如「只在第四关出现」';
    note.className = 'ir-note';

    /* 神器表「说明」列的一句话介绍 —— 这件神器是干嘛的（长文走「攻略 / 神器讲解」字段） */
    const intro = document.createElement('input');
    intro.dataset.k = 'intro';
    intro.maxLength = 200;
    intro.placeholder = '说明（选填）：这件神器是干嘛的，一句话';
    intro.className = 'ir-intro';
    if (preset?.i) intro.value = String(preset.i);

    const missingWrap = document.createElement('label');
    missingWrap.className = 'ir-missing';
    const missing = document.createElement('input');
    missing.type = 'checkbox';
    missing.dataset.k = 'missing';
    missingWrap.append(missing, document.createTextNode('本图没有这件'));

    line2.append(note, intro, missingWrap);

    const status = document.createElement('p');
    status.className = 'form-hint ir-status';
    status.dataset.k = 'status';

    const refresh = () => {
      const hit = knownItemRow(name.value);
      if (missing.checked) {
        status.textContent = hit
          ? `提交后会把「${describeItemRow(hit)}」标成『本图没有这件』（原来的行保留，只加标注）`
          : '表里没有这个名字，勾了也不会生效 —— 先填一个表里已有的名字';
        return;
      }
      if (hit) {
        status.textContent = `表里已有：${describeItemRow(hit)}${hit.i ? ` · 说明：${hit.i}` : ''} → 你填的冷却 / 次数 / 说明会改成新的，原值留在备注里`;
      } else if (name.value.trim()) {
        status.textContent = '表里没有这件 → 会作为新增（社区补充）加进表里';
      } else {
        status.textContent = currentItemRows().length
          ? '名字从下面的联想里选，或者照条目页的写法填'
          : '本站这张图还没有表 —— 你填的就成了它的第一张神器表';
      }
    };

    name.addEventListener('input', refresh);
    missing.addEventListener('change', refresh);

    wrap.append(line1, line2, status);
    rowsEl.append(wrap);
    refresh();
  }

  /** 读回编辑器里的行；整行全空的行直接丢掉（加了行又不用是常态） */
  function collectItems(): Array<Record<string, unknown>> {
    const out: Array<Record<string, unknown>> = [];
    for (const wrap of document.querySelectorAll<HTMLElement>('#items-rows .item-row')) {
      const val = (k: string) =>
        wrap.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`)?.value.trim() ?? '';
      const box = wrap.querySelector<HTMLInputElement>('[data-k="missing"]');
      const name = val('name');
      const cdRaw = val('cd');
      const usesRaw = val('uses');
      const note = val('note');
      const intro = val('intro');
      if (!name && !cdRaw && !usesRaw && !note && !intro) continue;
      /* 动作由名字决定（见 updateStatus）：勾了「本图没有」→ remove，表里有 → update，否则 add */
      const action = box?.checked ? 'remove' : knownItemRow(name) ? 'update' : 'add';
      out.push({ action, name, cd: cdRaw, uses: usesRaw, note, intro });
    }
    return out;
  }

  function prefillItems(): void {
    const rowsEl = document.getElementById('items-rows');
    const curEl = document.getElementById('items-current');
    const known = document.getElementById('items-known');
    const rows = currentItemRows();

    if (rowsEl) rowsEl.textContent = '';
    if (known) {
      known.textContent = '';
      for (const r of rows) {
        const opt = document.createElement('option');
        opt.value = String(r.n ?? '');
        opt.label = r.l
          ? String(r.l)
          : [r.c, r.u].filter((v) => v && v !== '—').join(' / ');
        known.append(opt);
      }
    }
    if (curEl) {
      curEl.textContent = '';
      if (!rows.length) {
        const p = document.createElement('p');
        p.className = 'form-hint';
        p.textContent = '本站还没有这张图的神器表 —— 你填的会成为第一张。';
        curEl.append(p);
      } else {
        const p = document.createElement('p');
        p.className = 'form-hint';
        p.textContent = `本站这张图现在的表（${rows.length} 件，点一件就能改它的冷却 / 次数 / 说明）：`;
        const box = document.createElement('div');
        box.className = 'field-chips items-current-chips';
        for (const r of rows) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = String(r.n ?? '');
          b.title = `${describeItemRow(r)}${r.i ? ` · 说明：${r.i}` : ''} —— 点一下带进下面的表单`;
          b.addEventListener('click', () => addItemRow(r));
          box.append(b);
        }
        curEl.append(p, box);
      }
    }
    addItemRow();
  }

  /*
   * 和「这张图现在长什么样」有关的提示（2026-10-13 加）：
   * 「地图中文名」只该用在**标题还是地图代码**的图上；已经有中文名的图，
   * 改名字属于译名之争，应该走「其他社区叫法」——否则 400 多张没名的图还没补完，
   * 已有的 500 多张先被改乱了。提示只做提醒，最终由审核人把关。
   */
  function mapSpecificHint(key: string): string {
    if (key !== 'title' && key !== 'aliases') return '';
    if (!mapInfo) return '';
    const cur = String(mapInfo.title ?? '');
    const en = String(mapInfo.titleEn ?? '');
    if (key === 'title') {
      return /[\u3400-\u9fff]/.test(cur)
        ? `提醒：这张图现在的标题是「${cur}」，已经有中文名了 —— 如果只是叫法不一样，请改投「其他社区叫法」。`
        : `这张图现在显示的是地图代码「${en}」，你填的中文名会当成条目标题显示。`;
    }
    return `这张图现在的标题是「${cur}」。只写确实见过别人这么叫的，并在前面写明是哪个社区。`;
  }

  function showField(key: string) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-block]')) {
      el.hidden = el.dataset.block !== key;
    }
    const extra = mapSpecificHint(key);
    hintEl.textContent = extra ? `${rules[key]?.hint ?? ''}　${extra}` : (rules[key]?.hint ?? '');
  }

  /* ===== 修订一条已通过的社区投稿 =====
     以前正文只能**追加**：发现自己写错了，只能在下面再补一段，条目页就出现两条
     几乎一样的段落，越改越乱（2026-10-10 的反馈）。
     现在点右侧面板里那条的「修订这条」→ 正文带进左侧表单 → 提交时带上 reviseOf（那条的 id）。
     审核通过后是**替换**它的正文，署名仍是原作者，条目页另标「谁在什么时候修订的」。 */
  type ReviseTarget = { field: string; id: string; by: string; text: string };
  let reviseTarget: ReviseTarget | null = null;

  /** 正文类字段的中文名（story → 背景故事）；从字段表取，不另写一份 */
  const fieldLabel = (key: string) => rules[key]?.label ?? '社区补充';

  function renderReviseBar(): void {
    for (const key of Object.keys(rules)) {
      const bar = document.getElementById(`revise-${key}`);
      if (!bar) continue;
      const on = reviseTarget?.field === key;
      bar.hidden = !on;
      bar.textContent = '';
      if (!on || !reviseTarget) continue;
      const who = reviseTarget.by || '匿名';
      const b = document.createElement('b');
      b.textContent = `正在修订 ${who} 的投稿`;
      bar.append(
        b,
        document.createTextNode(
          `（编号 ${reviseTarget.id}）：提交后是替换这一条，不是新增；署名仍是 ${who}，条目页会标注由你修订。`
        )
      );
      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.textContent = '取消修订';
      cancel.addEventListener('click', () => cancelRevise());
      bar.append(cancel);
    }
    /* 面板里高亮正在改的那一条 —— 滚回去还能对上号 */
    for (const el of document.querySelectorAll<HTMLElement>('.ref-note')) {
      el.classList.toggle('is-target', Boolean(reviseTarget) && el.dataset.noteId === reviseTarget?.id);
    }
  }

  function startRevise(t: ReviseTarget): void {
    /* 字段名不对（老数据 field 为 null）时落到「补充说明 / 纠错」—— 与条目页的分块规则一致 */
    const field = Object.prototype.hasOwnProperty.call(rules, t.field) ? t.field : 'body';
    reviseTarget = { ...t, field };
    fieldSel.value = field;
    showField(field);
    prefill(field);
    const input = document.querySelector<HTMLTextAreaElement>(`[data-input="${field}"]`);
    if (input) {
      input.value = t.text;
      input.focus();
    }
    renderReviseBar();
    errEl.hidden = true;
  }

  function cancelRevise(): void {
    if (!reviseTarget) return;
    reviseTarget = null;
    renderReviseBar();
    /* 清空正文框：取消修订后回到「新写一条」，别把别人的稿子留在框里当自己的投出去 */
    prefill(fieldSel.value);
  }

  /* ===== 「这张图现在的内容」对照面板（右侧 sticky） =====
     只读摘要：基本信息 + 神器表 + 攻略视频 + 资料来源 + 图片集张数。
     数据来自 /submit/maps.json（构建期把服务器配置、手写正文、已通过的社区更正合成好的那份），
     所以它跟条目页上看到的是一致的，不会出现「表单说 A、页面说 B」。 */
  function renderRefPanel(): void {
    const card = document.getElementById('ref-card');
    const body = document.getElementById('ref-body');
    const open = document.getElementById('ref-open') as HTMLAnchorElement | null;
    if (!card || !body) return;
    if (!mapInfo) {
      card.hidden = true;
      return;
    }
    card.hidden = false;
    if (open) open.href = `/maps/${mapInfo.slug}/`;
    body.textContent = '';

    /*
     * 一小段正文（本站整理的 / 社区投稿的）。
     * 正文可以到四千字，全摊开会把面板撑成一面墙 —— 给个能滚的小窗，
     * 投稿人要的是「现在写的是什么」，扫一眼就够。
     */
    const refText = (label: string, text: string) => {
      const wrap = document.createElement('div');
      const cap = document.createElement('p');
      cap.className = 'ref-note-meta';
      cap.textContent = label;
      const box = document.createElement('div');
      box.className = 'ref-text';
      box.textContent = text;
      wrap.append(cap, box);
      return wrap;
    };

    /*
     * 一条已通过的社区投稿：投的是哪个字段 + 谁写的 + 什么时候 + 正文 + 「修订这条」。
     * 修订按钮把这条的正文带进左侧表单（见 startRevise）—— 这是「能改」的入口，
     * 光把正文列出来还是只能追加。
     */
    const refNote = (n: Record<string, unknown>) => {
      const wrap = document.createElement('div');
      wrap.className = 'ref-note';
      const id = String(n.id ?? '');
      wrap.dataset.noteId = id;
      const who = String(n.by ?? '') || '匿名';
      const when = String(n.at ?? '').slice(0, 10);
      const field = String(n.field ?? '');
      const meta = document.createElement('p');
      meta.className = 'ref-note-meta';
      meta.textContent =
        `${fieldLabel(field)} · ${who}${when ? ` · ${when}` : ''}` +
        (n.revisedBy ? ` · ${String(n.revisedBy)} 修订过` : '');
      const box = document.createElement('div');
      box.className = 'ref-text';
      box.textContent = String(n.text ?? '');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ref-revise';
      btn.textContent = '修订这条';
      btn.title = `把这条正文带进左侧表单改（署名仍是 ${who}）`;
      btn.addEventListener('click', () =>
        startRevise({ field, id, by: who, text: String(n.text ?? '') })
      );
      wrap.append(meta, box, btn);
      return wrap;
    };

    const row = (label: string, value: unknown) => {
      const text = Array.isArray(value) ? value.join('、') : String(value ?? '');
      /* 空值不显示；「0」也当没有（关卡数 0 是「没填」，摆出来只是噪音）。
         「未知难度」要留着 —— 那正是一条「这里还缺资料」的提示。 */
      if (!text || text === '—' || text === 'undefined' || text === '0') return;
      const p = document.createElement('p');
      p.className = 'ref-row';
      const b = document.createElement('b');
      b.textContent = label;
      p.append(b, document.createTextNode(text));
      body.append(p);
    };
    row('难度', mapInfo.difficulty);
    if (Array.isArray(mapInfo.tags) && mapInfo.tags.length) row('标签', mapInfo.tags);
    row('作者', mapInfo.author);
    row('版本', mapInfo.version);
    row('人数', mapInfo.players);
    row('时长', mapInfo.duration);
    row('关卡', mapInfo.stages);
    if (typeof mapInfo.galleryCount === 'number') row('图片集', `${mapInfo.galleryCount} 张`);

    const info = mapInfo as Record<string, unknown>;

    /*
     * 本站正文：story = 人工整理稿里的「背景故事」整节（目前是魔晄炉 / 米纳斯 / 黑珍珠号那三张），
     * summary = 条目的简介段落（107 张有）。
     * 以前面板里完全没有正文 —— 投「背景故事」的人看不到已经写了什么，只能盲着追加一条。
     */
    const siteStory = typeof info.story === 'string' ? info.story : '';
    const siteSummary = typeof info.summary === 'string' ? info.summary : '';
    if (siteStory || siteSummary) {
      const h = document.createElement('p');
      h.className = 'ref-h';
      h.textContent = '本站正文';
      body.append(h);
      if (siteStory) body.append(refText('背景故事（本站整理）', siteStory));
      if (siteSummary) body.append(refText('简介（本站整理）', siteSummary));
    }

    /*
     * 已通过的社区投稿：列出来 + 每条一个「修订这条」。
     * 这是 2026-10-10 的反馈重点：以前只能新增，写错了改不了，页面上会出现两条几乎一样的段落。
     */
    const notes = (Array.isArray(info.notes) ? info.notes : []) as Array<Record<string, unknown>>;
    const nh = document.createElement('p');
    nh.className = 'ref-h';
    nh.textContent = notes.length ? `已通过的社区投稿（${notes.length} 条，可修订）` : '已通过的社区投稿';
    body.append(nh);
    if (!notes.length) {
      const p = document.createElement('p');
      p.className = 'form-hint';
      p.textContent =
        '还没有人投过正文 —— 你写的会成为第一条（通过后在条目页单独成块显示，署你的昵称，不会覆盖本站正文）。';
      body.append(p);
    } else {
      for (const n of notes) {
        body.append(refNote(n));
      }
    }
    const items = currentItemRows();
    const head = document.createElement('p');
    head.className = 'ref-h';
    head.textContent = items.length ? `神器 / 道具（${items.length} 件）` : '神器 / 道具（本站还没有这张图的表）';
    body.append(head);
    if (items.length) {
      const ul = document.createElement('ul');
      ul.className = 'ref-items';
      for (const r of items) {
        const li = document.createElement('li');
        li.textContent = `${r.n ?? ''}${r.c ? ` · ${r.c}` : ''}${r.u ? ` · ${r.u}` : ''}${r.i ? ` —— ${r.i}` : ''}`;
        ul.append(li);
      }
      body.append(ul);
    }
    for (const [label, key] of [
      ['攻略视频', 'videoUrls'],
      ['资料来源', 'sources'],
    ] as const) {
      const list = info[key];
      if (!Array.isArray(list) || !list.length) continue;
      const h = document.createElement('p');
      h.className = 'ref-h';
      h.textContent = `${label}（${list.length}）`;
      const ul = document.createElement('ul');
      ul.className = 'ref-list';
      for (const url of list) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = String(url);
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = String(url).replace(/^https?:\/\/(www\.)?/, '');
        li.append(a);
        ul.append(li);
      }
      body.append(h, ul);
    }
  }

  /* ===== 标签选择器 =====
     词表来自 /submit/tags.json（构建期从全站数据算出来的：每个标签挂多少张图）。
     默认勾上「这张图现在有的标签」—— 这样投稿人想加一个标签时，不会把原有的整组写丢
     （tags 是整组替换，这是以前最容易踩的坑）。 */
  type TagRow = { n: string; c: number };
  let tagVocab: TagRow[] | null = null;
  let tagSelected: string[] = [];
  let tagKeyword = '';

  const tagChipsEl = () => document.getElementById('tag-chips');
  const tagStatusEl = () => document.getElementById('tag-status');
  const tagLimit = () => rules.tags?.max ?? 12;

  function tagStateText(): string {
    const inVocab = new Set((tagVocab ?? []).map((t) => t.n));
    const fresh = tagSelected.filter((t) => !inVocab.has(t));
    const parts = [`已选 ${tagSelected.length} / ${tagLimit()}`];
    if (fresh.length) parts.push(`新标签 ${fresh.length} 个（${fresh.join('、')}）需审核确认`);
    return parts.join(' · ');
  }

  function renderTagChips(): void {
    const box = tagChipsEl();
    if (!box) return;
    box.textContent = '';
    const kw = tagKeyword.trim().toLowerCase();
    const selected = new Set(tagSelected);
    const vocab = tagVocab ?? [];
    /* 新标签（不在词表里的已选项）永远排在最前，免得搜索时看不到、以为没选上 */
    const fresh = tagSelected.filter((t) => !vocab.some((v) => v.n === t));
    for (const name of fresh) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'on is-new';
      b.textContent = `${name} · 新`;
      b.title = '新标签：审核通过后会进全站标签，之后任何人投稿都能选到';
      b.addEventListener('click', () => toggleTag(name));
      box.append(b);
    }
    const list = vocab.filter((t) => !kw || t.n.toLowerCase().includes(kw));
    for (const t of list) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = t.c >= 5 ? `${t.n} (${t.c})` : t.n;
      b.title = `全站 ${t.c} 张图用过这个标签`;
      if (selected.has(t.n)) b.className = 'on';
      b.addEventListener('click', () => toggleTag(t.n));
      box.append(b);
    }
    if (!list.length && !fresh.length) {
      const p = document.createElement('p');
      p.className = 'form-hint';
      p.textContent = tagVocab
        ? kw
          ? `词表里没有「${tagKeyword}」—— 用下面的「新建标签」加一个。`
          : '词表是空的。'
        : '标签词表加载中…';
      box.append(p);
    }
    const st = tagStatusEl();
    if (st) {
      st.textContent = tagVocab ? tagStateText() : '标签词表没加载出来 —— 仍可用下面的「新建标签」手动加。';
    }
  }

  function toggleTag(name: string): void {
    const i = tagSelected.indexOf(name);
    if (i >= 0) {
      tagSelected.splice(i, 1);
    } else {
      if (tagSelected.length >= tagLimit()) {
        const st = tagStatusEl();
        if (st) st.textContent = `最多 ${tagLimit()} 个标签 —— 先取消一个再选。`;
        return;
      }
      tagSelected.push(name);
    }
    renderTagChips();
  }

  function addNewTag(): void {
    const input = document.getElementById('tag-new') as HTMLInputElement | null;
    const raw = (input?.value ?? '').trim();
    if (!raw) return;
    /* 先用共用校验器过一遍（长度 / 字符 / 重复与服务端同一条规则），免得提交了才被拒 */
    const checked = validateValue('tags', [...tagSelected, raw]);
    if (!checked.ok) {
      const st = tagStatusEl();
      if (st) st.textContent = String((checked as { error?: string }).error ?? '这个标签不可用');
      return;
    }
    /* 词表里已有同名（忽略大小写）就选它，别再建一个只差大小写的标签 */
    const hit = (tagVocab ?? []).find((t) => t.n.toLowerCase() === raw.toLowerCase());
    if (input) input.value = '';
    if (hit) {
      if (!tagSelected.includes(hit.n)) toggleTag(hit.n);
      else renderTagChips();
      return;
    }
    tagSelected.push(raw);
    renderTagChips();
  }

  async function loadTagVocab(): Promise<void> {
    if (tagVocab) return;
    try {
      const r = await fetch('/submit/tags.json');
      const j = (await r.json()) as { tags?: TagRow[] };
      tagVocab = Array.isArray(j.tags) ? j.tags : [];
    } catch {
      tagVocab = [];
    }
    renderTagChips();
  }

  /** 切到「标签」字段或选中地图时调用：勾上这张图现有的标签，并确保词表已加载 */
  function prefillTags(): void {
    tagSelected = [...(mapInfo?.tags ?? [])];
    renderTagChips();
    void loadTagVocab();
  }

  function wireTagPicker(): void {
    const search = document.getElementById('tag-search') as HTMLInputElement | null;
    search?.addEventListener('input', () => {
      tagKeyword = search.value;
      renderTagChips();
    });
    const add = document.getElementById('tag-new-add');
    add?.addEventListener('click', addNewTag);
    const input = document.getElementById('tag-new') as HTMLInputElement | null;
    input?.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        addNewTag();
      }
    });
  }

  /* ===== 批量：本次一起提交的项（2026-10-13） =====
     动机：一张图补资料通常要同时改好几项（难度 + 标签 + 视频 + 正文），
     以前只能一项一项投，投稿人嫌烦、审核台也散。这里在表单里攒一个队列，
     提交时一次发上去（服务端写同一个 batch 号）。封面 / 图片集不走这条路 ——
     它们是 multipart 上传，各自单独投（表单里也说明了）。 */
  type BatchItem = { field: string; label: string; value: unknown; preview: string };
  let batchQueue: BatchItem[] = [];

  function shortPreview(v: unknown): string {
    if (Array.isArray(v)) return v.length ? `共 ${v.length} 项：${v.slice(0, 2).map(String).join('、')}${v.length > 2 ? '…' : ''}` : '（空）';
    if (v && typeof v === 'object') return `${Object.keys(v as object).length} 个字段`;
    const s = String(v ?? '').replace(/\s+/g, ' ').trim();
    return s.length > 60 ? `${s.slice(0, 60)}…` : s || '（空）';
  }

  function renderBatchQueue(): void {
    const box = document.getElementById('batch-list');
    const wrap = document.getElementById('batch-box');
    if (!box || !wrap) return;
    /* 大面积整理档里不显示批量块（队列本身留着，切回单项档还在） */
    wrap.hidden = batchQueue.length === 0 || mode === 'draft';
    box.textContent = '';
    batchQueue.forEach((item, i) => {
      const row = document.createElement('div');
      row.className = 'batch-row';
      const text = document.createElement('span');
      text.className = 'batch-text';
      text.textContent = `【${item.label}】${item.preview}`;
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn batch-del';
      del.textContent = '移除';
      del.addEventListener('click', () => {
        batchQueue.splice(i, 1);
        renderBatchQueue();
      });
      row.append(text, del);
      box.append(row);
    });
    const submit = document.getElementById('f-submit');
    if (submit) {
      submit.textContent = batchQueue.length ? `提交审核（共 ${batchQueue.length + 1} 项）` : '提交审核';
    }
  }

  function addToBatch(): void {
    errEl.hidden = true;
    /* 大面积整理档没有「加进本次提交」这回事（按钮也收起来了，这里再兜一道） */
    if (mode === 'draft') {
      return showError('大面积整理是一整篇，直接点「提交审核」就行 —— 不用加入批量。');
    }
    const key = fieldSel.value;
    const kind = rules[key]?.kind;
    /* 封面 / 图片集是图片上传，跟文本投稿不是一条路；草稿本身已经是一整篇，也不用攒 */
    if (kind === 'image' || kind === 'gallery' || kind === 'doc') {
      return showError('这一项要单独提交（图片是上传、草稿是一整篇），不用加入批量。');
    }
    const value = collect(key);
    const checked = validateValue(key, value);
    if (!checked.ok) return showError(checked.error);
    batchQueue.push({
      field: key,
      label: rules[key]?.label ?? key,
      value: checked.value,
      preview: shortPreview(checked.value),
    });
    /* 攒进去之后当前这项清空，免得连点两次投重复 */
    const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-input="${key}"]`);
    if (el && !['tags', 'itemlist'].includes(kind ?? '')) el.value = '';
    renderBatchQueue();
  }

  document.getElementById('batch-add')?.addEventListener('click', () => addToBatch());

  /*（原「开始整篇整理」按钮已被模式切换取代 —— 见下面的 applyMode）*/

  /*
   * ===== 两种模式：单项补充 / 大面积整理（2026-10-13） =====
   * 「大面积整理」不再只是字段选择器里的一个选项，而是一档独立界面：
   *   · 单项档：显示第 1 步（选地图 + 选字段）与那一个字段的编辑器；
   *   · 整理档：隐藏第 1 步与所有单项编辑器，只显示草稿的分节编辑器。
   * ?field=draft 进来直接落在整理档；点「返回单项补充」切回去。
   */
  type Mode = 'single' | 'draft';
  let mode: Mode = 'single';

  function applyMode(next: Mode): void {
    mode = next;
    const isDraft = next === 'draft';
    document.getElementById('mode-tab-single')?.classList.toggle('is-on', !isDraft);
    document.getElementById('mode-tab-draft')?.classList.toggle('is-on', isDraft);
    const pick = document.getElementById('step-pick');
    if (pick) pick.hidden = isDraft;
    document.getElementById('draft-cta')!.hidden = !isDraft;
    const draftField = document.querySelector<HTMLElement>('[data-block="draft"]');
    /*
     * 「攒几项一起投」只在单项档有意义 —— 大面积整理本身就是一整篇，
     * 这一档把批量那一块收起来（队列留着，切回单项档还在）。
     */
    const batchActions = document.getElementById('batch-add')?.closest<HTMLElement>('.s-actions');
    if (batchActions) batchActions.hidden = isDraft;
    renderBatchQueue();
    if (isDraft) {
      for (const el of document.querySelectorAll<HTMLElement>('[data-block]')) {
        el.hidden = el.dataset.block !== 'draft';
      }
      if (draftField) draftField.hidden = false;
      renderDraftEditor();
      draftField?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      showField(fieldSel.value);
    }
  }

  document.getElementById('mode-tab-single')?.addEventListener('click', () => applyMode('single'));
  document.getElementById('mode-tab-draft')?.addEventListener('click', () => applyMode('draft'));
  document.getElementById('draft-back')?.addEventListener('click', () => applyMode('single'));

  /* ===== 分节编辑器 =====
     maps.json 里带着这张图现在的小节（title + body）与简介。进来时按它们生成卡片：
     有正文的带出正文（直接在上面改），没有的就是空白卡片等着填。
     提交时再拼回 `## 标题\n正文` 的文本 —— 服务端只看那段文本，所以校验/采纳逻辑一行没动。 */
  type DocSection = { title: string; body: string; collapsed?: boolean };
  /** 含组件 / 表格的小节：草稿编辑器改不了（投稿正文禁 < > { }），标出来但**不参与提交** */
  type LockedSection = { title: string; note: string };
  let docSections: DocSection[] = [];
  let docLocked: LockedSection[] = [];
  /** 刚进来时每一节的原文（标题 → 正文），用来标记「已改动」与「恢复原文」 */
  let docOriginal = new Map<string, string>();
  let docReady = false;

  const originalBodyOf = (title: string): string | null => {
    const key = title.trim();
    return key && docOriginal.has(key) ? docOriginal.get(key)! : null;
  };

  /** 这一段是不是「纯文本」—— 含 < > { } 的是 MDX 组件或 HTML 表格，社区草稿不收（构建安全） */
  const plainTextOk = (s: string) => !/[<>{}]/.test(String(s ?? ''));

  const docIntroEl = () => document.querySelector<HTMLTextAreaElement>('[data-doc-intro]');
  const docSrcEl = () => document.querySelector<HTMLTextAreaElement>('[data-input="draft"]');

  function renderDraftEditor(): void {
    if (docReady) return;
    docReady = true;
    /* 导语改动也要回写源码（不然只改导语、没动小节时，提交的是旧文本） */
    docIntroEl()?.addEventListener('input', () => syncDocSource());
    const existing = String(mapInfo?.draft ?? '').trim();
    if (existing) {
      /* 已经有人写了草稿：把那篇拆开带进来（在别人基础上改，别各写一篇） */
      const parts = existing.split(/^##\s+/m);
      const intro = parts[0].trim();
      if (docIntroEl()) docIntroEl()!.value = intro;
      docSections = parts
        .slice(1)
        .map((chunk) => {
          const nl = chunk.indexOf('\n');
          return nl < 0
            ? { title: chunk.trim(), body: '' }
            : { title: chunk.slice(0, nl).trim(), body: chunk.slice(nl + 1).trim() };
        })
        .filter((s) => s.title);
    } else {
      const cur = Array.isArray(mapInfo?.sections) ? (mapInfo.sections as Array<{ title: string; body: string }>) : [];
      const usable = cur.filter((s) => plainTextOk(String(s.body ?? '')));
      const locked = cur.filter((s) => !plainTextOk(String(s.body ?? '')));
      const sum = String(mapInfo?.summary ?? '');
      /* 简介里若含组件/HTML 也不能带进来（同样是禁字符），那种情况留空 = 采纳时不改简介 */
      if (docIntroEl()) docIntroEl()!.value = plainTextOk(sum) ? sum : '';
      docSections = usable.map((s) => ({ title: String(s.title ?? ''), body: String(s.body ?? '') }));
      /* 原文统一 trim 后再比对：卡片里显示/提交的正文本来就会 trim，
         不归一化的话「从源码切回来」会被误判成每一节都改过（同样的内容也标成已改动）。 */
      docOriginal = new Map(docSections.map((s) => [s.title.trim(), s.body.trim()]));
      docLocked = locked.map((s) => ({
        title: String(s.title ?? ''),
        note: '这一节含组件或表格（草稿编辑器改不了），采纳时会原样保留',
      }));
    }
    renderDocSections();
    /* 有本地暂存就恢复（写到一半被刷新 / 关掉的情况），否则就是上面按原稿预填的内容 */
    restoreLocal();
  }

  function renderDocSections(): void {
    const box = document.getElementById('doc-sections');
    if (!box) return;
    box.textContent = '';
    docSections.forEach((sec, i) => {
      /*
       * 折叠状态记在小节对象上（不是 DOM 上）：重排 / 恢复原文 / 源码来回都不会丢。
       * 默认把长小节收起来 —— 一张图动辄七八节，全摊开要滚很久才找得到想改的那节；
       * 短小节（本来就没几行）留开着更省事。
       */
      if (sec.collapsed === undefined) sec.collapsed = sec.body.trim().length > 240;
      const card = document.createElement('div');
      const changed = originalBodyOf(sec.title) !== null && originalBodyOf(sec.title) !== sec.body.trim();
      card.className = `doc-card${changed ? ' is-changed' : ''}${sec.collapsed ? ' is-collapsed' : ''}`;

      const head = document.createElement('div');
      head.className = 'doc-card-head';
      const fold = docToolBtn(sec.collapsed ? '▸' : '▾', sec.collapsed ? '展开这一节' : '收起这一节', () => {
        docSections[i].collapsed = !docSections[i].collapsed;
        renderDocSections();
      }, 'doc-fold');
      const title = document.createElement('input');
      title.className = 'doc-card-title';
      title.value = sec.title;
      title.placeholder = '小节标题（例如「关卡流程」）';
      title.addEventListener('input', () => {
        docSections[i].title = title.value;
        syncDocSource();
        markDirty();
      });
      /* 顺序：长大纲小节顺序靠拖拽太复杂，给两个上下箭头就够用（顺序会影响页面上的排列） */
      const up = docToolBtn('▲', '上移一节', () => {
        if (i === 0) return;
        [docSections[i - 1], docSections[i]] = [docSections[i], docSections[i - 1]];
        renderDocSections();
      });
      const down = docToolBtn('▼', '下移一节', () => {
        if (i >= docSections.length - 1) return;
        [docSections[i + 1], docSections[i]] = [docSections[i], docSections[i + 1]];
        renderDocSections();
      });
      const revert = docToolBtn('↺', '恢复这一节的原文', () => {
        const orig = originalBodyOf(docSections[i].title);
        if (orig === null) return;
        docSections[i].body = orig;
        renderDocSections();
      });
      if (originalBodyOf(sec.title) === null) revert.disabled = true;
      const del = docToolBtn('×', '删掉这一节（采纳时保留本站原有的同名小节）', () => {
        docSections.splice(i, 1);
        renderDocSections();
      });
      head.append(fold, title, up, down, revert, del);

      /* 收起时看到的那一行：正文摘要 + 字数 / 是否改过（点一下也能展开） */
      const summary = document.createElement('p');
      summary.className = 'doc-card-summary';
      summary.textContent = `${docBodyPreview(sec.body)} · ${cardMetaText(sec.title, sec.body)}`;
      summary.addEventListener('click', () => {
        docSections[i].collapsed = false;
        renderDocSections();
      });

      const body = document.createElement('textarea');
      body.className = 'doc-card-body';
      body.rows = 10;
      body.value = sec.body;
      body.placeholder = '这一节的内容（支持简单 Markdown；插图写一行 :::figure 2，图在左）';
      body.addEventListener('input', () => {
        docSections[i].body = body.value;
        syncDocSource();
        markDirty();
        /* 只更新本卡片的「已改动」标记与字数，不重建 DOM（重建会丢光标） */
        card.classList.toggle('is-changed', originalBodyOf(sec.title) !== null && originalBodyOf(sec.title) !== body.value.trim());
        const meta = card.querySelector<HTMLElement>('.doc-card-meta');
        if (meta) meta.textContent = cardMetaText(sec.title, body.value);
      });

      const foot = document.createElement('div');
      foot.className = 'doc-card-foot';
      const meta = document.createElement('span');
      meta.className = 'doc-card-meta';
      meta.textContent = cardMetaText(sec.title, sec.body);
      foot.append(meta);
      /* 插图片块：图片集里有图时才有意义（序号按图片集顺序，页面上的 :::figure 就是这个序号） */
      const galleryCount = Number(mapInfo?.galleryCount ?? 0);
      if (galleryCount > 0) {
        foot.append(
          docToolBtn(`🖼 插入图片块（${galleryCount} 张可选）`, '把 :::figure 模板插到光标处', () => {
            const n = prompt(`引用图片集里第几张？（1~${galleryCount}）`, '1');
            if (n === null) return;
            const idx = Number(n);
            if (!Number.isInteger(idx) || idx < 1 || idx > galleryCount) {
              return showError(`图片序号要在 1~${galleryCount} 之间`);
            }
            insertAtCursor(body, `\n:::figure ${idx}\n\n:::\n`);
            docSections[i].body = body.value;
            syncDocSource();
            markDirty();
          }),
        );
      }

      card.append(head, summary, body, foot);
      box.append(card);
    });

    /* 含组件/表格的小节：只列出来说明「改不了但会保留」，不给输入框、也不进提交文本 */
    for (const lock of docLocked) {
      const card = document.createElement('div');
      card.className = 'doc-card is-locked';
      const head = document.createElement('div');
      head.className = 'doc-card-head';
      const title = document.createElement('span');
      title.className = 'doc-card-title is-static';
      title.textContent = lock.title;
      head.append(title);
      const note = document.createElement('p');
      note.className = 'doc-card-note';
      note.textContent = lock.note;
      card.append(head, note);
      box.append(card);
    }
    renderCollapseAllBtn();
    syncDocSource();
  }

  /** 收起时那一行摘要：正文压成一行、前 60 字（还没写就说清楚） */
  function docBodyPreview(body: string): string {
    const one = String(body ?? '').replace(/\s+/g, ' ').trim();
    if (!one) return '这一节还空着';
    const chars = [...one];
    return chars.length > 60 ? `${chars.slice(0, 60).join('')}…` : one;
  }

  /** 「全部收起 / 全部展开」按钮：还有一节开着就是「全部收起」，否则「全部展开」 */
  function renderCollapseAllBtn(): void {
    const b = document.getElementById('doc-collapse-all') as HTMLButtonElement | null;
    if (!b) return;
    b.hidden = docSections.length === 0;
    b.textContent = docSections.some((s) => !s.collapsed) ? '全部收起' : '全部展开';
  }

  document.getElementById('doc-collapse-all')?.addEventListener('click', () => {
    const anyOpen = docSections.some((s) => !s.collapsed);
    for (const s of docSections) s.collapsed = anyOpen;
    renderDocSections();
  });

  /** 小节卡片底部那行：字数 + 已改动提示（对照刚进来时的原文；两边都 trim 过再比） */
  function cardMetaText(title: string, body: string): string {
    const len = [...body.trim()].length;
    const orig = originalBodyOf(title);
    if (orig === null) return `${len} 字 · 新增的小节`;
    if (orig !== body.trim()) return `${len} 字 · 已改动（原文 ${[...orig].length} 字）`;
    return `${len} 字 · 与本站原文一致`;
  }

  function docToolBtn(label: string, title: string, onClick: () => void, extra = ''): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = `btn btn-ghost doc-tool${extra ? ` ${extra}` : ''}`;
    b.textContent = label;
    b.title = title;
    b.addEventListener('click', onClick);
    return b;
  }

  /** 在某段文本的光标处插入一段（图片块模板用） */
  function insertAtCursor(el: HTMLTextAreaElement, text: string): void {
    const start = el.selectionStart ?? el.value.length;
    const end = el.selectionEnd ?? start;
    el.value = el.value.slice(0, start) + text + el.value.slice(end);
    el.selectionStart = el.selectionEnd = start + text.length;
    el.focus();
  }

  /** 把卡片 + 导语拼成草稿文本，写回那个隐藏的 textarea（提交读的就是它） */
  function syncDocSource(): void {
    const el = docSrcEl();
    if (!el) return;
    const intro = docIntroEl()?.value.trim() ?? '';
    const blocks = docSections
      .filter((s) => s.title.trim())
      .map((s) => `## ${s.title.trim()}\n${s.body.trim()}`.trimEnd());
    el.value = [intro, ...blocks].filter(Boolean).join('\n\n');
  }

  function addDocSection(title: string): void {
    docSections.push({ title, body: '', collapsed: false });
    renderDocSections();
    /* 滚到新卡片并把光标放进正文，省一次点击。
       只找可编辑的卡片 —— 后面还挂着一串「含组件、改不了」的只读卡片，
       直接取最后一 .doc-card 会滚到那串上去（新卡片根本不在视野里）。 */
    const cards = [...document.querySelectorAll<HTMLElement>('#doc-sections .doc-card:not(.is-locked)')];
    const last = cards[cards.length - 1];
    last?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    last?.querySelector<HTMLTextAreaElement>('.doc-card-body')?.focus();
  }

  document.getElementById('doc-add-go')?.addEventListener('click', () => {
    const sel = document.getElementById('doc-add-title') as HTMLSelectElement | null;
    if (!sel) return;
    const picked = sel.value;
    if (!picked) return;
    if (picked === '__custom') {
      const t = prompt('小节标题写什么？（例如「彩蛋与机关」）', '');
      if (t === null || !t.trim()) return;
      addDocSection(t.trim());
    } else {
      addDocSection(picked);
    }
    sel.value = '';
  });

  document.getElementById('doc-src-toggle')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const src = docSrcEl();
    const note = document.getElementById('doc-src-note');
    if (!src) return;
    const showSrc = src.hidden;
    if (!showSrc) {
      /* 从源码切回卡片：把源码拆成卡片 */
      loadDocFromText(src.value);
    }
    src.hidden = !showSrc;
    if (note) note.hidden = !showSrc;
    btn.textContent = showSrc ? '收起源码' : '源码模式';
    const sections = document.getElementById('doc-sections');
    if (sections) sections.hidden = showSrc;
    if (!showSrc) markDirty();
  });

  /* ===== 本地暂存 + 版本历史（2026-10-13；版本历史当天稍后补） =====
     整篇草稿是长文：写一半刷新、误关标签页、被家里人点走 —— 都会白写。这里每次输入
     防抖存进 localStorage（键按地图分开），下次打开自动恢复，并提示「已恢复上次未提交的内容」。
     只留最新一版时，改坏了 / 删多了就找不回来（本地没有撤销），所以再留几个版本点：
       · 隔一会儿（约 1.5 分钟）内容确实变了 → 把「当时那一版」留下来，最多 3 版；
       · 「历史版本」面板列出每一版的时间 / 字数 / 首行摘要，一键恢复；
       · 恢复本身也会先把「恢复前的内容」存成一版 —— 恢复不等于删除。
     全部只在这台电脑的浏览器里，不涉及任何服务端数据，也不上传；随时能清。 */
  const AUTOSAVE_PREFIX = 'ze-submit-draft:';
  const HISTORY_MAX = 3;
  /** 两个版本点之间至少隔这么久，免得每敲一句停一下就留一版 */
  const SNAP_GAP_MS = 90_000;
  let autosaveTimer: number | undefined;
  let dirty = false;

  type LocalSnap = { at: number; text: string };
  type LocalSave = { at: number; text: string; history: LocalSnap[]; snapAt: number };

  const autosaveKey = () => `${AUTOSAVE_PREFIX}${slug}`;

  /** 读本地暂存（老格式 {at,text} 也认，history 缺省为空） */
  function readLocal(): LocalSave | null {
    try {
      const raw = localStorage.getItem(autosaveKey());
      if (!raw) return null;
      const j = JSON.parse(raw) as { at?: number; text?: string; history?: unknown; snapAt?: number };
      const text = String(j.text ?? '');
      if (!text.trim()) return null;
      const history = Array.isArray(j.history)
        ? (j.history as Array<{ at?: number; text?: string }>)
            .map((h) => ({ at: Number(h?.at ?? 0), text: String(h?.text ?? '') }))
            .filter((h) => h.text.trim())
        : [];
      return { at: Number(j.at ?? 0), text, history, snapAt: Number(j.snapAt ?? 0) };
    } catch {
      return null;
    }
  }

  function writeLocal(rec: LocalSave): void {
    try {
      localStorage.setItem(autosaveKey(), JSON.stringify(rec));
    } catch {
      /* 隐私模式 / 配额满：不打扰用户，只是没有本地暂存 */
    }
  }

  /** 存一版。forceSnap = 不管间隔多久，都先给「上一版」留一个版本点（恢复历史版本时用） */
  /** 存一版：内容变了、且离上一个版本点够久 → 先把「上一版」留成历史，再写当前版 */
  function commitLocal(text: string): void {
    const now = Date.now();
    const prev = readLocal();
    let history = prev ? prev.history.slice() : [];
    let snapAt = prev?.snapAt ?? 0;
    const prevText = prev?.text ?? '';
    if (prevText && prevText !== text && history[0]?.text !== prevText && now - snapAt > SNAP_GAP_MS) {
      history = [{ at: prev?.at || now, text: prevText }, ...history];
      snapAt = now;
    }
    /* 和历史里某一版一样的内容不再重复留一条（它本来就是「当前版」了） */
    history = history.filter((h) => h.text !== text).slice(0, HISTORY_MAX);
    writeLocal({ at: now, text, history, snapAt: snapAt || now });
    renderHistoryBtn();
  }

  function markDirty(): void {
    dirty = true;
    window.clearTimeout(autosaveTimer);
    autosaveTimer = window.setTimeout(saveLocal, 700);
  }

  function saveLocal(): void {
    const text = docSrcEl()?.value ?? '';
    if (!text.trim()) return;
    try {
      commitLocal(text);
    } catch {
      /* 同上：存不了就算了，别打断写作 */
    }
  }

  function clearLocal(): void {
    try {
      localStorage.removeItem(autosaveKey());
    } catch {}
    renderHistoryBtn();
  }

  function restoreLocal(): boolean {
    const saved = readLocal();
    renderHistoryBtn();
    if (!saved) return false;
    const text = saved.text.trim();
    /* 和刚预填的内容一样就没必要「恢复」 */
    if (text === (docSrcEl()?.value ?? '').trim()) return false;
    loadDocFromText(text);
    setRestoreNote(
      `已恢复上次未提交的草稿（本地暂存${saved.at ? `，${new Date(saved.at).toLocaleString('zh-CN')}` : ''}）` +
        '—— 不想要就点右面的「清除本地暂存」。'
    );
    dirty = true;
    return true;
  }

  /** 蓝色的那条提示（本地暂存 / 历史版本都往这里写文案；按钮不跟着被清掉） */
  function setRestoreNote(text: string): void {
    const note = document.getElementById('doc-restore-note');
    const span = document.getElementById('doc-restore-text');
    if (span) span.textContent = text;
    if (note) note.hidden = false;
  }

  const historyBox = () => document.getElementById('doc-history') as HTMLElement | null;

  /** 「历史版本（N）」按钮的显隐与计数；面板开着时顺带刷新列表 */
  function renderHistoryBtn(): void {
    const btn = document.getElementById('doc-history-btn') as HTMLButtonElement | null;
    const n = readLocal()?.history.length ?? 0;
    if (btn) {
      btn.hidden = n === 0;
      btn.textContent = `🕘 历史版本（${n}）`;
    }
    if (n === 0) {
      const box = historyBox();
      if (box) box.hidden = true;
    } else if (historyBox()?.hidden === false) {
      renderHistoryList();
    }
  }

  /** 历史版本列表：时间 + 字数 + 首行摘要 + 「恢复这一版」 */
  function renderHistoryList(): void {
    const list = document.getElementById('doc-history-list');
    if (!list) return;
    const snaps = readLocal()?.history ?? [];
    list.textContent = '';
    if (!snaps.length) {
      const p = document.createElement('p');
      p.className = 'doc-history-hint';
      p.textContent = '还没有更早的版本 —— 再写一会儿就有了（每约 1.5 分钟留一版）。';
      list.append(p);
      return;
    }
    for (const snap of snaps) {
      const row = document.createElement('div');
      row.className = 'dh-row';
      const meta = document.createElement('div');
      meta.className = 'dh-meta';
      const when = document.createElement('b');
      when.textContent = snap.at ? new Date(snap.at).toLocaleString('zh-CN') : '（时间不明）';
      const info = document.createElement('span');
      info.textContent = `${[...snap.text.trim()].length} 字 · ${docBodyPreview(snap.text)}`;
      meta.append(when, info);
      const use = document.createElement('button');
      use.type = 'button';
      use.className = 'btn btn-ghost dh-use';
      use.textContent = '恢复这一版';
      use.addEventListener('click', () => restoreVersion(snap));
      row.append(meta, use);
      list.append(row);
    }
  }

  /** 恢复到某一版：先把「现在这一版」留成历史，再把恢复的那一版设为当前（恢复 ≠ 删除） */
  function restoreVersion(snap: LocalSnap): void {
    const prev = readLocal();
    /* 编辑器里的内容就是「现在这一版」；本地记的那份同源，取哪边都一样 */
    const curText = (docSrcEl()?.value ?? '').trim();
    loadDocFromText(snap.text);
    const history = [
      ...(curText && curText !== snap.text.trim()
        ? [{ at: prev?.at || Date.now(), text: prev?.text?.trim() === curText ? prev.text : curText }]
        : []),
      ...(prev?.history ?? []),
    ]
      .filter((h) => h.text.trim() && h.text !== snap.text)
      .slice(0, HISTORY_MAX);
    writeLocal({ at: Date.now(), text: snap.text, history, snapAt: Date.now() });
    renderHistoryBtn();
    dirty = true;
    const box = historyBox();
    if (box) box.hidden = true;
    const when = snap.at ? new Date(snap.at).toLocaleString('zh-CN') : '这一版';
    setRestoreNote(
      `已恢复到 ${when} 的内容 —— 恢复前的内容也留成了「历史版本」，点上面的按钮随时能换回去。`
    );
  }

  document.getElementById('doc-history-btn')?.addEventListener('click', () => {
    const box = historyBox();
    if (!box) return;
    box.hidden = !box.hidden;
    if (!box.hidden) renderHistoryList();
  });
  document.getElementById('doc-history-close')?.addEventListener('click', () => {
    const box = historyBox();
    if (box) box.hidden = true;
  });

  /** 把一段草稿文本拆回卡片（恢复本地暂存 / 从源码切回来都用它） */
  function loadDocFromText(text: string): void {
    const parts = String(text ?? '').split(/^##\s+/m);
    if (docIntroEl()) docIntroEl()!.value = parts[0].trim();
    docSections = parts
      .slice(1)
      .map((chunk) => {
        const nl = chunk.indexOf('\n');
        return nl < 0 ? { title: chunk.trim(), body: '' } : { title: chunk.slice(0, nl).trim(), body: chunk.slice(nl + 1).trim() };
      })
      .filter((s) => s.title);
    renderDocSections();
  }

  /** 草稿预览：按拼出来的文本渲染成页面上的样子（只读），省得脑补排版 */
  function renderDocPreview(): void {
    const box = document.getElementById('doc-preview');
    const body = document.getElementById('doc-preview-body');
    if (!box || !body) return;
    const text = docSrcEl()?.value ?? '';
    body.textContent = '';
    const parts = text.split(/^##\s+/m);
    const intro = parts[0].trim();
    if (intro) body.append(para(intro));
    for (const chunk of parts.slice(1)) {
      const nl = chunk.indexOf('\n');
      const t = (nl < 0 ? chunk : chunk.slice(0, nl)).trim();
      const b = nl < 0 ? '' : chunk.slice(nl + 1).trim();
      const h = document.createElement('h4');
      h.textContent = t;
      body.append(h);
      if (b) body.append(para(b));
    }
    box.hidden = false;
    box.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  const para = (text: string): HTMLElement => {
    const p = document.createElement('p');
    p.className = 'guide-para';
    p.textContent = text;
    return p;
  };

  document.getElementById('doc-preview-btn')?.addEventListener('click', () => renderDocPreview());
  document.getElementById('doc-preview-close')?.addEventListener('click', () => {
    const box = document.getElementById('doc-preview');
    if (box) box.hidden = true;
  });
  document.getElementById('doc-restore-clear')?.addEventListener('click', () => {
    clearLocal();
    const note = document.getElementById('doc-restore-note');
    if (note) note.hidden = true;
  });

  /* 有未提交内容时离开页面给个提醒（浏览器只允许显示固定文案，不能自定义） */
  window.addEventListener('beforeunload', (e) => {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = '';
  });

  function renderDraftCta(): void {
    const state = document.getElementById('draft-cta-state');
    const note = document.getElementById('draft-cta-note');
    if (!state || !mapInfo) return;
    const sections = Array.isArray(mapInfo.sections) ? (mapInfo.sections as Array<{ title: string }>) : [];
    const hasSummary = String(mapInfo.summary ?? '').trim().length > 0;
    const draft = String(mapInfo.draft ?? '').trim();
    if (note) {
      note.textContent = draft
        ? '这张图已经有一篇待采纳的草稿 —— 点进来会在它的基础上继续改。'
        : '写好先以「社区整理版（未采纳）」显示在页面上，站长采纳后才进正文。';
    }
    const hasBody = sections.length > 0 || hasSummary;
    if (!hasBody) {
      state.textContent =
        '这张图现在还没有本站整理的正文（页面上只有自动生成的关卡 / 神器 / 数据概况）—— ' +
        '你写的这一篇就是它的第一版正文。';
      state.classList.add('is-empty');
    } else {
      state.textContent =
        `这张图现在有 ${sections.length} 个人工小节${hasSummary ? ' + 一段简介' : ''}` +
        `${sections.length ? `（${sections.map((s) => s.title).slice(0, 6).join(' / ')}${sections.length > 6 ? ' …' : ''}）` : ''}` +
        '。你只写要改的那几节也行。';
      state.classList.remove('is-empty');
    }
  }

  function prefill(key: string) {
    const input = document.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      `[data-input="${key}"]`
    );
    const curEl = document.querySelector<HTMLElement>(`[data-current="${key}"]`);
    const cur = mapInfo?.[key];
    /* 列表类字段（标签 / 视频 / 来源）以前挤成一行「a、b、c」，改的时候根本对不上号；
       现在逐条列出来，投稿人能看到「已经有哪几条」，再决定追加还是替换。 */
    if (curEl) {
      if (Array.isArray(cur) && cur.length) {
        curEl.textContent = '';
        const ul = document.createElement('ul');
        ul.className = 'cur-list';
        for (const item of cur) {
          const li = document.createElement('li');
          li.textContent = String(item);
          ul.append(li);
        }
        curEl.append(ul);
      } else {
        curEl.textContent = formatValue(cur);
      }
    }

    /* 神器 / 道具：没有「一个值」可以预填，改成列出现有的表 + 一行空行等投稿人填 */
    if (rules[key]?.kind === 'itemlist') {
      prefillItems();
      return;
    }

    /*
     * 整篇草稿（2026-10-13）：
     *   · 已经有别人写的草稿 → 带进框里接着改（避免两个人各写一篇、站长没法比）；
     *   · 没登录 → 显示提示条（服务端也会拦，这里提前说清楚，别让人写完了才发现）。
     */
    if (rules[key]?.kind === 'doc') {
      const hint = document.getElementById('doc-login-hint');
      /* 分节编辑器负责内容（见 renderDraftEditor）：这里只处理「登录提示」 */
      void input;
      if (hint) {
        void meOrThrow()
          .then((r) => {
            hint.hidden = Boolean(r.user);
            if (!r.user) hint.textContent = '整篇草稿需要登录后才能提交（大面积改写要能追到人）—— 右上角登录即可，不登录也照样能投其它字段。';
          })
          .catch(() => {
            hint.hidden = false;
          });
      }
      return;
    }

    /*
     * 简介：静态 hint 说不清「这一项到底能不能投」，得看这张图现在有没有简介。
     * 有 → 明说投不了并指路（不然稿子写完了才发现白写）；
     * 没有 → 告诉他这段会出现在条目开头，顺带再强调一次跟「背景故事」的区别。
     */
    if (key === 'summary') {
      const st = document.getElementById('summary-status');
      if (st) {
        const has = String(mapInfo?.summary ?? '').trim().length > 0;
        st.textContent = has
          ? '这张图已经有本站整理的简介（右侧「本站正文」里就能看到）—— 简介不接受覆盖，这一项投不了。' +
            '想补充内容请改投「背景故事」（剧情设定）或「补充说明 / 纠错」。'
          : '这张图还没有简介 —— 你写的会成为它正文开头那段导语，署你的昵称。' +
            '只写总览（什么题材、大致怎么玩、有什么特别），剧情设定请投「背景故事」。';
        st.classList.toggle('is-warn', has);
      }
    }

    /* 标签：勾选器，默认勾上这张图现有的标签（避免整组替换把原有的写丢） */
    if (rules[key]?.kind === 'tags') {
      prefillTags();
      return;
    }

    /* 图片集：也不能预填（多张图 + 说明），但告诉投稿人这张图现在有几张，
       免得把已有的图又投一遍 */
    if (rules[key]?.kind === 'gallery') {
      updateGalleryStatus();
      return;
    }

    /* 封面：把当前那张显示成缩略图，换的时候好对比 */
    if (key === 'cover') {
      const wrap = document.getElementById('cover-cur-wrap');
      const img = document.getElementById('cover-current') as HTMLImageElement | null;
      if (wrap && img && typeof cur === 'string' && cur) {
        img.src = cur;
        wrap.hidden = false;
      } else if (wrap) {
        wrap.hidden = true;
      }
    }

    /* 文件控件不能赋值（会抛异常），而且封面本来就不预填 */
    if (!input || (input as HTMLInputElement).type === 'file') return;
    if (cur === undefined || cur === null) input.value = '';
    else if (Array.isArray(cur)) input.value = cur.join('\n');
    else input.value = String(cur);
  }

  function collect(key: string): unknown {
    if (rules[key]?.kind === 'itemlist') return collectItems();
    /* 标签来自选择器（勾选 + 新建），不是文本框 */
    if (rules[key]?.kind === 'tags') return [...tagSelected];
    const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      `[data-input="${key}"]`
    );
    if (!el) return undefined;
    const kind = rules[key]?.kind;
    if (kind === 'int') return el.value === '' ? '' : Number(el.value);
    if (kind === 'tags' || kind === 'urlList' || kind === 'textlist') {
      return el.value
        .split('\n')
        .map((s) => s.trim())
        .filter(Boolean);
    }
    return el.value;
  }

  function showError(msg: string) {
    errEl.textContent = msg;
    errEl.hidden = false;
  }

  fieldSel.addEventListener('change', () => {
    showField(fieldSel.value);
    prefill(fieldSel.value);
    errEl.hidden = true;
    /* 已经翻篇了：那条「已回到表单…」的提示别一直挂着 */
    const ok = document.getElementById('s-ok-note');
    if (ok) ok.hidden = true;
  });

  document.getElementById('items-add')?.addEventListener('click', () => addItemRow());

  /* 载入地图索引（构建期生成的 /submit/maps.json） */
  fetch('/submit/maps.json')    .then((r) => r.json())
    .then((list: Array<Record<string, unknown>>) => {
      allMaps = list;
      if (!slug) {
        openPicker('还没选中地图 —— 先选一张，再填要补的资料。');
        return;
      }
      mapInfo = list.find((m) => m.slug === slug) ?? null;
      if (!mapInfo) {
        openPicker(`找不到地图「${slug}」—— 换个名字再试，或者从地图库点进来。`);
        return;
      }
      ctxEl.innerHTML = `正在为 <strong>《${mapInfo.title}》</strong>（${mapInfo.titleEn}）补充资料。`;
      (document.getElementById('f-map') as HTMLInputElement).value =
        `${mapInfo.title}（${mapInfo.titleEn}）`;

      /* ?field=items 可以直接落到某一项；?field=draft 直接落在「大面积整理」档
         （投稿指南、地图页侧栏的两个入口都靠它少点两下） */
      const want = new URLSearchParams(location.search).get('field') ?? '';

      form.hidden = false;
      if (want === 'draft') {
        applyMode('draft');
      } else {
        if (want && Object.prototype.hasOwnProperty.call(FIELD_RULES, want)) fieldSel.value = want;
        applyMode('single');
      }
      renderRefPanel();
      prefill(want === 'draft' ? 'draft' : fieldSel.value);
      renderDraftCta();
    })
    .catch(() => {
      ctxEl.textContent = '读取地图索引失败，请刷新重试。';
    });

  /* ===== 封面：在浏览器里裁成 16:9、压成 webp =====
     为什么不直接传原图：手机截图动辄 2~5 MB，而封面在页面里最大只用 1280px 宽。
     本地先处理掉，上传快、仓库小，服务端也不必引图像库（Worker 里那点运行时做不了这个）。
     这里压得再狠也不算数 —— 权威校验在 worker/covers.ts，它只看字节。 */
  const COVER_MAX_BYTES = 700 * 1024; // 与 worker/covers.ts 保持一致
  const COVER_TARGET_W = 1280;

  let coverBlob: Blob | null = null;
  let coverExt = 'webp';

  const coverInput = document.getElementById('f-in-cover') as HTMLInputElement | null;
  const coverStatus = document.getElementById('cover-status') as HTMLElement | null;
  const coverPreview = document.getElementById('cover-preview') as HTMLImageElement | null;
  const coverNewWrap = document.getElementById('cover-new-wrap') as HTMLElement | null;

  /** 解码：优先 createImageBitmap，失败退 <img>（HEIC 这类浏览器解不开的要给人话术） */
  async function loadBitmap(file: File): Promise<ImageBitmap | HTMLImageElement> {
    if (typeof createImageBitmap === 'function') {
      try {
        return await createImageBitmap(file);
      } catch {
        /* 交给下面的 <img> 再试一次 */
      }
    }
    return await new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        resolve(img);
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error('浏览器解不开这个图片格式（比如手机直出的 HEIC），先另存为 JPG 再传'));
      };
      img.src = url;
    });
  }

  const encodeCanvas = (canvas: HTMLCanvasElement, type: string, quality: number) =>
    new Promise<Blob | null>((resolve) => canvas.toBlob((b) => resolve(b), type, quality));

  async function buildCover(file: File): Promise<{ blob: Blob; ext: string; w: number; h: number }> {
    const src = await loadBitmap(file);
    const sw = src.width;
    const sh = src.height;
    if (!sw || !sh) throw new Error('读不出这张图的尺寸');

    /* 居中裁成 16:9（和 npm run cover:set 的默认行为一致） */
    const ratio = 16 / 9;
    let cw = sw;
    let ch = sh;
    if (sw / sh > ratio) cw = Math.round(sh * ratio);
    else ch = Math.round(sw / ratio);
    const cx = Math.round((sw - cw) / 2);
    const cy = Math.round((sh - ch) / 2);

    const outW = Math.min(COVER_TARGET_W, cw);
    const outH = Math.max(1, Math.round(outW / ratio));
    const canvas = document.createElement('canvas');
    canvas.width = outW;
    canvas.height = outH;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('这个浏览器不支持 canvas，换一个浏览器试试');
    ctx.drawImage(src as CanvasImageSource, cx, cy, cw, ch, 0, 0, outW, outH);
    if ('close' in src && typeof (src as ImageBitmap).close === 'function') (src as ImageBitmap).close();

    /* 优先 webp（体积最小）；浏览器不支持编码 webp 时退 jpg */
    let blob = await encodeCanvas(canvas, 'image/webp', 0.82);
    let ext = 'webp';
    if (!blob || blob.type !== 'image/webp') {
      blob = await encodeCanvas(canvas, 'image/jpeg', 0.85);
      ext = 'jpg';
    }
    if (!blob) throw new Error('压缩失败，换一张图试试');

    /* 还偏大就降质量重压（1280×720 正常只有几十 KB，很少走到这里） */
    for (const q of [0.7, 0.6, 0.5]) {
      if (blob.size <= COVER_MAX_BYTES) break;
      const again = await encodeCanvas(canvas, blob.type || 'image/jpeg', q);
      if (again) blob = again;
    }
    return { blob, ext, w: outW, h: outH };
  }

  coverInput?.addEventListener('change', async () => {
    const file = coverInput.files?.[0];
    coverBlob = null;
    if (coverNewWrap) coverNewWrap.hidden = true;
    if (!file) {
      if (coverStatus) coverStatus.textContent = '还没选图。';
      return;
    }
    if (coverStatus) coverStatus.textContent = '正在裁剪压缩…';
    errEl.hidden = true;
    try {
      const r = await buildCover(file);
      coverBlob = r.blob;
      coverExt = r.ext;
      if (coverPreview) {
        coverPreview.src = URL.createObjectURL(r.blob);
        if (coverNewWrap) coverNewWrap.hidden = false;
      }
      if (coverStatus) {
        coverStatus.textContent =
          `已压好：${r.w}×${r.h} · ${Math.round(r.blob.size / 1024)} KB` +
          `（原图 ${Math.round(file.size / 1024)} KB → ${r.ext}）`;
      }
    } catch (err) {
      if (coverStatus) coverStatus.textContent = '这张图用不了。';
      showError(err instanceof Error && err.message ? err.message : '图片处理失败');
    }
  });

  /* ===== 图片集：可多选，逐张压、逐张说明 =====
     和封面共用 loadBitmap / encodeCanvas，差别是**不裁剪**（截图本来就该保持原样）、
     最长边压到 1600、上限放宽到 1.5 MB（图片进 R2，不进 git —— 见 worker/gallery.ts）。 */
  const GALLERY_MAX_BYTES = 1500 * 1024; // 与 worker/gallery.ts 保持一致
  const GALLERY_MAX_EDGE = 1600;
  const GALLERY_CAPTION_MAX = 60;

  type GalleryItem = {
    blob: Blob;
    ext: string;
    w: number;
    h: number;
    caption: string;
    /** 预览用的 objectURL —— 移除或提交成功时要 revoke，否则整页生命周期里一直占内存 */
    url: string;
  };
  const galleryItems: GalleryItem[] = [];

  const galleryInput = document.getElementById('f-in-gallery') as HTMLInputElement | null;
  const galleryStatus = document.getElementById('gallery-status') as HTMLElement | null;
  const galleryList = document.getElementById('gallery-list') as HTMLElement | null;

  async function buildGalleryImage(
    file: File
  ): Promise<{ blob: Blob; ext: string; w: number; h: number }> {
    const src = await loadBitmap(file);
    const sw = src.width;
    const sh = src.height;
    if (!sw || !sh) throw new Error('读不出这张图的尺寸');

    /* 只缩不放：小图保持原样，大图等比缩到最长边 1600 */
    const scale = Math.min(1, GALLERY_MAX_EDGE / Math.max(sw, sh));
    const outW = Math.max(1, Math.round(sw * scale));
    const outH = Math.max(1, Math.round(sh * scale));
    const canvas = document.createElement('canvas');
    canvas.width = outW;
    canvas.height = outH;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('这个浏览器不支持 canvas，换一个浏览器试试');
    ctx.drawImage(src as CanvasImageSource, 0, 0, outW, outH);
    if ('close' in src && typeof (src as ImageBitmap).close === 'function') (src as ImageBitmap).close();

    let blob = await encodeCanvas(canvas, 'image/webp', 0.82);
    let ext = 'webp';
    if (!blob || blob.type !== 'image/webp') {
      blob = await encodeCanvas(canvas, 'image/jpeg', 0.85);
      ext = 'jpg';
    }
    if (!blob) throw new Error('压缩失败，换一张图试试');

    for (const q of [0.7, 0.6, 0.5, 0.4]) {
      if (blob.size <= GALLERY_MAX_BYTES) break;
      const again = await encodeCanvas(canvas, blob.type || 'image/jpeg', q);
      if (again) blob = again;
    }
    return { blob, ext, w: outW, h: outH };
  }

  function updateGalleryStatus(): void {
    if (!galleryStatus) return;
    const has = Number(mapInfo?.galleryCount ?? 0);
    const base = has ? `《${mapInfo?.title}》现在的图片集有 ${has} 张。` : '';
    if (!galleryItems.length) {
      galleryStatus.textContent =
        base + '还没选图。可一次选多张：会自动压成 webp 再上传，每张上传后可以单独写说明。';
      return;
    }
    const total = galleryItems.reduce((n, i) => n + i.blob.size, 0);
    galleryStatus.textContent =
      base +
      `已压好 ${galleryItems.length} 张，共 ${Math.round(total / 1024)} KB` +
      ` —— 提交后一张一条投稿，都要过审。`;
  }

  /** 把选中的图标出来：缩略图 + 说明输入框 + 移除按钮 */
  function renderGalleryList(): void {
    if (!galleryList) return;
    galleryList.textContent = '';
    galleryItems.forEach((item, idx) => {
      const card = document.createElement('figure');
      card.className = 'gal-card';

      const img = document.createElement('img');
      img.src = item.url;
      img.alt = `第 ${idx + 1} 张`;
      img.className = 'gal-thumb';

      const cap = document.createElement('input');
      cap.value = item.caption;
      cap.maxLength = GALLERY_CAPTION_MAX;
      cap.placeholder = '这张图是什么？（选填）';
      cap.className = 'gal-cap';
      cap.addEventListener('input', () => {
        item.caption = cap.value;
      });

      const meta = document.createElement('figcaption');
      meta.className = 'form-hint gal-meta';
      meta.textContent = `${item.w}×${item.h} · ${Math.round(item.blob.size / 1024)} KB`;

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn gal-del';
      del.textContent = '移除这张';
      del.addEventListener('click', () => {
        URL.revokeObjectURL(item.url);
        galleryItems.splice(idx, 1);
        renderGalleryList();
        updateGalleryStatus();
      });

      card.append(img, cap, meta, del);
      galleryList.append(card);
    });
  }

  galleryInput?.addEventListener('change', async () => {
    const files = [...(galleryInput.files ?? [])];
    if (!files.length) return;
    errEl.hidden = true;
    if (galleryStatus) galleryStatus.textContent = `正在压缩 ${files.length} 张…`;
    for (const file of files) {
      try {
        const r = await buildGalleryImage(file);
        galleryItems.push({
          blob: r.blob,
          ext: r.ext,
          w: r.w,
          h: r.h,
          caption: '',
          url: URL.createObjectURL(r.blob),
        });
      } catch (err) {
        showError(`${file.name}：${err instanceof Error && err.message ? err.message : '处理失败'}`);
      }
    }
    /* 清空控件，这样同一张图还能再选一次（比如刚移除了想加回来） */
    galleryInput.value = '';
    renderGalleryList();
    updateGalleryStatus();
  });

  /** 提交成功后统一的展示（文本 / 封面 / 图片集共用；图片集一次会拿到多个编号） */
  function showSuccess(idOrIds: number | number[], extra: string, submittedField?: string) {
    const ids = (Array.isArray(idOrIds) ? idOrIds : [idOrIds]).filter((n) => Number.isFinite(n) && n > 0);
    const head = ids.length > 1
      ? `编号 <strong>${ids.join('、')}</strong>（共 ${ids.length} 条）`
      : `编号 <strong>${ids[0] ?? '—'}</strong>`;
    form.hidden = true;
    resultEl.hidden = false;
    /* 内容已经交上去了，别再拦「确定要离开吗」 */
    dirty = false;
    /* 「继续补充这张图的其它项」：补一张图一般要连着投好几项（难度 + 标签 + 视频 + 正文），
       以前每投一项都要重新选地图、重走一遍表单。这里就地回到表单，地图不动、刚投的那项清空。 */
    resultEl.innerHTML =
      `<h2>提交成功 ✅</h2>` +
      `<p class="form-ok">${head} —— 请记下它，可以回来查审核状态。</p>` +
      `<p class="form-hint">${extra}</p>` +
      `<div class="succ-actions">` +
      `<button class="btn btn-primary" type="button" id="succ-more">＋ 继续补充这张图的其它项</button>` +
      `<a class="btn btn-ghost" href="/maps/${slug}/">先回条目页看看</a>` +
      `</div>` +
      `<p class="form-hint">难度 / 标签 / 攻略视频 / 背景故事…都能接着投：地图已经选好，` +
      `刚才那一项已经清空，不会重复投。</p>`;
    document.getElementById('succ-more')?.addEventListener('click', () => backToForm(submittedField));
    const qid = document.getElementById('q-id') as HTMLInputElement;
    if (qid) qid.value = String(ids[ids.length - 1] ?? '');
  }

  /** 清掉刚刚投出去的那一项（各字段的形态不一样，逐个来），免得接着投时又投一遍 */
  function resetSubmittedField(field?: string): void {
    if (!field) return;
    const kind = rules[field]?.kind;
    const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-input="${field}"]`);
    if (el && (el as HTMLInputElement).type !== 'file') el.value = '';
    if (kind === 'tags') {
      tagSelected = [];
      renderTagChips();
    } else if (kind === 'itemlist') {
      const rows = document.getElementById('items-rows');
      if (rows) rows.textContent = '';
      addItemRow();
    } else if (kind === 'doc') {
      /* 草稿：导语 + 各小节 + 锁定节都清掉（提交成功后本地暂存也一并清了） */
      const intro = docIntroEl();
      if (intro) intro.value = '';
      docSections = [];
      docLocked = [];
      docOriginal = new Map();
      renderDocSections();
    } else if (field === 'cover') {
      coverBlob = null;
      if (coverInput) coverInput.value = '';
      if (coverNewWrap) coverNewWrap.hidden = true;
      if (coverStatus) coverStatus.textContent = '';
    } else if (field === 'gallery') {
      for (const item of galleryItems) URL.revokeObjectURL(item.url);
      galleryItems.splice(0, galleryItems.length);
      renderGalleryList();
      updateGalleryStatus();
    }
  }

  /** 从成功页回到表单：留着地图与署名，接着投同一张图的下一项 */
  function backToForm(submittedField?: string): void {
    resetSubmittedField(submittedField);
    const note = document.getElementById('f-note') as HTMLTextAreaElement | null;
    if (note) note.value = '';
    reviseTarget = null;
    renderReviseBar();
    dirty = false;
    clearLocal();
    resultEl.hidden = true;
    form.hidden = false;
    applyMode('single');
    const ok = document.getElementById('s-ok-note');
    if (ok) {
      ok.textContent =
        `已回到表单：地图还是《${mapInfo?.title ?? slug}》—— 在第 1 步选下一项接着投就行` +
        `（署名 / 联系方式都还留着）。`;
      ok.hidden = false;
    }
    document.getElementById('step-pick')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /*
   * ===== 登录状态（可选）=====
   * 站点**不要求登录**：没登录就按老样子匿名投稿，署名用手填昵称。
   * 登录了则：署名固定为账号昵称（防冒名）、投稿记进 /account/ 个人主页、累计等级；
   * 通过够多的账号还能免审直发。这一段只是把现状说清楚 + 锁住昵称输入框。
   */
  (async () => {
    const box = document.getElementById('sh-account-text');
    const banner = document.getElementById('sh-account');
    const dot = document.getElementById('sh-account-dot');
    const note = document.getElementById('f-submitter-note');
    const nameInput = document.getElementById('f-submitter') as HTMLInputElement | null;
    if (!box) return;

    const paint = (user: { name: string; trusted: boolean; level: string } | null, reachable: boolean) => {
      meLoggedIn = user ? true : reachable ? false : null;
      banner?.classList.toggle('is-on', Boolean(user));
      banner?.classList.toggle('is-off', !reachable);
      if (dot) dot.textContent = user ? '✓' : reachable ? '?' : '!';
      if (user) {
        box.innerHTML =
          `已登录：<b>${user.name}</b>（${user.level}）—— 投稿会记进` +
          `<a href="/account/">你的个人主页</a>，署名固定用账号昵称` +
          (user.trusted ? '，而且你已有免审资格（直接随下一批写回）' : '') +
          '。';
      } else if (reachable) {
        box.innerHTML =
          '<b>不登录也能投</b> —— 现在以匿名方式投稿，署名用你下面填的昵称。' +
          '想要稳定署名（别人冒不了名）、把投稿记进个人主页、攒等级与免审资格，可以' +
          '<a class="sa-cta" href="/account/">注册账号 →</a>';
      } else {
        box.textContent = '登录状态没读到（接口没通）—— 不影响投稿，直接填就行。';
      }
      if (nameInput) {
        if (user) {
          nameInput.value = user.name;
          nameInput.readOnly = true;
        } else if (nameInput.readOnly) {
          /* 在页头面板里退出登录后，这里要放开手填 */
          nameInput.readOnly = false;
          nameInput.value = '';
        }
      }
      if (note) {
        note.textContent = '署名以账号为准（想改名到个人主页改，这里不能手填）。';
        note.hidden = !user;
      }
    };

    const refresh = async () => {
      try {
        const data = await meOrThrow();
        paint(data.user, true);
      } catch {
        paint(null, false);
      }
    };

    await refresh();
    /* 页头账号面板里登录 / 退出后，这条横幅立刻跟着变（不用刷页） */
    document.addEventListener(ACCOUNT_EVENT, () => void refresh());
  })();

  /* ===== 提交前确认（2026-10-13 站长要求） =====
     以前点「提交审核」直接发请求：字段选错、备注漏写、手滑连点投两遍，都只能等审核台退回来。
     现在先把这次要投的东西摊开看一眼（哪几项、内容是什么、署谁的名、是不是修订稿），
     确认了才发。分两步：prepareSubmission() 只做**本地校验**（不联网、不取 token），
     runSubmit() 才是原来那段发请求的逻辑。
     用原生 <dialog>：Escape 关闭、焦点锁在框里、背景变暗都是浏览器给的，不用自己写。 */
  type SubmissionPlan = {
    field: string;
    /** 非批量时提交的那个值（封面 / 图片集没有值，走各自的上传接口） */
    value?: unknown;
    /** 这一批要投的项：队列里的 + 当前这一项 */
    batchItems: Array<{ field: string; value: unknown }>;
    /** 队列里本来就攒了东西 → 按 items[] 批量提交（服务端打同一个 batch 号） */
    batched: boolean;
    /** 修订某条已通过的投稿时带上它的 id */
    reviseOf: string;
    note: string;
    submitter: string;
    contact: string;
    /** 图片集这一批几张图 */
    galleryCount?: number;
    /** 封面的压缩结果文案（确认框里显示） */
    coverInfo?: string;
    /** 整理档里被暂时忽略的批量队列条数（确认框里说清楚，免得以为投出去了） */
    queuedIgnored?: number;
  };
  let plan: SubmissionPlan | null = null;
  /** 确认框是什么时候弹出来的 —— 用来挡掉「按住回车」的连击（见 sc-go 的处理） */
  let openedAt = 0;

  const confirmDlg = document.getElementById('submit-confirm') as HTMLDialogElement | null;

  /** 确认框里的一行：左边是名目，右边是内容（内容可能不止一段，所以右列用 div） */
  function scRow(label: string, content: Node | string): HTMLElement {
    const row = document.createElement('div');
    row.className = 'sc-row';
    const k = document.createElement('span');
    k.className = 'sc-k';
    k.textContent = label;
    const v = document.createElement('div');
    v.className = 'sc-v';
    if (typeof content === 'string') v.textContent = content;
    else v.append(content);
    row.append(k, v);
    return row;
  }

  /** 草稿在确认框里的摘要：多少字、哪几个小节 —— 一整篇贴出来没法看 */
  function docPlanSummary(text: string): string {
    const sections = String(text ?? '')
      .split(/^##\s+/m)
      .slice(1)
      .map((chunk) => (chunk.split('\n')[0] ?? '').trim())
      .filter(Boolean);
    const len = [...String(text ?? '').trim()].length;
    return (
      `共 ${len} 字 · ${sections.length} 个小节` +
      (sections.length ? `（${sections.slice(0, 6).join('、')}${sections.length > 6 ? ' …' : ''}）` : '')
    );
  }

  function buildConfirmBody(p: SubmissionPlan): void {
    const body = document.getElementById('sc-body');
    const warn = document.getElementById('sc-warn');
    if (!body) return;
    body.textContent = '';
    body.append(scRow('地图', `${mapInfo?.title ?? slug}（${slug}）`));

    /* 这一批要投的项：一项一项列清楚「投的是哪个字段、内容长什么样」 */
    const list = document.createElement('ul');
    list.className = 'sc-list';
    for (const item of p.batchItems) {
      const li = document.createElement('li');
      const name = document.createElement('b');
      name.textContent = rules[item.field]?.label ?? item.field;
      const val = document.createElement('span');
      if (rules[item.field]?.kind === 'doc') val.textContent = docPlanSummary(String(item.value ?? ''));
      else if (rules[item.field]?.kind === 'gallery') val.textContent = `共 ${p.galleryCount ?? 0} 张图`;
      else if (rules[item.field]?.kind === 'image') val.textContent = p.coverInfo || '一张新封面';
      else val.textContent = shortPreview(item.value);
      li.append(name, document.createTextNode('：'), val);
      list.append(li);
    }
    body.append(scRow(p.batchItems.length > 1 ? `要提交的 ${p.batchItems.length} 项` : '要提交的项', list));

    body.append(scRow('署名', p.submitter.trim() || '（没填，会显示为匿名）'));
    if (p.contact.trim()) body.append(scRow('联系方式', p.contact.trim()));
    if (p.note.trim()) body.append(scRow('给站长的话', p.note.trim()));

    /* 提醒那几条「这次提交的特殊之处」——修订稿 / 整篇整理 / 一批多张图 */
    const tips: string[] = [];
    if (p.reviseOf) {
      tips.push(
        `这是<b>修订</b>稿：审核通过后会替换原来那一条（编号 ${p.reviseOf}），署名仍归原作者。`
      );
    }
    /* 注意字段名是 draft、它的 kind 才是 doc —— 别写成 p.field === 'doc'（踩过） */
    if (rules[p.field]?.kind === 'doc') {
      tips.push(
        '大面积整理：投稿先以「社区整理版（未采纳）」显示在条目页，站长在审核台点「采纳为原稿」后' +
          '才按小节合并进正文（同名小节替换、没写到的小节原样保留）。'
      );
    }
    if (p.field === 'gallery') {
      tips.push(`图片集是<b>一张一条投稿</b>：这一批 ${p.galleryCount ?? 0} 张会分别进队列，都要过审。`);
    }
    if (p.field === 'cover') {
      tips.push('审核通过后封面会替换成这一张。');
    }
    if (p.batched) {
      tips.push('这一批会打同一个批次号，审核台能看到它们属于同一次整理。');
    }
    if (p.queuedIgnored) {
      tips.push(
        `注意：这次<b>只提交整篇草稿</b>。你攒在「本次一起提交」里的 ${p.queuedIgnored} 项` +
          '留在队列里没动，切回「单项补充」再投。'
      );
    }
    if (warn) {
      warn.innerHTML = tips.join('<br>');
      warn.hidden = tips.length === 0;
    }
  }

  function openConfirm(p: SubmissionPlan): void {
    plan = p;
    openedAt = Date.now();
    buildConfirmBody(p);
    if (confirmDlg && typeof confirmDlg.showModal === 'function') {
      if (!confirmDlg.open) confirmDlg.showModal();
      return;
    }
    /* 极老的浏览器没有 <dialog>：退回原生 confirm，总比没有确认好 */
    if (window.confirm('确认提交这次投稿？')) {
      plan = null;
      void runSubmit(p);
    } else {
      plan = null;
    }
  }

  function closeConfirm(): void {
    if (confirmDlg?.open) confirmDlg.close();
    plan = null;
  }

  document.getElementById('sc-cancel')?.addEventListener('click', () => {
    closeConfirm();
    /* 回到「提交审核」，接着改 —— 表单里的东西一个字都没动 */
    submitBtn.focus();
  });

  document.getElementById('sc-go')?.addEventListener('click', () => {
    /* 刚弹出来 400ms 内的这一下不算：「确认提交」带着 autofocus，
       在输入框里按住回车的人会连着触发它 —— 那正好是我们要防的「没看清就提交」 */
    if (Date.now() - openedAt < 400) return;
    const p = plan;
    closeConfirm();
    if (p) void runSubmit(p);
  });

  /* Escape 关闭（原生行为）后把 plan 清掉 */
  confirmDlg?.addEventListener('close', () => {
    plan = null;
  });

  /* 点背景也能关（原生 dialog 不管这个） */
  confirmDlg?.addEventListener('click', (e) => {
    if (e.target === confirmDlg) closeConfirm();
  });

  /**
   * 只做本地校验：不联网、不取人机验证 token，所以可以放心地先跑一遍再弹确认框。
   * 校验不过就 showError 并返回 null（此时**不该**弹确认框）。
   */
  function prepareSubmission(): SubmissionPlan | null {
    /*
     * ⚠️ 大面积整理档里**不能**读「要提交哪一项」那个下拉框：draft 是 hidden 字段，
     * 压根不在下拉的选项里 —— 之前这里直接把 fieldSel.value 当成了要投的字段，
     * 于是整篇整理会被当成「当前选中的那一项」（比如难度）投出去，草稿根本没提交。
     * 谁在台上，就以谁为准。
     */
    const inDraft = mode === 'draft';
    const field = inDraft ? 'draft' : fieldSel.value;
    const note = (document.getElementById('f-note') as HTMLTextAreaElement).value;
    const submitter = (document.getElementById('f-submitter') as HTMLInputElement).value;
    const contact = (document.getElementById('f-contact') as HTMLInputElement).value;
    const base = {
      field,
      batchItems: [] as Array<{ field: string; value: unknown }>,
      /* 整篇草稿不跟别的项拼批：它自己就是一整篇（队列留着，切回单项档还能投） */
      batched: !inDraft && batchQueue.length >= 1,
      reviseOf: '',
      note,
      submitter,
      contact,
      queuedIgnored: inDraft ? batchQueue.length : 0,
    };

    /* 整篇草稿要求登录（服务端也拦，见 FIELD_RULES.draft.requireLogin）——
       已经知道没登录就直接说清楚，别让人写完一整篇、点了确认才被退回来。
       meLoggedIn === null 表示登录接口没通，那种情况交给服务端判断。 */
    if (inDraft && meLoggedIn === false) {
      showError(
        '整篇草稿需要登录后才能提交（大面积改写要能追到人）—— 右上角登录即可，' +
          '没账号 10 秒能注册；不登录也照样能投其它字段。'
      );
      return null;
    }

    /* 封面：值是一张压好的图，不参与 collect / validateValue */
    if (field === 'cover') {      if (!coverBlob) {
        showError('先选一张图片，等它压好之后再提交。');
        return null;
      }
      return {
        ...base,
        batchItems: [{ field, value: '' }],
        coverInfo: coverStatus?.textContent?.trim() ?? '',
      };
    }

    /* 图片集：multipart、一张一条投稿，值也不在表单里 */
    if (field === 'gallery') {
      if (!galleryItems.length) {
        showError('先选图片，等它们压好之后再提交。');
        return null;
      }
      return {
        ...base,
        batchItems: [{ field, value: '' }],
        galleryCount: galleryItems.length,
      };
    }

    const value = collect(field);
    /*
     * 简介：本站已经有简介的图**不接受**社区简介（页面上根本不会渲染，投了等于白投）。
     * 本地拦一道并指路到能投的字段 —— 服务端拦不了（Worker 读不到仓库里的原稿），
     * 但审核台照样能看到这类稿子，站长可以驳回。
     */
    if (field === 'summary' && String(mapInfo?.summary ?? '').trim()) {
      showError('这张图已经有本站整理的简介，简介不支持覆盖 —— 想补充内容请改投「背景故事」或「补充说明 / 纠错」。');
      return null;
    }
    const checked = validateValue(field, value);
    if (!checked.ok) {
      showError(checked.error);
      return null;
    }

    /* 批量（2026-10-13）：队列里攒着的几项 + 当前这一项，一起交上去。
       一张图补资料常要同时改难度、标签、视频、正文 —— 一次一条地投十遍太折腾，
       而且审核台看到的是一堆散条目。服务端会为这一批打同一个 batch 号。 */
    const batchItems = [
      ...batchQueue.map((b) => ({ field: b.field, value: b.value })),
      { field, value: checked.value },
    ];

    /* 正在修订某一条已通过的社区投稿（点过「修订这条」）：带上它的 id，
       审核通过后是替换那一条的正文，而不是再加一条。 */
    const reviseOf = reviseTarget && reviseTarget.field === field ? reviseTarget.id : '';

    return { ...base, value: checked.value, batchItems, reviseOf };
  }

  /** 真正提交（原来那段逻辑）：人机验证 → 发请求 → 成功页 */
  async function runSubmit(p: SubmissionPlan): Promise<void> {
    const { field, note, submitter, contact } = p;
    const backLink =
      `站长审核通过后会随下一批一起写回仓库并自动重建，通常几分钟内就会出现在 ` +
      `<a href="/maps/${slug}/">《${mapInfo?.title}》的条目</a> 里。`;

    /* 人机验证：先等最多 3 秒（自动通过通常 <1 秒，别让手快的人白跑一趟），
       token 是一次性的，失败后 reset（见各分支的 catch）。
       放在确认之后取 —— 让人看确认框的时候 token 不会白白过期。 */
    const { token: tsToken, blocked: tsBlocked } = await takeTurnstileToken(tsBox);
    if (tsBlocked) return showError(turnstileHint());

    /* 封面走 multipart 上传接口 —— 值是一张压好的图，不是文本 */
    if (field === 'cover') {
      if (!coverBlob) return showError('先选一张图片，等它压好之后再提交。');
      submitBtn.disabled = true;
      submitBtn.textContent = '上传中…';
      try {
        const fd = new FormData();
        fd.append('map', slug);
        fd.append('cover', coverBlob, `cover.${coverExt}`);
        fd.append('note', note);
        fd.append('submitter', submitter);
        fd.append('contact', contact);
        if (tsToken) fd.append('turnstileToken', tsToken);
        const res = await fetch('/api/submit-cover', { method: 'POST', body: fd });
        const data = (await res.json()) as { ok?: boolean; id?: number; error?: string };
        if (!data.ok) throw new Error(data.error || '上传失败');
        showSuccess(Number(data.id), `审核通过后封面会替换成这张。${backLink}`, field);
      } catch (err) {
        resetTurnstile(tsBox);
        showError(err instanceof Error && err.message ? err.message : '上传失败，请稍后再试');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '提交';
      }
      return;
    }

    /* 图片集走 multipart，**一张一条投稿**：中途失败就停下，把已经成功的那些从列表里挪走，
       免得再点提交时重复投一遍（重复投不会出错，但会在队列里多出一条一样的）。 */
    if (field === 'gallery') {
      if (!galleryItems.length) return showError('先选图片，等它们压好之后再提交。');
      submitBtn.disabled = true;
      const ids: number[] = [];
      try {
        for (let i = 0; i < galleryItems.length; i++) {
          const item = galleryItems[i];
          submitBtn.textContent = `上传中…（${i + 1}/${galleryItems.length}）`;
          if (galleryStatus) galleryStatus.textContent = `正在上传第 ${i + 1}/${galleryItems.length} 张…`;
          const fd = new FormData();
          fd.append('map', slug);
          fd.append('image', item.blob, `gallery.${item.ext}`);
          fd.append('caption', item.caption);
          fd.append('note', note);
          fd.append('submitter', submitter);
          fd.append('contact', contact);
          if (tsToken) fd.append('turnstileToken', tsToken);
          const res = await fetch('/api/submit-gallery', { method: 'POST', body: fd });
          const data = (await res.json()) as { ok?: boolean; id?: number; error?: string };
          if (!data.ok) throw new Error(`第 ${i + 1} 张没成功：${data.error || '上传失败'}`);
          ids.push(Number(data.id));
        }
        showSuccess(
          ids,
          `审核通过后这些图会出现在《${mapInfo?.title}》条目底部的「图片集」里。${backLink}`,
          'gallery'
        );
      } catch (err) {
        for (let i = ids.length - 1; i >= 0; i--) {
          URL.revokeObjectURL(galleryItems[i].url);
          galleryItems.splice(i, 1);
        }
        renderGalleryList();
        updateGalleryStatus();
        showError(
          (ids.length ? `已成功的 ${ids.length} 张（编号 ${ids.join('、')}）已进审核队列；` : '') +
            (err instanceof Error && err.message ? err.message : '上传失败，请稍后再试')
        );
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '提交';
      }
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '提交中…';
    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          map: slug,
          /* 队列为空时就是一条普通投稿（老格式，审核台照旧）；
             有队列就发 items[]，服务端为这一批写同一个 batch 号 */
          ...(p.batched ? { items: p.batchItems } : { field, value: p.value }),
          note,
          submitter,
          contact,
          ...(tsToken ? { turnstileToken: tsToken } : {}),
          ...(p.reviseOf && !p.batched ? { reviseOf: p.reviseOf } : {}),
        }),
      });
      const data = (await res.json()) as { ok?: boolean; id?: number; ids?: number[]; error?: string };
      if (!data.ok) throw new Error(data.error || '提交失败');
      if (p.batched) {
        batchQueue = [];
        renderBatchQueue();
      }
      if (p.reviseOf) {
        /* 修订稿也进了队列，但面板上的正文要等审核通过、重建后才变 ——
           这里先退出修订状态，免得投稿人接着改同一条又投一遍。 */
        reviseTarget = null;
        renderReviseBar();
      }
      showSuccess(
        Number(data.id),
        p.reviseOf
          ? `这是一条<b>修订</b>稿：审核通过后会替换原来的那一条（署名不变）。${backLink}`
          : backLink,
        field
      );
    } catch (err) {
      /* token 一次性：失败后换一个新的，否则用户改完再点会被判「验证没通过」 */
      resetTurnstile(tsBox);
      showError(err instanceof Error && err.message ? err.message : '提交失败，请稍后再试');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '提交';
    }
  }

  /* 点「提交审核」= 先本地校验，过了就弹确认框；确认框里点「确认提交」才真的发 */
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errEl.hidden = true;
    const p = prepareSubmission();
    if (!p) return;
    openConfirm(p);
  });

  /* 审核状态查询 */
  const qOut = document.getElementById('q-out') as HTMLElement;
  document.getElementById('q-go')?.addEventListener('click', async () => {
    const id = (document.getElementById('q-id') as HTMLInputElement).value.trim();
    if (!id) {
      qOut.textContent = '请先填编号。';
      return;
    }
    qOut.textContent = '查询中…';
    try {
      const res = await fetch(`/api/submission?id=${encodeURIComponent(id)}`);
      const data = (await res.json()) as {
        ok?: boolean;
        status?: string;
        field?: string;
        reject_note?: string;
        error?: string;
      };
      if (!data.ok) throw new Error(data.error || '查不到');
      const label: Record<string, string> = {
        pending: '待审核',
        applied: '已通过并上线',
        rejected: '未通过',
        approved: '已通过，等待发布',
      };
      qOut.textContent = `编号 ${id}：${label[data.status ?? ''] ?? data.status}` +
        (data.reject_note ? `　理由：${data.reject_note}` : '');
    } catch (err) {
      qOut.textContent = err instanceof Error ? err.message : '查询失败';
    }
  });

  /* ============ 下面都是纯视觉增强，逻辑仍以 select / input 为准 ============
     共同点：**不改任何提交数据**，只是让界面好点用点。任何一段挂了都不影响提交。 */

  /*
   * 字段快捷按钮：把「要提交哪一项」那个下拉框变成一排按钮。
   * 选择结果仍然写回 #f-field 并派发 change —— 后续逻辑（显示对应块、预填现值）完全不用改。
   */
  {
    const chips = document.getElementById('field-chips');
    const sel = document.getElementById('f-field') as HTMLSelectElement | null;
    if (chips && sel) {
      const sync = () => {
        for (const b of chips.querySelectorAll<HTMLButtonElement>('button')) {
          b.classList.toggle('on', b.dataset.v === sel.value);
          b.setAttribute('aria-pressed', String(b.dataset.v === sel.value));
        }
      };
      for (const opt of [...sel.options]) {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.v = opt.value;
        b.textContent = opt.textContent ?? opt.value;
        b.title = rules[opt.value]?.hint ?? '';
        b.addEventListener('click', () => {
          sel.value = opt.value;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          sync();
        });
        chips.append(b);
      }
      sel.addEventListener('change', sync);
      /* 有按钮了就把原生下拉框视觉上藏起来（保留在 DOM 里：键盘可达、无 JS 时也能用） */
      sel.closest('.form-row')?.classList.add('has-chips');
      sync();
    }
  }

  /*
   * 拖拽上传：文件直接拖到虚线框里就行。
   * 靠 DataTransfer 把文件塞回原来的 file input 再派发 change ——
   * 压缩 / 预览 / 上传那套逻辑一行都不用动。
   */
  for (const zone of document.querySelectorAll<HTMLElement>('.drop-zone')) {
    const input = zone.querySelector<HTMLInputElement>('input[type="file"]');
    if (!input) continue;
    const stop = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
    };
    for (const ev of ['dragenter', 'dragover', 'dragleave', 'drop']) zone.addEventListener(ev, stop);
    zone.addEventListener('dragenter', () => zone.classList.add('is-over'));
    zone.addEventListener('dragover', () => zone.classList.add('is-over'));
    zone.addEventListener('dragleave', () => zone.classList.remove('is-over'));
    zone.addEventListener('drop', (e) => {
      zone.classList.remove('is-over');
      const files = (e as DragEvent).dataTransfer?.files;
      if (!files || !files.length) return;
      input.files = files;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });
    /* 选完文件后把文件名显示在框里（**不动标题那行说明**，只更新 .dz-files） */
    input.addEventListener('change', () => {
      const names = [...(input.files ?? [])].map((f) => f.name);
      const filesEl = zone.querySelector<HTMLElement>('.dz-files');
      if (filesEl) filesEl.textContent = names.join('、');
      zone.classList.toggle('has-file', names.length > 0);
    });
  }
</script>
