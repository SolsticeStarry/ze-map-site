---
interface Props {
  open?: boolean;
}

const { open = false } = Astro.props;
---

<div class="stage-accordion">
  <slot />
</div>

<style>
  .stage-accordion :global(details) {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 12px;
    overflow: hidden;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .stage-accordion :global(details[open]) {
    border-color: rgba(255,77,77,0.35);
    box-shadow: 0 0 0 1px rgba(255,77,77,0.08), 0 8px 30px rgba(0,0,0,0.35);
  }

  .stage-accordion :global(details > summary) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    position: relative;
    transition: background 0.2s;
  }

  .stage-accordion :global(details > summary::-webkit-details-marker) {
    display: none;
  }

  .stage-accordion :global(details > summary::before) {
    content: '';
    width: 0;
    height: 0;
    border-left: 6px solid var(--accent-2);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    transition: transform 0.25s;
    flex-shrink: 0;
  }

  .stage-accordion :global(details[open] > summary::before) {
    transform: rotate(90deg);
  }

  .stage-accordion :global(details > summary:hover) {
    background: rgba(255,255,255,0.02);
  }

  .stage-accordion :global(.stage-num) {
    color: var(--accent);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .stage-accordion :global(.stage-name) {
    flex: 1;
    font-weight: 700;
    color: #fff;
  }

  .stage-accordion :global(.stage-body) {
    padding: 4px 18px 18px;
    border-top: 1px solid var(--border);
  }

  .stage-accordion :global(.stage-body h3) {
    margin-top: 20px;
  }
</style>