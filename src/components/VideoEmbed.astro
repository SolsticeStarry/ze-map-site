---
interface Props {
  url: string;
  title?: string;
}

const { url, title = '' } = Astro.props;

let embedUrl = url;
let platform = 'unknown';

if (url.includes('bilibili.com')) {
  platform = 'bilibili';
  const bvMatch = url.match(/BV[\w]+/);
  const avMatch = url.match(/av(\d+)/i);
  if (bvMatch) {
    embedUrl = `https://player.bilibili.com/player.html?bvid=${bvMatch[0]}&high_quality=1&danmaku=0`;
  } else if (avMatch) {
    embedUrl = `https://player.bilibili.com/player.html?aid=${avMatch[1]}&high_quality=1&danmaku=0`;
  }
} else if (url.includes('youtube.com') || url.includes('youtu.be')) {
  platform = 'youtube';
  const idMatch = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
  if (idMatch) {
    embedUrl = `https://www.youtube.com/embed/${idMatch[1]}`;
  }
}
---

<figure class="video-embed" data-platform={platform}>
  <div class="video-frame">
    <iframe
      src={embedUrl}
      title={title || '视频'}
      loading="lazy"
      allowfullscreen
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    ></iframe>
  </div>
  {title && <figcaption>{title}</figcaption>}
  <a class="video-source" href={url} target="_blank" rel="noopener">
    在原站打开 ↗
  </a>
</figure>

<style>
  .video-embed {
    margin: 20px 0;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .video-embed:hover {
    border-color: var(--border-2);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    padding: 12px 16px 0;
    font-size: 14px;
    color: #dde2ee;
  }

  .video-source {
    display: inline-block;
    padding: 8px 16px 14px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.05em;
    transition: color 0.2s;
  }

  .video-source:hover {
    color: var(--accent-2);
  }
</style>