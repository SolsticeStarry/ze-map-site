---
/**
 * 页头右上角的账号入口（2026-10-11）。
 *
 * 交互按「正常网站」的样子来：右上角一个人像图标，点开是**登录**表单；
 * 没账号的走「没有账号？注册一个」在同一张面板里切到注册，不用跳页。
 * 登录后图标变成渐变头像（昵称首字），点开是迷你个人卡：等级 + 统计 + 进个人主页 / 去投稿 / 退出。
 *
 * 收件箱（2026-10-14）：账号按钮**左边**多一个小铃铛，只有登录后才出现。
 * 有未读就亮红点（数字），点开是收件箱面板：审核结果 / 写回上线 / 草稿被采纳 / 站长公告，
 * 逐条点开看细节，也能「全部已读」。它不挡任何东西 —— 没登录时连铃铛都不显示。
 *
 * 三条约束（和整个账号系统一致）：
 *   1. **不登录也能用整站**：这个按钮纯粹是入口，不挡任何东西；
 *   2. **页面照旧是静态的**：这里只是「静态 HTML + 打开面板时问一次 /api/me」，
 *      收件箱也是同一个路子（进页面问一次未读数，页面可见时每 2 分钟再看一眼）；
 *   3. 面板里的表单与 /account/ 页共用同一套接口与会话，逻辑不重复实现第二份。
 */
import { BELL_ICON, PERSON_ICON } from '../lib/account-client';
---

{/* 收件箱铃铛：登录后才有内容，所以默认 hidden，登录状态读出来再显示 */}
<div class="am-bell-wrap" id="am-bell-wrap" hidden>
  <button class="am-btn" id="am-bell" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="收件箱">
    <span class="am-avatar" set:html={BELL_ICON} />
    <span class="am-bell-dot" id="am-bell-dot" hidden></span>
  </button>

  <div class="am-panel am-inbox" id="am-inbox" role="dialog" aria-label="收件箱" hidden>
    <div class="am-inbox-head">
      <b>收件箱</b>
      <button class="am-link" type="button" id="am-inbox-all">全部已读</button>
    </div>
    <p class="am-inbox-hint" id="am-inbox-hint"></p>
    <div class="am-inbox-list" id="am-inbox-list"></div>
    <button class="acc-btn acc-btn-block" type="button" id="am-inbox-more" hidden>加载更多</button>
    {/* 面板只够扫一眼：完整版在 /inbox/（左文件夹 / 中列表 / 右正文，2026-10-15 加） */}
    <a class="am-inbox-open" href="/inbox/" target="_self">在邮箱里打开 →</a>
  </div>
</div>

<div class="am" id="am">
  <button class="am-btn" id="am-btn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="账号">
    <span class="am-avatar" id="am-avatar" set:html={PERSON_ICON} />
  </button>

  <div class="am-panel" id="am-panel" role="dialog" aria-label="账号" hidden>
    {/* ===== 未登录：先登录，没有账号再注册 ===== */}
    <div id="am-guest">
      <div class="am-head">
        <b id="am-title">登录</b>
        <span id="am-sub">登录后署名固定用账号昵称，投稿记进个人主页</span>
      </div>

      <form class="am-pane" id="am-login-form">
        <div class="form-row">
          <label for="am-log-name">昵称</label>
          <input id="am-log-name" maxlength="20" autocomplete="username" />
        </div>
        <div class="form-row">
          <label for="am-log-pass">口令</label>
          <input id="am-log-pass" type="password" maxlength="72" autocomplete="current-password" />
        </div>
        {/* 人机验证：没配 site key 时这一块保持 hidden（本地/未配置都不显示） */}
        <div class="am-ts" id="am-log-ts" hidden></div>
        <button class="acc-btn acc-btn-primary acc-btn-block" type="submit" id="am-log-go">登录</button>
        <p class="am-switch">没有账号？<button class="am-link" type="button" id="am-to-reg">注册一个</button></p>
      </form>

      <form class="am-pane" id="am-reg-form" hidden>
        <div class="form-row">
          <label for="am-reg-name">昵称（条目里的署名，2~20 字）</label>
          <input id="am-reg-name" maxlength="20" autocomplete="username" />
        </div>
        <div class="form-row">
          <label for="am-reg-pass">口令（至少 8 位）</label>
          <input id="am-reg-pass" type="password" maxlength="72" autocomplete="new-password" />
        </div>
        <div class="form-row">
          <label for="am-reg-pass2">再输一遍</label>
          <input id="am-reg-pass2" type="password" maxlength="72" autocomplete="new-password" />
        </div>
        <div class="form-row">
          <label for="am-reg-contact">联系方式（选填）</label>
          <input id="am-reg-contact" maxlength="80" placeholder="QQ / 邮箱，只站长看得到" />
        </div>
        <div class="am-ts" id="am-reg-ts" hidden></div>
        <button class="acc-btn acc-btn-primary acc-btn-block" type="submit" id="am-reg-go">注册并登录</button>
        <p class="am-switch">已经有账号？<button class="am-link" type="button" id="am-to-log">去登录</button></p>
      </form>

      <p class="form-error" id="am-error" hidden></p>
      <p class="form-ok" id="am-ok" hidden></p>

      {/*
        GitHub 登录（2026-10-14）：可选的一条路。没配密钥（github.enabled=false）时整块隐藏。
        target="_self"：站点默认新开标签（BaseLayout 的 <base target>），
        但授权流程必须同一个标签页走完，否则回调落在新标签、这里还是未登录。
      */}
      <div class="am-gh-login" id="am-gh-login" hidden>
        <a class="acc-btn acc-btn-block acc-btn-gh" id="am-gh-go" href="/api/auth/github/start" target="_self">
          <span class="acc-gh-mark" aria-hidden="true"></span>用 GitHub 登录 / 注册
        </a>
      </div>

      <div class="am-foot">
        <a href="/account/">我的投稿与等级 →</a>
        <span class="am-sep">·</span>
        <a href="/submit/">不登录也能投稿</a>
      </div>
    </div>

    {/* ===== 已登录：迷你个人卡 ===== */}
    <div id="am-me" hidden>
      <div class="am-me-top">
        <span class="am-avatar is-on" id="am-me-avatar">·</span>
        <div class="am-me-id">
          <b id="am-me-name">—</b>
          {/* 授权 UP 主称号（2026-10-13）：见 worker/auth.ts 的 agreedUpFor；点开是他在 B 站的主页 */}
          <a class="am-up-badge" id="am-me-up" hidden>授权 UP 主</a>
          {/* 仓库贡献者称号：挂了 GitHub 用户名时才有，点开是他的 GitHub 主页 */}
          <a class="am-gh-badge" id="am-me-gh" hidden>仓库贡献者</a>
          <span class="acc-level-name" id="am-me-level" data-lv="0">—</span>
        </div>
      </div>
      <p class="am-me-stats" id="am-me-stats"></p>
      <div class="am-links">
        <a class="acc-btn" href="/account/">个人主页</a>
        <a class="acc-btn" href="/submit/">去投稿</a>
        <button class="acc-btn" type="button" id="am-logout">退出登录</button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    ACCOUNT_EVENT,
    BELL_ICON,
    NOTIFY_EVENT,
    PERSON_ICON,
    fetchNotifications,
    markNotificationsRead,
    meOrThrow,
    notifyChanged,
    type AccountMe,
    type AccountNotification,
    type AccountUser,
  } from '../lib/account-client';
  import { mountTurnstile, resetTurnstile, takeTurnstileToken, turnstileHint, turnstileToken } from '../lib/turnstile';
  /* 昵称规则的**通用**部分：本地先拦一道给出即时反馈；政治类词表只在服务端（不入库） */
  import { checkNicknameContent, nicknameRejectMessage } from '../../shared/nickname-rules.mjs';

  const btn = document.getElementById('am-btn');
  const panel = document.getElementById('am-panel');
  const avatar = document.getElementById('am-avatar');
  const guest = document.getElementById('am-guest');
  const meBox = document.getElementById('am-me');
  if (!btn || !panel || !avatar || !guest || !meBox) throw new Error('账号面板缺节点');

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const errBox = $('am-error');
  const okBox = $('am-ok');
  const say = (msg: string, ok = false) => {
    if (errBox) {
      errBox.textContent = ok ? '' : msg;
      errBox.hidden = ok || !msg;
    }
    if (okBox) {
      okBox.textContent = ok ? msg : '';
      okBox.hidden = !ok || !msg;
    }
  };

  /** 等级 → 徽章配色档位（与 global.css 的 .acc-level-name[data-lv] 同一套） */
  const LV: Record<string, number> = {
    路人: 0,
    入门贡献者: 1,
    资料整理者: 2,
    资深编辑: 3,
    荣誉编辑: 4,
    百科元老: 5,
    资料奠基人: 6,
  };
  let state: AccountMe | null = null;
  let loaded = false;

  /* ---------- 收件箱（2026-10-14） ----------
   * 只做三件事：登录后拉未读数（红点）、点开拉一页列表、点条目/全部已读。
   * 全部 DOM 用 createElement + textContent 拼（**不用 innerHTML**）：通知正文里有用户投稿的
   * 地图名与审核理由，拼 HTML 就等于给自己开一个注入口子。 */
  const bellWrap = document.getElementById('am-bell-wrap');
  const bellBtn = document.getElementById('am-bell');
  const bellDot = document.getElementById('am-bell-dot');
  const inbox = document.getElementById('am-inbox');
  const inboxList = document.getElementById('am-inbox-list');
  const inboxHint = document.getElementById('am-inbox-hint');
  const inboxMore = document.getElementById('am-inbox-more') as HTMLButtonElement | null;
  const inboxAll = document.getElementById('am-inbox-all');
  const PAGE = 10;
  let notes: AccountNotification[] = [];
  let noteUnread = 0;
  let noteTotal = 0;
  let logged = false;
  let busy = false;

  /*
   * 账号状态本地缓存（2026-10-19 站长反馈「第一次进来账户要等 1 秒才显示」）。
   *
   * 页面是静态的，登录状态只能问 /api/me —— 首次访问要等网络 + Worker 冷启动，
   * 这一秒里页头显示的是「未登录」。把上一次读到的用户存一份在 localStorage，
   * 进页面**先按缓存画出来**（头像、昵称、等级立刻就有了），再在后台问一次真的：
   *   · 真的还登录着 → 用新数据覆盖；
   *   · 其实已退出 / 会话过期 → 画成未登录，并把缓存清掉。
   * 只存展示用的公开字段（昵称 / 等级 / 称号），不存口令、不存会话。
   */
  const ME_CACHE = 'ze:me:v1';
  function cachedUser(): AccountUser | null {
    try {
      const raw = localStorage.getItem(ME_CACHE);
      if (!raw) return null;
      const u = JSON.parse(raw) as AccountUser;
      return u && typeof u.name === 'string' && u.name ? u : null;
    } catch {
      return null;
    }
  }
  function saveUserCache(u: AccountUser | null): void {
    try {
      if (u) localStorage.setItem(ME_CACHE, JSON.stringify(u));
      else localStorage.removeItem(ME_CACHE);
    } catch {
      /* 隐私模式下 localStorage 会抛错：缓存失败不影响功能 */
    }
  }

  /** 建一个元素：className + 文本（文本一律走 textContent） */
  const mk = (tag: string, cls?: string, text?: string): HTMLElement => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  /** 「刚刚 / 12 分钟前 / 3 小时前 / 2 天前 / 2026-10-14」 */
  function relTime(ts: number): string {
    const diff = Date.now() - Number(ts);
    if (!Number.isFinite(diff) || diff < 60_000) return '刚刚';
    const min = Math.floor(diff / 60_000);
    if (min < 60) return `${min} 分钟前`;
    const hour = Math.floor(min / 60);
    if (hour < 24) return `${hour} 小时前`;
    const day = Math.floor(hour / 24);
    if (day < 7) return `${day} 天前`;
    return new Date(Number(ts)).toLocaleDateString('zh-CN');
  }

  const KIND_LABEL: Record<string, string> = {
    review: '审核',
    flush: '上线',
    adopt: '采纳',
    account: '账号',
    announce: '公告',
  };

  function paintDot() {
    if (bellDot) {
      bellDot.hidden = noteUnread <= 0;
      bellDot.textContent = noteUnread > 9 ? '9+' : String(noteUnread);
    }
    if (bellBtn) {
      bellBtn.title = noteUnread > 0 ? `收件箱（${noteUnread} 条未读）` : '收件箱';
    }
    /* 2026-10-19：导航里的「邮箱」项已撤（和铃铛重复），未读数只体现在铃铛红点上 */
  }

  /** 「共 N 条 · M 条未读」那一行：单独抽出来，便于**不重建列表**地更新 */
  function paintHint() {
    if (!inboxHint) return;
    inboxHint.textContent = noteTotal ? `共 ${noteTotal} 条 · ${noteUnread} 条未读` : '';
    inboxHint.hidden = !noteTotal;
  }

  /** 只问未读数（limit=1）：页头红点用，接口不通就静默 —— 收件箱坏了不该在页头挂个错误 */
  async function refreshUnread(): Promise<void> {
    if (!logged) return;
    try {
      const page = await fetchNotifications(0, 1);
      /* 面板开着的时候来了新通知才重拉列表（平时只改数字 —— 重建列表会把展开的那条收起来） */
      const grew = page.total > noteTotal;
      noteUnread = page.unread;
      noteTotal = page.total;
      paintDot();
      if (grew && inbox && !inbox.hidden) await loadNotes(true);
      else paintHint();
    } catch {
      paintDot();
    }
  }

  /** 一条通知：标题行（点开/收起 + 已读）与正文（含「去看看」链接） */
  function noteNode(n: AccountNotification): HTMLElement {
    const box = mk('div', `am-note${n.read ? '' : ' is-unread'}`);

    const head = mk('button', 'am-note-head') as HTMLButtonElement;
    head.type = 'button';
    const dot = mk('span', 'am-note-dot');
    dot.hidden = n.read;
    const title = mk('span', 'am-note-title', n.title);
    const meta = mk('span', 'am-note-meta', `${KIND_LABEL[n.kind] ?? '通知'} · ${relTime(n.createdAt)}`);
    head.append(dot, title, meta);

    const body = mk('div', 'am-note-body');
    body.hidden = true;
    if (n.body) body.append(mk('p', 'am-note-text', n.body));
    if (n.link) {
      const go = mk('a', 'am-note-go', '去看看 →') as HTMLAnchorElement;
      go.href = n.link;
      body.append(go);
    }

    head.addEventListener('click', async () => {
      const open = body.hidden;
      body.hidden = !open;
      box.classList.toggle('is-open', open);
      if (!open || n.read) return;
      /* 展开即已读：先本地改（界面立刻反应），再把结果同步回服务端的未读数。
         ⚠️ 这里**不能**调 renderNotes()：那会重建整个列表，把刚点开的这条又收起来。 */
      n.read = true;
      box.classList.remove('is-unread');
      dot.hidden = true;
      try {
        const r = await markNotificationsRead({ ids: [n.id] });
        noteUnread = r.unread;
      } catch {
        noteUnread = Math.max(0, noteUnread - 1);
      }
      paintDot();
      paintHint();
    });

    box.append(head, body);
    return box;
  }

  function renderNotes() {
    if (!inboxList) return;
    inboxList.replaceChildren();
    if (!notes.length) {
      inboxList.append(
        mk(
          'p',
          'am-inbox-empty',
          '还没有通知。投稿通过、写回上线、草稿被采纳，或者站长发公告时，都会出现在这里。'
        )
      );
    } else {
      for (const n of notes) inboxList.append(noteNode(n));
    }
    if (inboxMore) inboxMore.hidden = notes.length >= noteTotal;
    paintHint();
  }

  /** 拉一页：reset=true 从头拉（打开面板/已读全部后），否则接着往后拉 */
  async function loadNotes(reset: boolean): Promise<void> {
    if (busy) return;
    busy = true;
    if (inboxHint && reset) {
      inboxHint.hidden = false;
      inboxHint.textContent = '读取中…';
    }
    try {
      const offset = reset ? 0 : notes.length;
      const page = await fetchNotifications(offset, PAGE);
      notes = reset ? page.items : [...notes, ...page.items];
      noteUnread = page.unread;
      noteTotal = page.total;
      paintDot();
      renderNotes();
    } catch {
      if (reset) notes = [];
      if (inboxHint) {
        inboxHint.hidden = false;
        inboxHint.textContent = '收件箱没读到（接口没通），稍后再试';
      }
      renderNotes();
    } finally {
      busy = false;
    }
  }

  const openInbox = (open: boolean) => {
    if (!inbox) return;
    inbox.hidden = !open;
    bellBtn?.setAttribute('aria-expanded', String(open));
    bellBtn?.classList.toggle('is-open', open);
    if (open) void loadNotes(true);
  };

  function paint(data: AccountMe | null, reachable: boolean) {
    state = data;
    const user = data?.user ?? null;
    btn!.classList.toggle('is-on', Boolean(user));
    /* 登录了：按钮本身就是头像（昵称首字）；没登录：人像图标 */
    if (user) {
      avatar!.innerHTML = '';
      avatar!.textContent = [...user.name.trim()][0] ?? '·';
    } else {
      avatar!.innerHTML = PERSON_ICON;
    }
    /* 接口没通：鼠标悬停能看出是「没读到」而不是「没登录」 */
    btn!.title = !reachable ? '账号（登录状态没读到）' : user ? `${user.name} · ${user.level}` : '登录 / 注册';

    guest!.hidden = Boolean(user);
    meBox!.hidden = !user;
    /* 收件箱铃铛：只有登录后才显示；退出登录时把红点与列表一起清掉 */
    logged = Boolean(user);
    if (bellWrap) bellWrap.hidden = !user;
    if (!user) {
      noteUnread = 0;
      noteTotal = 0;
      notes = [];
      paintDot();
      openInbox(false);
    }
    /* GitHub 按钮：只在站长配好了密钥时出现（没配就给一句说明都嫌啰嗦，直接不显示） */
    const ghLogin = $('am-gh-login');
    if (ghLogin) ghLogin.hidden = !(data?.github?.enabled ?? false) || Boolean(user);
    if (!reachable) say('登录状态没读到（接口没通）—— 不影响投稿，稍后重试即可');
    if (!user) return;

    const initial = [...user.name.trim()][0] ?? '·';
    const meAvatar = $('am-me-avatar');
    if (meAvatar) meAvatar.textContent = initial;
    $('am-me-name')!.textContent = user.name;
    /* 授权 UP 主称号：和账号页同一份数据（/api/me 的 up 字段），页头也顺带标一下。
       点它直接去他的 B 站主页（mid 就在 up.mid 里）。 */
    const upBadge = $('am-me-up') as HTMLAnchorElement | null;
    if (upBadge) {
      if (user.up) {
        upBadge.hidden = false;
        upBadge.href = `https://space.bilibili.com/${encodeURIComponent(user.up.mid)}`;
        upBadge.title = `B 站「${user.up.name}」—— 本站已收录他 ${user.up.videos} 条视频（${user.up.maps} 张图）`;
      } else {
        upBadge.hidden = true;
        upBadge.removeAttribute('href');
      }
    }
    /* 仓库贡献者称号：同 /api/me 的 gh 字段，点开去他的 GitHub 主页 */
    const ghBadge = $('am-me-gh') as HTMLAnchorElement | null;
    if (ghBadge) {
      if (user.gh?.logins?.length) {
        ghBadge.hidden = false;
        ghBadge.href = user.gh.url;
        ghBadge.title = `GitHub「${user.gh.logins.join(' + ')}」—— 在本仓库提交过资料整理`;
      } else {
        ghBadge.hidden = true;
        ghBadge.removeAttribute('href');
      }
    }
    const lv = $('am-me-level')!;
    lv.textContent = user.level;
    lv.dataset.lv = String(LV[user.level] ?? 0);
    $('am-me-stats')!.textContent = user.next
      ? `已通过 ${user.approved} 条 · 再通过 ${user.next.need} 条升到「${user.next.level}」`
      : `已通过 ${user.approved} 条 · 已是最高等级`;
  }

  async function load() {
    /* 先用上回缓存把头像 / 昵称画出来（几乎 0 延迟），再问服务端核对 */
    const cached = cachedUser();
    if (cached) paint({ ok: true, user: cached, github: { enabled: false } } as AccountMe, true);
    try {
      const data = await meOrThrow();
      paint(data, true);
      saveUserCache(data.user ?? null);
    } catch {
      /* 接口没通：有缓存就继续用缓存显示（别把已登录的人画成未登录），没有才画成未登录 */
      if (!cached) paint(null, false);
    }
    loaded = true;
    /* 登录了才去问收件箱（未登录时这一步根本不发请求） */
    if (logged) void refreshUnread();
  }

  /* ---- 人机验证（Turnstile）：登录 / 注册各挂一块 ---- */
  const tsLog = document.getElementById('am-log-ts');
  const tsReg = document.getElementById('am-reg-ts');
  async function mountTurnstileWidgets() {
    for (const box of [tsLog, tsReg]) {
      if (!box || !box.hidden) continue;
      if (await mountTurnstile(box)) box.hidden = false;
    }
  }

  const openPanel = (open: boolean) => {
    panel!.hidden = !open;
    btn!.setAttribute('aria-expanded', String(open));
    btn!.classList.toggle('is-open', open);
    if (!open) return;
    /* 人机验证的 widget：**打开面板之后**才渲染 —— 面板隐藏时 widget 算不出宽度，
       会缩成一个窄条。挂过一次就记住了，重复打开不会重复渲染。 */
    void mountTurnstileWidgets();
    const pane = guest!.hidden ? null : ($('am-log-name') as HTMLInputElement | null);
    /* 打开时聚焦「昵称」，但别把已经填过的内容清掉 */
    if (pane && !pane.value) setTimeout(() => pane.focus(), 60);
  };

  /* 打开之前先问一次登录状态；之后一直用缓存，除非状态变了 */
  btn.addEventListener('click', async (e) => {
    e.stopPropagation();
    const willOpen = panel.hidden;
    if (willOpen && !loaded) await load();
    openPanel(willOpen);
  });

  /* 点面板外面 / 按 Esc 关掉（账号卡与收件箱都关） */
  document.addEventListener('click', (e) => {
    const t = e.target instanceof Node ? e.target : null;
    const inAccount = Boolean(t && (panel!.contains(t) || btn!.contains(t)));
    const inInbox = Boolean(t && ((inbox && inbox.contains(t)) || (bellBtn && bellBtn.contains(t))));
    if (!panel!.hidden && t && !inAccount) openPanel(false);
    if (inbox && !inbox.hidden && t && !inInbox) openInbox(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!panel!.hidden) openPanel(false);
    if (inbox && !inbox.hidden) openInbox(false);
  });

  /* ---------- 收件箱的交互 ---------- */
  bellBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const willOpen = Boolean(inbox?.hidden);
    if (willOpen) openPanel(false);
    openInbox(willOpen);
  });

  /* 全部已读：服务端一条语句标完，回来重拉第一页（未读数也一起刷新） */
  inboxAll?.addEventListener('click', async () => {
    if (busy) return;
    busy = true;
    try {
      const r = await markNotificationsRead({ all: true });
      noteUnread = r.unread;
      paintDot();
      busy = false;
      await loadNotes(true);
    } catch {
      busy = false;
      if (inboxHint) {
        inboxHint.hidden = false;
        inboxHint.textContent = '标记失败（接口没通），稍后再试';
      }
    }
  });

  inboxMore?.addEventListener('click', () => void loadNotes(false));

  /*
   * 红点得在**不刷新页面**的情况下出现：页面可见时每 2 分钟问一次未读数
   * （只发一次请求、只查计数），切回标签页时立刻补一次。
   * 未登录时 refreshUnread 直接返回，不发请求。
   */
  setInterval(() => {
    if (document.visibilityState === 'visible') void refreshUnread();
  }, 120_000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') void refreshUnread();
  });

  /* 登录 / 注册 两页切换（默认登录：没有账号再点「注册一个」） */
  const loginForm = $('am-login-form') as HTMLFormElement | null;
  const regForm = $('am-reg-form') as HTMLFormElement | null;
  const showPane = (which: 'log' | 'reg') => {
    say('');
    if (loginForm) loginForm.hidden = which !== 'log';
    if (regForm) regForm.hidden = which !== 'reg';
    /* 切过去再把那一页的 widget 挂上（同样是隐藏容器不能渲染的问题） */
    void mountTurnstileWidgets();
    $('am-title')!.textContent = which === 'log' ? '登录' : '注册';
    $('am-sub')!.textContent =
      which === 'log' ? '登录后署名固定用账号昵称，投稿记进个人主页' : '只要昵称 + 口令，不收邮箱';
    const first = (which === 'log' ? $('am-log-name') : $('am-reg-name')) as HTMLInputElement | null;
    first?.focus();
  };
  $('am-to-reg')?.addEventListener('click', () => showPane('reg'));
  $('am-to-log')?.addEventListener('click', () => showPane('log'));

  const post = async (path: string, body: unknown) => {
    const res = await fetch(path, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    let data: { ok?: boolean; error?: string; message?: string } = {};
    try {
      data = await res.json();
    } catch {
      /* 非 JSON（502 之类） */
    }
    if (!res.ok || !data.ok) throw new Error(data.error || `请求失败（HTTP ${res.status}）`);
    return data;
  };

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    say('');
    /* 先等验证（最多 3 秒）：手快的人点得比自动通过还早，不能因此报错 */
    const { token, blocked } = await takeTurnstileToken(tsLog);
    if (blocked) return say(turnstileHint());
    try {
      await post('/api/login', {
        name: ($('am-log-name') as HTMLInputElement).value.trim(),
        password: ($('am-log-pass') as HTMLInputElement).value,
        turnstileToken: token,
      });
      notifyChanged();
      await load();
      /* 面板留着，让人看到「已经登录成了谁」 */
      ($('am-log-pass') as HTMLInputElement).value = '';
    } catch (err) {
      /* token 一次性：失败后必须换新的，否则改完再点会被判「验证没通过」 */
      resetTurnstile(tsLog);
      say(err instanceof Error ? err.message : '登录失败');
    }
  });

  regForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    say('');
    const p1 = ($('am-reg-pass') as HTMLInputElement).value;
    const p2 = ($('am-reg-pass2') as HTMLInputElement).value;
    if (p1 !== p2) return say('两次输入的口令不一样');
    /* 昵称先本地查一遍（即时反馈）；服务端还会再查一遍并以它为准 */
    const nick = ($('am-reg-name') as HTMLInputElement).value.trim();
    const content = checkNicknameContent(nick, []);
    if (!content.ok) return say(nicknameRejectMessage(content.reason));
    const { token, blocked } = await takeTurnstileToken(tsReg);
    if (blocked) return say(turnstileHint());
    try {
      await post('/api/register', {
        name: ($('am-reg-name') as HTMLInputElement).value.trim(),
        password: p1,
        contact: ($('am-reg-contact') as HTMLInputElement).value,
        turnstileToken: token,
      });
      notifyChanged();
      await load();
      ($('am-reg-pass') as HTMLInputElement).value = '';
      ($('am-reg-pass2') as HTMLInputElement).value = '';
    } catch (err) {
      resetTurnstile(tsReg);
      say(err instanceof Error ? err.message : '注册失败');
    }
  });

  $('am-logout')?.addEventListener('click', async () => {
    await post('/api/logout', {}).catch(() => undefined);
    notifyChanged();
    await load();
    showPane('log');
  });

  /* 别的地方（账号页 / 投稿页）改了登录状态，这里跟着变：账号卡与收件箱铃铛一起重读 */
  document.addEventListener(ACCOUNT_EVENT, () => {
    loaded = false;
    void load();
  });

  /* 邮箱页读了信：红点立刻跟着掉（detail 里带未读数就不用再问一次服务端） */
  document.addEventListener(NOTIFY_EVENT, (e) => {
    const n = Number((e as CustomEvent<{ unread?: number }>).detail?.unread);
    if (Number.isFinite(n) && n >= 0) {
      noteUnread = n;
      paintDot();
    } else {
      void refreshUnread();
    }
  });

  /* 进页面就先问一次：登录过的人一进来就该看到自己的头像（未登录时这一步几乎无成本） */
  void load();
</script>
