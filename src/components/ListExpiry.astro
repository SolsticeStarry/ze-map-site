---
import { WINDOW_DAYS } from '../lib/map-dates';

/**
 * 让列表里的条目「到期自动消失」。
 *
 * 为什么构建期筛过一遍还要在浏览器里再筛一次：
 * 站点是纯静态的，没人推代码就不会重新构建。构建期筛出来的名单会一直挂在那儿，
 * 直到下一次部署才更新 —— 也就是说「30 天后自动消失」可能拖到 60 天、90 天。
 * 这里按**访问者本机时间**再算一遍，到点就隐藏，不需要任何人做任何事。
 *
 * 构建期的筛选仍然保留：既给没开 JS 的访问者兜底，也让静态 HTML 本身是合理的。
 */
interface Props {
  windowDays?: number;
}

const { windowDays = WINDOW_DAYS } = Astro.props;
---

<script define:vars={{ windowDays }}>
  (function () {
    function run() {
      var rows = document.querySelectorAll('.list-row[data-date]');
      if (!rows.length) return;

      var now = Date.now();
      var alive = 0;
      for (var i = 0; i < rows.length; i++) {
        var raw = rows[i].getAttribute('data-date');
        var days = Math.floor((now - new Date(raw + 'T00:00:00Z').getTime()) / 86400000);
        if (days >= 0 && days <= windowDays) {
          alive++;
        } else {
          rows[i].style.display = 'none'; // 到点了
        }
      }

      var countEl = document.getElementById('list-count');
      if (countEl) {
        var tpl = countEl.getAttribute('data-template') || '{n}';
        countEl.textContent = tpl.replace('{n}', String(alive));
      }

      var emptyEl = document.getElementById('list-expired');
      if (emptyEl) emptyEl.style.display = alive === 0 ? '' : 'none';
      var listEl = document.getElementById('list-rows');
      if (listEl) listEl.style.display = alive === 0 ? 'none' : '';

      // 主页上三个版块共用这套标记：某一组全过期了，就把整个版块（含标题）收起来，
      // 别留下一个只有「新增地图 —— 查看全部」的空壳。
      // 注意排行榜那组行没有 data-date，这里按「有日期的行」判断，不会误伤。
      var groups = document.querySelectorAll('.list-rows');
      for (var g = 0; g < groups.length; g++) {
        var dated = groups[g].querySelectorAll('.list-row[data-date]');
        if (!dated.length) continue;
        var left = 0;
        for (var k = 0; k < dated.length; k++) if (dated[k].style.display !== 'none') left++;
        if (left === 0) {
          var sec = groups[g].closest('section');
          if (sec) sec.style.display = 'none';
        }
      }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>
