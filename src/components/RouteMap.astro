---
interface Hotspot {
  x: number;
  y: number;
  label: string;
  desc?: string;
}

interface Props {
  src: string;
  alt?: string;
  hotspots?: Hotspot[];
}

const { src, alt = '路线图', hotspots = [] } = Astro.props;
---

<figure class="route-map">
  <div class="route-map-inner">
    <img src={src} alt={alt} loading="lazy" />
    {hotspots.map((h, i) => (
      <button
        class="hotspot"
        style={`left:${h.x}%; top:${h.y}%;`}
        data-label={h.label}
        data-desc={h.desc ?? ''}
        aria-label={h.label}
      >
        <span>{i + 1}</span>
      </button>
    ))}
  </div>
  {hotspots.length > 0 && (
    <div class="hotspot-legend">
      {hotspots.map((h, i) => (
        <div class="legend-item">
          <span class="legend-num">{i + 1}</span>
          <span class="legend-label">{h.label}</span>
          {h.desc && <span class="legend-desc">{h.desc}</span>}
        </div>
      ))}
    </div>
  )}
</figure>

<style>
  .route-map {
    margin: 20px 0;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .route-map-inner {
    position: relative;
    line-height: 0;
  }

  .route-map-inner img {
    width: 100%;
    display: block;
  }

  .hotspot {
    position: absolute;
    width: 32px;
    height: 32px;
    margin: -16px 0 0 -16px;
    border-radius: 50%;
    background: rgba(255,77,77,0.9);
    border: 2px solid #fff;
    color: #fff;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    box-shadow: 0 0 0 4px rgba(255,77,77,0.25), 0 4px 16px rgba(0,0,0,0.5);
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .hotspot:hover {
    transform: scale(1.15);
    box-shadow: 0 0 0 8px rgba(255,77,77,0.2), 0 6px 20px rgba(0,0,0,0.6);
  }

  .hotspot::after {
    content: attr(data-label);
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(6,7,11,0.95);
    border: 1px solid var(--border-2);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 10px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .hotspot:hover::after {
    opacity: 1;
  }

  .hotspot-legend {
    padding: 16px 18px;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 10px;
  }

  .legend-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14px;
  }

  .legend-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255,77,77,0.15);
    border: 1px solid rgba(255,77,77,0.5);
    color: #ff8080;
    font-size: 12px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .legend-label {
    color: #fff;
    font-weight: 600;
  }

  .legend-desc {
    color: var(--muted);
    font-size: 13px;
  }
</style>