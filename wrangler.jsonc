// Cloudflare Workers 部署配置（默认 = 站长生产）
//
// 关键点：
// - main 是 worker/index.ts；站点静态产物在 ./dist。
// - assets.binding = ASSETS，未命中静态资源时交回 Worker 的 404。
// - run_worker_first 只把 API / 地形 / 提交入口先交给脚本，其余页面仍走静态资源。
// - /submit 必须在 run_worker_first 里：旧的静态投稿页已删除，由 Worker 301 到 /submit/edit。
//
// ⚠️ 不要把个人测试 Worker / D1 / KV 写进这个文件。
// ⚠️ 部署前确认 secrets 已配置；缺 ADMIN_TOKEN / IP_SALT / GITHUB_TOKEN 时审核与写回会失败。
{
  "name": "ze-map-site",
  "compatibility_date": "2026-09-23",
  "main": "worker/index.ts",
  "vars": {
    "GITHUB_REPO": "hhjjdsj/ze-map-site",
    "GITHUB_BRANCH": "main"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/terr/*", "/submit", "/submit/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ze-map-community",
      "database_id": "314ae078-618f-463d-b0e5-798b35386dbf"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "UPLOADS",
      "id": "384e8441523d4da4bcc660f330f1bc2e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TERR",
      "bucket_name": "ze-map-terr"
    }
  ],
  "previews": {}
}
