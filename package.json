{
  "name": "ze-map-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/content/generate-map-entries.mjs && astro build && node scripts/content/build-search.mjs",
    "build:site": "astro build",
    "search:index": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "data:entity": "node scripts/entity-data/build-entity-data.mjs",
    "data:verify": "node scripts/entity-data/verify-entity-data.mjs --all",
    "data:image": "node scripts/entity-data/render-map-image.mjs",
    "data:covers": "node scripts/entity-data/render-covers.mjs",
    "maps:generate": "node scripts/content/generate-map-entries.mjs",
    "content:verify": "node scripts/content/verify-research.mjs",
    "content:rename-difficulty": "node scripts/content/rename-difficulty.mjs",
    "gfl:parse": "node scripts/content/parse-gfl-configs.mjs",
    "gfl:link": "node scripts/content/link-gfl-configs.mjs",
    "content:links": "node scripts/content/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
